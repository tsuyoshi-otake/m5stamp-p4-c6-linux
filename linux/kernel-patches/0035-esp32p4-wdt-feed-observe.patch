--- a/drivers/watchdog/esp32p4_wdt.c
+++ b/drivers/watchdog/esp32p4_wdt.c
@@ -25,6 +25,7 @@
 #include <linux/bits.h>
 #include <linux/delay.h>
 #include <linux/io.h>
+#include <linux/jiffies.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -60,6 +61,10 @@
 	void __iomem *base;
 };
 
+/* Stamp-P4 0024 observe-only: feed telemetry (do not change timeout/policy). */
+static unsigned long es_wdt_feed_count;
+static unsigned long es_wdt_last_feed_jiffies;
+
 static void esp32p4_wdt_unlock(struct esp32p4_wdt *wdt)
 {
 	writel(TIMG_WDT_WKEY_UNLOCK, wdt->base + TIMG_WDTWPROTECT);
@@ -120,6 +125,15 @@
 	writel(1, wdt->base + TIMG_WDTFEED);
 	esp32p4_wdt_relock(wdt);
 
+	/* MWDT worker feeds ~timeout/2.  Emit the first 16 feeds, then only
+	 * powers of two, so a long uptime does not fill the log (#12). */
+	es_wdt_feed_count++;
+	es_wdt_last_feed_jiffies = jiffies;
+	if (es_wdt_feed_count <= 16 ||
+	    !(es_wdt_feed_count & (es_wdt_feed_count - 1)))
+		pr_info("ES_WDT WDT_FEED_COUNT=%lu last_feed_jiffies=%lu\n",
+			es_wdt_feed_count, es_wdt_last_feed_jiffies);
+
 	return 0;
 }
 
