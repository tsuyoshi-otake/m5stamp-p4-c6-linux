diff --git a/drivers/mmc/host/dw_mmc.c b/drivers/mmc/host/dw_mmc.c
index 571bd9a..5e1d195 100644
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -104,6 +104,207 @@ struct idmac_desc {
 /* Each descriptor can transfer up to 4KB of data in chained mode */
 #define DW_MCI_DESC_DATA_LENGTH	0x1000
 
+static struct dw_mci_cmd53_trace_record *
+dw_mci_cmd53_trace_active(struct dw_mci *host)
+{
+	u32 seq = READ_ONCE(host->cmd53_trace_active);
+	struct dw_mci_cmd53_trace_record *record;
+
+	if (!seq)
+		return NULL;
+	record = &host->cmd53_trace[(seq - 1) % DW_MCI_CMD53_TRACE_DEPTH];
+	if (READ_ONCE(record->seq) != seq)
+		return NULL;
+	return record;
+}
+
+static u32 dw_mci_cmd53_trace_idsts(struct dw_mci *host)
+{
+	if (host->use_dma != TRANS_MODE_IDMAC)
+		return 0;
+	return host->dma_64bit_address ? mci_readl(host, IDSTS64) :
+		mci_readl(host, IDSTS);
+}
+
+static u64 dw_mci_cmd53_trace_dsc(struct dw_mci *host)
+{
+	if (host->use_dma != TRANS_MODE_IDMAC)
+		return 0;
+	if (host->dma_64bit_address)
+		return (u64)mci_readl(host, DSCADDRL) |
+			((u64)mci_readl(host, DSCADDRU) << 32);
+	return mci_readl(host, DSCADDR);
+}
+
+static u64 dw_mci_cmd53_trace_buf(struct dw_mci *host)
+{
+	if (host->use_dma != TRANS_MODE_IDMAC)
+		return 0;
+	if (host->dma_64bit_address)
+		return (u64)mci_readl(host, BUFADDRL) |
+			((u64)mci_readl(host, BUFADDRU) << 32);
+	return mci_readl(host, BUFADDR);
+}
+
+static u32 dw_mci_cmd53_trace_own(struct dw_mci *host)
+{
+	if (!host->sg_cpu || host->use_dma != TRANS_MODE_IDMAC)
+		return 0;
+	if (host->dma_64bit_address)
+		return le32_to_cpu(READ_ONCE(((struct idmac_desc_64addr *)
+					       host->sg_cpu)->des0));
+	return le32_to_cpu(READ_ONCE(((struct idmac_desc *)host->sg_cpu)->des0));
+}
+
+static void dw_mci_cmd53_trace_begin(struct dw_mci *host,
+				     struct mmc_command *cmd,
+				     struct mmc_data *data)
+{
+	struct dw_mci_cmd53_trace_record *record;
+	u32 seq;
+
+	host->cmd53_trace_active = 0;
+	if (cmd->opcode != SD_IO_RW_EXTENDED ||
+	    !(data->flags & MMC_DATA_READ))
+		return;
+
+	seq = ++host->cmd53_trace_head;
+	record = &host->cmd53_trace[(seq - 1) % DW_MCI_CMD53_TRACE_DEPTH];
+	memset(record, 0, sizeof(*record));
+	record->seq = seq;
+	record->arg = cmd->arg;
+	record->fn = (cmd->arg >> 28) & 0x7;
+	record->incr = !!(cmd->arg & BIT(26));
+	record->addr = (cmd->arg >> 9) & 0x1ffff;
+	record->requested = data->blocks * data->blksz;
+	record->cpu_va = (unsigned long)sg_virt(data->sg);
+	record->map_ret = -EINPROGRESS;
+	record->start_ret = -EINPROGRESS;
+	record->desc_first = U16_MAX;
+	record->desc_last = U16_MAX;
+	record->desc_64 = host->dma_64bit_address;
+	record->started_ns = ktime_get_ns();
+	WRITE_ONCE(host->cmd53_trace_active, seq);
+}
+
+static void dw_mci_cmd53_trace_submit_snapshot(struct dw_mci *host, int ret)
+{
+	struct dw_mci_cmd53_trace_record *record =
+		dw_mci_cmd53_trace_active(host);
+
+	if (!record)
+		return;
+	record->start_ret = ret;
+	record->engine = ret ? DW_MCI_CMD53_TRACE_PIO_FALLBACK :
+		DW_MCI_CMD53_TRACE_IDMAC;
+	record->submit_rint = mci_readl(host, RINTSTS);
+	record->submit_mint = mci_readl(host, MINTSTS);
+	record->submit_idsts = dw_mci_cmd53_trace_idsts(host);
+	record->submit_bmod = mci_readl(host, BMOD);
+	record->submit_dsc = dw_mci_cmd53_trace_dsc(host);
+	record->submit_buf = dw_mci_cmd53_trace_buf(host);
+}
+
+static void dw_mci_cmd53_trace_pio_bytes(struct dw_mci *host, u32 bytes)
+{
+	struct dw_mci_cmd53_trace_record *record =
+		dw_mci_cmd53_trace_active(host);
+
+	if (record)
+		record->pio_bytes += bytes;
+}
+
+static void dw_mci_cmd53_trace_finish(struct dw_mci *host,
+				      struct mmc_data *data)
+{
+	struct dw_mci_cmd53_trace_record *record =
+		dw_mci_cmd53_trace_active(host);
+
+	if (!record)
+		return;
+	record->completed_ns = ktime_get_ns();
+	record->complete_rint = mci_readl(host, RINTSTS);
+	record->complete_mint = mci_readl(host, MINTSTS);
+	record->complete_idsts = dw_mci_cmd53_trace_idsts(host);
+	record->complete_bmod = mci_readl(host, BMOD);
+	record->complete_dsc = dw_mci_cmd53_trace_dsc(host);
+	record->complete_buf = dw_mci_cmd53_trace_buf(host);
+	record->own_finish = dw_mci_cmd53_trace_own(host);
+	record->data_status = host->data_status;
+	record->bytes_xfered = data->bytes_xfered;
+	record->data_error = data->error;
+	/* Publish a complete record before its sequence marker. */
+	smp_wmb();
+	WRITE_ONCE(record->valid_seq, record->seq);
+	WRITE_ONCE(host->cmd53_trace_active, 0);
+}
+
+static const char *dw_mci_cmd53_trace_engine_name(u8 engine)
+{
+	switch (engine) {
+	case DW_MCI_CMD53_TRACE_IDMAC:
+		return "idmac";
+	case DW_MCI_CMD53_TRACE_PIO_FALLBACK:
+		return "pio-fallback";
+	default:
+		return "unavailable";
+	}
+}
+
+static ssize_t cmd53_rx_trace_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct dw_mci *host = dev_get_drvdata(dev);
+	u32 newest = READ_ONCE(host->cmd53_trace_head);
+	u32 count = min_t(u32, newest, DW_MCI_CMD53_TRACE_DEPTH);
+	ssize_t length = 0;
+	u32 seq;
+
+	for (seq = newest - count + 1; seq <= newest; seq++) {
+		const struct dw_mci_cmd53_trace_record *record =
+			&host->cmd53_trace[(seq - 1) % DW_MCI_CMD53_TRACE_DEPTH];
+
+		if (READ_ONCE(record->valid_seq) != seq)
+			continue;
+		length += sysfs_emit_at(buf, length,
+			"CMD53HOST seq=%u arg=%08x fn=%u incr=%u addr=%05x bytes=%u va=0x%lx dma=0x%llx dma_len=%u map=%d start=%d engine=%s elapsed_ns=%llu\n",
+			record->seq, record->arg, record->fn, record->incr,
+			record->addr, record->requested, record->cpu_va,
+			(unsigned long long)record->dma_addr, record->dma_len,
+			record->map_ret, record->start_ret,
+			dw_mci_cmd53_trace_engine_name(record->engine),
+			(unsigned long long)(record->completed_ns - record->started_ns));
+		length += sysfs_emit_at(buf, length,
+			" desc64=%u ring=0x%llx slots=%u-%u count=%u buf=0x%llx len=%u own=%08x/%08x/%08x/%08x/%08x own_timeout=%u\n",
+			record->desc_64, (unsigned long long)record->desc_dma,
+			record->desc_first, record->desc_last, record->desc_count,
+			(unsigned long long)record->desc_buf, record->desc_len,
+			record->own_before, record->own_after_poll,
+			record->own_submit, record->own_dma_irq,
+			record->own_finish,
+			record->own_timeout);
+		length += sysfs_emit_at(buf, length,
+			" submit[rint=%08x mint=%08x idsts=%08x bmod=%08x dsc=0x%llx buf=0x%llx] irq[rint=%08x mint=%08x idsts=%08x dto=%u dma=%u dataerr=%u] done[rint=%08x mint=%08x idsts=%08x bmod=%08x dsc=0x%llx buf=0x%llx status=%08x bytes=%u err=%d pio=%u]\n",
+			record->submit_rint, record->submit_mint,
+			record->submit_idsts, record->submit_bmod,
+			(unsigned long long)record->submit_dsc,
+			(unsigned long long)record->submit_buf,
+			record->irq_rint_or, record->irq_mint_or,
+			record->irq_idsts_or, record->dto_seen,
+			record->dma_complete, record->data_error_seen,
+			record->complete_rint, record->complete_mint,
+			record->complete_idsts, record->complete_bmod,
+			(unsigned long long)record->complete_dsc,
+			(unsigned long long)record->complete_buf,
+			record->data_status, record->bytes_xfered,
+			record->data_error, record->pio_bytes);
+		if (length >= PAGE_SIZE)
+			break;
+	}
+	return length;
+}
+static DEVICE_ATTR_RO(cmd53_rx_trace);
