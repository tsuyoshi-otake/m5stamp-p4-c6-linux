From: EasyStick maintainers <noreply@example.invalid>
Subject: [PATCH] mmc: dw_mmc: attest divider and effective SDIO clock

The MMC core request and the module parameter are not proof of the physical
controller clock.  Record mmc->ios.clock, the computed divider,
mmc->actual_clock, and the CLKDIV/CLKENA register values after the controller
applies them.

---
 drivers/mmc/host/dw_mmc.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/mmc/host/dw_mmc.c b/drivers/mmc/host/dw_mmc.c
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -18,6 +18,7 @@
 #include <linux/iopoll.h>
 #include <linux/ioport.h>
 #include <linux/ktime.h>
+#include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
@@ -1568,6 +1569,11 @@
 		slot->__clk_old = clock;
 		slot->mmc->actual_clock = div ? ((host->bus_hz / div) >> 1) :
 					  host->bus_hz;
+		pr_info("ES_SDIO_CLOCK_HW slot=%u bus_hz=%u ios_clock_hz=%u "
+			"actual_clock_hz=%u divider=%u clkdiv=0x%08x clkena=0x%08x\n",
+			slot->id, host->bus_hz, clock,
+			slot->mmc->actual_clock, div,
+			mci_readl(host, CLKDIV), mci_readl(host, CLKENA));
 	}
 
 	host->current_speed = clock;
