Subject: [PATCH] easystick: esp32p4 trap/mret/irq ring trace for the CPU1 interrupt latch (#5)

The CPU1 CLIC acceptance latch leaves pending+enabled interrupts
untaken while the hart keeps running.  The "stale mcause" hypothesis is
that some return path executes mret with a nonzero mcause.MPIL
(bits 23:16), latching mintstatus.mil to 0xFF so every interrupt lands
below threshold forever.

Observe-only recorder, applied only for C68 diagnostic builds
(EASYSTICK_C68_MRET_TRACE=1, requires the C68 SMP series).  Three
per-CPU rings plus a bounded post-interrupt buffer, all written inline
in entry.S:

- ES_TRAP (64x8, every trap): {seq, raw mcause, mepc, mscratch, mstatus,
  mintstatus, mtval, 0}.  The mintstatus slot is always 0xffffffff:
  csrr 0xfb1 at trap entry raised an illegal-instruction exception on
  CPU0's first interrupt at boot, and on a deaf CPU1 it stops the core
  for good.  The interrupted level is in the raw mcause's MPIL field.
- ES_MRET (64x8, every mret): the exact mcause the shim restores, mepc,
  PT_TP vs tp, and the written mstatus.  es_mret_bad_mpil counts writes
  whose MPIL field is nonzero -- the shim already forces MPIL=0, so a
  zero count on a deaf boot is the hardware falsification of the
  stale-mcause hypothesis; es_mret_bad_cause keeps the first offender.
- ES_IRQ (64x8, interrupts only): freezes when the hart goes deaf.
  Each record snapshots the all-traps seq and the mret seq, so the dump
  says exactly how many traps/mrets ran after the last accepted
  interrupt -- the post-deaf ecall traffic that flushes the all-traps
  ring no longer hides the transition.
- ES_POST (8x8): the first 8 mrets after the newest interrupt (the index
  is reset on each ES_IRQ record), i.e. the returns that bracket the
  latch.

drivers/clocksource/timer-esp32p4-systimer.c calls
esp32p4_mret_trace_tick() from each CPU's own SYSTIMER interrupt.
CPU1's stamp freezes when it goes deaf; CPU0's tick sees it stale at 2 s
and dumps once as ES5_WATCH/ES5_TRAP/ES5_IRQ/ES5_MRET/ES5_POST lines.
Detection ordering is deliberate: 0068 ES_DEAF at 1 s + 200 ms, then
this dump at 2 s, then 0078's ES5_RESET restart at 3 s.  The dump prints
CPU1's rings in full, CPU0's newest 8 records, and never reads a CLIC
CSR on CPU1.

esp32p4_mret_trace.c holds the rings and the dump.  All state is plain
RAM written with a fence after each record, so records survive an MWDT
reset into the pstore preserved area if backing is enabled later; the
console dump does not depend on it.

---
--- a/arch/riscv/kernel/entry.S	2026-10-19 15:51:54.152471400 +0900
+++ b/arch/riscv/kernel/entry.S	2026-10-19 16:27:57.526385100 +0900
@@ -197,6 +197,81 @@
 	csrr s5, CSR_SCRATCH
 #ifdef CONFIG_SOC_ESP32P4
 	/*
+	 * #5 ES_TRAP/ES_IRQ records (0077): stash the raw trap state before
+	 * the shim rewrites anything.  s4 is the raw mcause -- for interrupt
+	 * frames this is the only place its MPIL field survives (PT_CAUSE
+	 * strips it for exceptions and the exit shim always writes 0).
+	 * t0-t6 are free (already saved).
+	 *
+	 * mintstatus (0xfb1) is never read here; its slot holds 0xffffffff.
+	 * csrr 0xfb1 raised an illegal-instruction exception on CPU0's
+	 * first interrupt at boot (E1 build, before the CLIC is in use),
+	 * and on a deaf CPU1 it stops the core for good.  The interrupted
+	 * level is in the raw mcause's MPIL field instead.
+	 *
+	 * Interrupt frames also go to the ES_IRQ ring, which freezes when
+	 * the hart stops accepting interrupts; each record snapshots the
+	 * all-traps and mret sequence counters so the dump can count the
+	 * traps and mrets that ran after the last accepted interrupt, and
+	 * resets es_post_idx so the ES_POST buffer collects the first 8
+	 * mrets of this new interrupt window.
+	 *
+	 * ES_TRAP {seq, mcause, mepc, mscratch, mstatus, mintstatus, mtval, 0}
+	 * ES_IRQ  {seq, mcause, mepc, mstatus, mintstatus, trap_seq, mret_seq, 0}
+	 */
+	lw   t0, TASK_TI_CPU(tp)
+	slli t1, t0, 2			/* t1 = cpu*4 (kept live below) */
+	la   t2, es_trap_idx
+	add  t2, t2, t1
+	lw   t3, 0(t2)			/* t3 = all-traps seq */
+	addi t4, t3, 1
+	sw   t4, 0(t2)
+	andi t4, t3, 63
+	slli t4, t4, 5
+	slli t5, t0, 11			/* cpu * (64*32) */
+	la   t6, es_trap_buf
+	add  t6, t6, t5
+	add  t6, t6, t4
+	sw   t3, 0(t6)
+	sw   s4, 4(t6)
+	sw   s2, 8(t6)
+	sw   s5, 12(t6)
+	sw   s1, 16(t6)
+	sw   s3, 24(t6)
+	sw   zero, 28(t6)
+	li   t4, -1			/* mintstatus slot: never read, see above */
+	sw   t4, 20(t6)
+	bgez s4, .Les_trap_logged
+	/* ES_IRQ record + ES_POST reset */
+	la   t2, es_irq_idx
+	add  t2, t2, t1
+	lw   t4, 0(t2)			/* t4 = irq seq */
+	addi t5, t4, 1
+	sw   t5, 0(t2)
+	andi t5, t4, 63
+	slli t5, t5, 5
+	slli t6, t0, 11
+	la   t2, es_irq_buf
+	add  t2, t2, t6
+	add  t2, t2, t5
+	sw   t4, 0(t2)
+	sw   s4, 4(t2)
+	sw   s2, 8(t2)
+	sw   s1, 12(t2)
+	li   t5, -1			/* mintstatus slot: never read */
+	sw   t5, 16(t2)
+	sw   t3, 20(t2)			/* all-traps seq at this interrupt */
+	la   t5, es_mret_idx
+	add  t5, t5, t1
+	lw   t5, 0(t5)
+	sw   t5, 24(t2)			/* mret seq at this interrupt */
+	sw   zero, 28(t2)
+	la   t5, es_post_idx
+	add  t5, t5, t1
+	sw   zero, 0(t5)		/* arm ES_POST for this window */
+.Les_trap_logged:
+	fence rw, rw
+	/*
 	 * CLIC v0.9 bidirectional shim (entry side):
 	 * mstatus.MPP[12:11] and mstatus.MPIE[7] are hardwired to 0 on this
 	 * core; the real saved IE lives in mcause[27] (MPIE).
@@ -488,6 +563,78 @@
 	or    a3, a3, a4
 .Lesp32p4_keep_mpie:
 	csrw  CSR_CAUSE, a3
+	/*
+	 * #5 ES_MRET record (0077): log the mcause this mret will restore
+	 * {seq, mcause_w, mepc_w, pttp, tp, status_w, 0, 0} and flag the
+	 * write if its MPIL field is nonzero.  The shim's mask already
+	 * forces MPIL=0, so es_mret_bad_mpil staying at 0 on a deaf boot
+	 * is the hardware falsification of the "stale-mcause mret"
+	 * hypothesis; a nonzero count would identify the offending frame.
+	 * a2/a3 still hold mepc/mcause, a0 holds pt_regs->status; PT_TP
+	 * is reloaded because a4 is clobbered on the user-return branch.
+	 * t0-t6 are free.
+	 */
+	lw   t0, TASK_TI_CPU(tp)
+	slli t1, t0, 2
+	la   t2, es_mret_idx
+	add  t2, t2, t1
+	lw   t3, 0(t2)
+	addi t4, t3, 1
+	sw   t4, 0(t2)
+	andi t4, t3, 63
+	slli t4, t4, 5
+	slli t5, t0, 11
+	la   t6, es_mret_buf
+	add  t6, t6, t5
+	add  t6, t6, t4
+	REG_L t5, PT_TP(sp)
+	sw   t3, 0(t6)
+	sw   a3, 4(t6)
+	sw   a2, 8(t6)
+	sw   t5, 12(t6)
+	sw   tp, 16(t6)
+	sw   a0, 20(t6)
+	sw   zero, 24(t6)
+	sw   zero, 28(t6)
+	li   t4, 0x00FF0000
+	and  t5, a3, t4
+	beqz t5, .Les_mret_mpil_ok
+	la   t4, es_mret_bad_mpil
+	lw   t5, 0(t4)
+	addi t5, t5, 1
+	sw   t5, 0(t4)
+	la   t4, es_mret_bad_cause
+	sw   a3, 0(t4)
+.Les_mret_mpil_ok:
+	/*
+	 * ES_POST: mirror this record while es_post_idx < 8.  The index is
+	 * reset by the next interrupt's ES_IRQ write, so on a deaf hart the
+	 * buffer holds the first mrets after the last accepted interrupt --
+	 * the frame(s) that bracket the latch.
+	 */
+	la   t4, es_post_idx
+	add  t4, t4, t1
+	lw   t5, 0(t4)
+	li   t6, 8
+	bgeu t5, t6, .Les_mret_done
+	slli t6, t5, 5
+	addi t5, t5, 1
+	sw   t5, 0(t4)
+	slli t5, t0, 8			/* cpu * (8*32) */
+	la   t4, es_post_buf
+	add  t4, t4, t5
+	add  t4, t4, t6
+	REG_L t5, PT_TP(sp)
+	sw   t3, 0(t4)			/* same seq as the ES_MRET record */
+	sw   a3, 4(t4)
+	sw   a2, 8(t4)
+	sw   t5, 12(t4)
+	sw   tp, 16(t4)
+	sw   a0, 20(t4)
+	sw   zero, 24(t4)
+	sw   zero, 28(t4)
+.Les_mret_done:
+	fence rw, rw
 #endif
 
 	REG_L x1,  PT_RA(sp)
--- a/drivers/clocksource/timer-esp32p4-systimer.c	2026-10-19 15:51:54.764879200 +0900
+++ b/drivers/clocksource/timer-esp32p4-systimer.c	2026-10-19 15:56:31.919005900 +0900
@@ -26,6 +26,9 @@
 
 #include <asm/delay.h>		/* riscv_timebase */
 
+/* #5 diagnostic (0077): trap/mret ring watch, esp32p4_mret_trace.c */
+void esp32p4_mret_trace_tick(unsigned int cpu);
+
 #define ESP32P4_TIMER_CPUS	2
 
 /* SYSTIMER register byte offsets (struct size = 0x100). */
@@ -215,6 +218,7 @@
 	esp32p4_timer_stop(cpu);
 	ce = this_cpu_ptr(&esp32p4_clock_event);
 	ce->event_handler(ce);
+	esp32p4_mret_trace_tick(cpu);
 	return IRQ_HANDLED;
 }
 
--- a/arch/riscv/kernel/Makefile	2026-10-19 15:51:54.575627000 +0900
+++ b/arch/riscv/kernel/Makefile	2026-10-19 15:56:41.101799400 +0900
@@ -128,3 +128,5 @@
 
 obj-$(CONFIG_GENERIC_CPU_VULNERABILITIES) += bugs.o
 obj-$(CONFIG_RISCV_USER_CFI) += usercfi.o
+
+obj-$(CONFIG_SOC_ESP32P4) += esp32p4_mret_trace.o
diff --git a/arch/riscv/kernel/esp32p4_mret_trace.c b/arch/riscv/kernel/esp32p4_mret_trace.c
new file mode 100644
--- /dev/null
+++ b/arch/riscv/kernel/esp32p4_mret_trace.c
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * #5 diagnostic (C68 diagnostic builds): per-CPU trap/mret/irq rings for
+ * the CPU1 CLIC interrupt-acceptance latch.  entry.S writes:
+ *
+ *   ES_TRAP (every trap)  {seq, mcause, mepc, mscratch, mstatus,
+ *                          mintstatus, mtval, 0}
+ *   ES_MRET (every mret)  {seq, mcause_w, mepc_w, pttp, tp, status_w, 0, 0}
+ *   ES_IRQ  (interrupts)  {seq, mcause, mepc, mstatus, mintstatus,
+ *                          trap_seq, mret_seq, 0}
+ *   ES_POST (<=8/window)  same layout as ES_MRET
+ *
+ * The mintstatus slots always hold 0xffffffff: csrr 0xfb1 at trap entry
+ * was an illegal instruction on CPU0's first interrupt at boot, and on
+ * a deaf CPU1 it stops the core.  The raw mcause carries the MPIL.
+ *
+ * ES_IRQ freezes when a hart goes deaf -- comparing its newest trap_seq /
+ * mret_seq against the live es_trap_idx/es_mret_idx counts exactly how
+ * many traps and mrets CPU1 ran after its last accepted interrupt.
+ * ES_POST holds the first 8 mrets of the current interrupt window, i.e.
+ * on a deaf CPU1 the returns that bracket the latch.
+ *
+ * esp32p4_mret_trace_tick() is called from each CPU's own SYSTIMER
+ * interrupt handler.  CPU1's stamp stops when it stops taking
+ * interrupts; CPU0's tick then prints the rings once as ES5_WATCH
+ * lines.  Detection order on this kernel is 0068 ES_DEAF (1 s +
+ * 200 ms), then this watch (2 s), then 0078's ES5_RESET (3 s).
+ *
+ * es_mret_bad_mpil counts the mret writes whose MPIL field was nonzero
+ * (the exit shim forces MPIL=0, so any nonzero count IS the stale-mcause
+ * bug); es_mret_bad_cause keeps the first such word.
+ */
+
+#include <linux/cpumask.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include <linux/smp.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+#include <asm/cacheflush.h>	/* esp32p4_cache_sync_lock (patch 0067) */
+
+#define ES_REC_WORDS	8
+#define ES_RING		64
+#define ES_POST_RING	8
+
+u32 es_trap_buf[NR_CPUS][ES_RING][ES_REC_WORDS];
+u32 es_mret_buf[NR_CPUS][ES_RING][ES_REC_WORDS];
+u32 es_irq_buf[NR_CPUS][ES_RING][ES_REC_WORDS];
+u32 es_post_buf[NR_CPUS][ES_POST_RING][ES_REC_WORDS];
+u32 es_trap_idx[NR_CPUS];
+u32 es_mret_idx[NR_CPUS];
+u32 es_irq_idx[NR_CPUS];
+u32 es_post_idx[NR_CPUS];
+u32 es_mret_bad_mpil;
+u32 es_mret_bad_cause;
+
+/*
+ * Defined by patch 0067 (drivers/cache/esp32p4_cache.c) and declared in
+ * asm/cacheflush.h; the weak fallback lets this patch also be applied
+ * without 0067 -- the dump then just prints the zeroed lock word.
+ */
+raw_spinlock_t esp32p4_cache_sync_lock __weak;
+
+/* per-CPU jiffies stamp, written by that CPU's own timer interrupt */
+static unsigned long es_tick_jif[NR_CPUS];
+static int es_watch_done;
+
+#define ES_WATCH_STALENESS	(2 * HZ)
+
+static void es_dump_ring(const char *tag,
+			 const u32 (*buf)[ES_REC_WORDS],
+			 const u32 *idx, unsigned int cpu)
+{
+	unsigned int i, n = READ_ONCE(idx[cpu]);
+	unsigned int count = n;
+
+	if (count > ES_RING)
+		count = ES_RING;
+	/* CPU1 rings print in full; CPU0 is capped at the newest 8 so the
+	 * emerg dump stays bounded. */
+	if (cpu == 0 && count > 8)
+		count = 8;
+
+	for (i = 0; i < count; i++) {
+		const u32 *r = buf[(n - 1 - i) & (ES_RING - 1)];
+
+		pr_emerg("%s cpu%u [%3u] %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			 tag, cpu, i, r[0], r[1], r[2], r[3], r[4], r[5],
+			 r[6], r[7]);
+	}
+}
+
+static void esp32p4_mret_trace_dump(unsigned int cpu)
+{
+	unsigned int c;
+
+	pr_emerg("ES5_WATCH cpu%u silent: cpu0 stamp jif=%lu cpu1 stamp jif=%lu bad_mpil=%u bad_cause=%08x cachelock=%08x\n",
+		 cpu, es_tick_jif[0], es_tick_jif[1],
+		 READ_ONCE(es_mret_bad_mpil), READ_ONCE(es_mret_bad_cause),
+		 *(volatile u32 *)&esp32p4_cache_sync_lock);
+	pr_emerg("ES5_WATCH seq cpu0 trap=%u mret=%u irq=%u post=%u cpu1 trap=%u mret=%u irq=%u post=%u\n",
+		 READ_ONCE(es_trap_idx[0]), READ_ONCE(es_mret_idx[0]),
+		 READ_ONCE(es_irq_idx[0]), READ_ONCE(es_post_idx[0]),
+		 READ_ONCE(es_trap_idx[1]), READ_ONCE(es_mret_idx[1]),
+		 READ_ONCE(es_irq_idx[1]), READ_ONCE(es_post_idx[1]));
+
+	for (c = 0; c < NR_CPUS; c++)
+		es_dump_ring("ES5_MRET", es_mret_buf[c], es_mret_idx, c);
+	for (c = 0; c < NR_CPUS; c++)
+		es_dump_ring("ES5_TRAP", es_trap_buf[c], es_trap_idx, c);
+	for (c = 0; c < NR_CPUS; c++)
+		es_dump_ring("ES5_IRQ", es_irq_buf[c], es_irq_idx, c);
+	for (c = 0; c < NR_CPUS; c++) {
+		unsigned int i, n = READ_ONCE(es_post_idx[c]);
+
+		if (n > ES_POST_RING)
+			n = ES_POST_RING;
+		for (i = 0; i < n; i++) {
+			const u32 *r = es_post_buf[c][i];
+
+			pr_emerg("ES5_POST cpu%u [%3u] %08x %08x %08x %08x %08x %08x %08x %08x\n",
+				 c, i, r[0], r[1], r[2], r[3], r[4],
+				 r[5], r[6], r[7]);
+		}
+	}
+}
+
+void esp32p4_mret_trace_tick(unsigned int cpu);
+void esp32p4_mret_trace_tick(unsigned int cpu)
+{
+	unsigned long last, now = jiffies;
+
+	if (cpu >= NR_CPUS)
+		return;
+	WRITE_ONCE(es_tick_jif[cpu], now);
+	if (cpu != 0 || num_online_cpus() < 2 || !cpu_online(1) ||
+	    es_watch_done)
+		return;
+
+	last = READ_ONCE(es_tick_jif[1]);
+	if (!last || time_before(now, last + ES_WATCH_STALENESS))
+		return;
+
+	es_watch_done = 1;
+	esp32p4_mret_trace_dump(cpu);
+}
