+/*
+ * Diagnostic-only descriptor chunk size, in bytes, for CMD53 SDIO reads.
+ * 0 (the default) leaves every transfer at DW_MCI_DESC_DATA_LENGTH, byte
+ * for byte identical to upstream chunking. A nonzero value is validated
+ * once at probe (dw_mci_probe()); an in-range value then makes CMD53 RX
+ * transfers chain at that many bytes per descriptor instead, so a single
+ * boot-time SDIO receive can be observed spanning several IDMAC
+ * descriptors without changing anything else. TX and every non-CMD53-RX
+ * transfer are untouched regardless of this value; see the coupling to
+ * dw_mci_cmd53_trace_active() in dw_mci_prepare_desc32/64() below.
+ *
+ * 0444 is deliberate, not cosmetic: kernel/params.c installs a sysfs
+ * store handler only when a write bit is set in perm, so this stays
+ * settable on the kernel command line but can never become
+ * runtime-writable, while still publishing the value the kernel actually
+ * parsed at /sys/module/dw_mmc/parameters/easystick_cmd53_rx_desc_bytes.
+ */
+static unsigned int easystick_cmd53_rx_desc_bytes;
+module_param_named(easystick_cmd53_rx_desc_bytes,
+		   easystick_cmd53_rx_desc_bytes, uint, 0444);
+MODULE_PARM_DESC(easystick_cmd53_rx_desc_bytes,
+		 "Diagnostic-only IDMAC descriptor chunk size in bytes for CMD53 SDIO reads (0 = disabled, default chunking)");
+
+/*
+ * Read the OWN/FD/LD/CH state of the first n descriptors as a bitmask,
+ * bit i set means the bit named by @bit is set in descriptor i. Plain
+ * loads only: no dw_mci_idmac_own32()/own64(), no ring_to_cpu()/
+ * ring_to_device(). Callers are responsible for calling this only where
+ * the ring is already known to be CPU-owned; the helper itself performs
+ * no synchronisation and issues no DMA/cache-maintenance operation.
+ */
+static u8 dw_mci_desc_bit_mask32(struct idmac_desc *first, unsigned int n,
+				 u32 bit)
+{
+	__le32 lebit = cpu_to_le32(bit);
+	u8 mask = 0;
+	unsigned int i;
+
+	for (i = 0; i < n && i < 8; i++)
+		if (READ_ONCE(first[i].des0) & lebit)
+			mask |= BIT(i);
+	return mask;
+}
+
+static u8 dw_mci_desc_bit_mask64(struct idmac_desc_64addr *first,
+				 unsigned int n, u32 bit)
+{
+	u8 mask = 0;
+	unsigned int i;
+
+	for (i = 0; i < n && i < 8; i++)
+		if (READ_ONCE(first[i].des0) & bit)
+			mask |= BIT(i);
+	return mask;
+}
