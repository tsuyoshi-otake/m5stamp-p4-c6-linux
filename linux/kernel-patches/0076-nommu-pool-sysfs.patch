Subject: [PATCH] stamp-p4: report the NOMMU user pool in sysfs

The 10 MB reserved pool (0010 + 0070) decides whether exec works, but
its state was invisible: an exec failing with ENOMEM only showed in
dmesg as "nommu: Allocation of length ... failed".  #40 asks for the
pool to be observable so saves and tests can watch for exhaustion.

/sys/kernel/board/nommu_pool prints one "key value" pair per line:

  total         pool bytes across all regions
  used          allocated pool bytes
  largest_free  biggest single free block; an exec needs a contiguous
                range this large
  alloc_fail    cumulative count of gen_pool_alloc failures
  fallback      cumulative count of allocations that fell through to
                the buddy allocator
  regions       number of reserved-memory regions in the pool
  regionN       phys-address and size of each region

The counters are atomics incremented only on the failure path.  The
largest_free walk runs at read time under the chunk list's RCU read
lock; the allocation path never walks the bitmap.

The region arrays lose their __initdata markers so the sysfs file can
report them for the life of the kernel.  The pool also creates the
shared /sys/kernel/board kobject at device_initcall; the bootflash
driver's late_initcall now attaches its file there instead of making a
duplicate "board" sysfs directory.

---
diff --git a/mm/nommu_userspace_pool.c b/mm/nommu_userspace_pool.c
--- a/mm/nommu_userspace_pool.c
+++ b/mm/nommu_userspace_pool.c
@@ -18,14 +18,20 @@
 
 #define pr_fmt(fmt) "nommu_userspace_pool: " fmt
 
+#include <linux/atomic.h>
+#include <linux/bitmap.h>
 #include <linux/genalloc.h>
 #include <linux/init.h>
 #include <linux/io.h>
+#include <linux/kobject.h>
 #include <linux/mm.h>
 #include <linux/nommu_userspace_pool.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/printk.h>
+#include <linux/rculist.h>
+#include <linux/rcupdate.h>
 #include <linux/sizes.h>
+#include <linux/sysfs.h>
 
 static struct gen_pool *user_pool;
 
@@ -33,22 +39,33 @@
  * Captured at early-boot RESERVEDMEM_OF_DECLARE time and consumed by
  * the core_initcall that actually builds the gen_pool — gen_pool_create
  * needs the slab allocator, which is not yet available when reserved
- * memory regions are first parsed.
+ * memory regions are first parsed.  Not __initdata: the nommu_pool sysfs
+ * file reports the regions for the life of the kernel.
  */
 #define NOMMU_POOL_MAX_REGIONS 4
 
-static phys_addr_t pool_phys[NOMMU_POOL_MAX_REGIONS] __initdata;
-static size_t pool_size[NOMMU_POOL_MAX_REGIONS] __initdata;
-static int pool_count __initdata;
+static phys_addr_t pool_phys[NOMMU_POOL_MAX_REGIONS];
+static size_t pool_size[NOMMU_POOL_MAX_REGIONS];
+static int pool_count;
+
+/* Cheap counters; touched only on a failed pool allocation. */
+static atomic_long_t pool_alloc_fail;
+static atomic_long_t pool_fallback;
 
 void *nommu_userspace_pool_alloc(size_t size)
 {
 	unsigned long va;
 
-	if (!user_pool || !size)
+	if (!user_pool || !size) {
+		atomic_long_inc(&pool_fallback);
 		return NULL;
+	}
 
 	va = gen_pool_alloc(user_pool, size);
+	if (!va) {
+		atomic_long_inc(&pool_alloc_fail);
+		atomic_long_inc(&pool_fallback);
+	}
 	return (void *)va; /* 0 → NULL on failure, which is what we want */
 }
 
@@ -124,3 +141,84 @@
 
 RESERVEDMEM_OF_DECLARE(nommu_userspace_pool, "linux,nommu-userspace-pool",
 		       &nommu_userspace_pool_rmem_ops);
+
+/*
+ * Shared /sys/kernel/board kobject.  This device_initcall runs before
+ * the bootflash driver's late_initcall, which then hangs its file on the
+ * same kobject instead of creating a duplicate sysfs directory.
+ */
+struct kobject *board_kobj;
+
+/*
+ * /sys/kernel/board/nommu_pool — one "key value" pair per line:
+ * total, used and largest_free in bytes, the cumulative alloc_fail
+ * (pool present but could not satisfy the allocation) and fallback
+ * (times mmap fell back to the buddy allocator) counters, and one
+ * "regionN phys size" line per declared reserved-memory region.
+ * largest_free walks the chunk bitmaps at read time under the pool's
+ * RCU read lock; nothing walks on the allocation path.
+ */
+static ssize_t nommu_pool_show(struct kobject *kobj,
+			       struct kobj_attribute *attr, char *buf)
+{
+	struct gen_pool_chunk *chunk;
+	unsigned long total = 0, avail = 0, best = 0;
+	unsigned long order = PAGE_SHIFT;
+	ssize_t len;
+	int i;
+
+	if (user_pool) {
+		order = user_pool->min_alloc_order;
+		rcu_read_lock();
+		list_for_each_entry_rcu(chunk, &user_pool->chunks,
+					next_chunk) {
+			unsigned long nbits, s, e;
+
+			total += chunk->end_addr - chunk->start_addr + 1;
+			avail += atomic_long_read(&chunk->avail);
+			nbits = (chunk->end_addr - chunk->start_addr + 1)
+				>> order;
+			s = 0;
+			while (s < nbits) {
+				s = find_next_zero_bit(chunk->bits, nbits, s);
+				if (s >= nbits)
+					break;
+				e = find_next_bit(chunk->bits, nbits, s);
+				if (e - s > best)
+					best = e - s;
+				s = e;
+			}
+		}
+		rcu_read_unlock();
+	}
+	len = sysfs_emit(buf,
+			 "total %lu\nused %lu\nlargest_free %lu\n"
+			 "alloc_fail %ld\nfallback %ld\nregions %d\n",
+			 total, total - avail, best << order,
+			 atomic_long_read(&pool_alloc_fail),
+			 atomic_long_read(&pool_fallback), pool_count);
+	for (i = 0; i < pool_count; i++)
+		len += sysfs_emit_at(buf, len, "region%d %pa %zu\n",
+				     i, &pool_phys[i], pool_size[i]);
+	return len;
+}
+static struct kobj_attribute nommu_pool_attr = __ATTR_RO(nommu_pool);
+
+static int __init nommu_pool_sysfs_init(void)
+{
+	struct kobject *kobj;
+	int r;
+
+	kobj = kobject_create_and_add("board", kernel_kobj);
+	if (!kobj)
+		return -ENOMEM;
+	board_kobj = kobj;
+	r = sysfs_create_file(kobj, &nommu_pool_attr.attr);
+	if (r) {
+		board_kobj = NULL;
+		kobject_put(kobj);
+		return r;
+	}
+	/* #55 compat, remove after v0.5.x: keep the old sysfs path working. */
+	sysfs_create_link(kernel_kobj, kobj, "easystick");
+	/* #55 compat end */
+	return 0;
+}
+device_initcall(nommu_pool_sysfs_init);
diff --git a/include/linux/nommu_userspace_pool.h b/include/linux/nommu_userspace_pool.h
--- a/include/linux/nommu_userspace_pool.h
+++ b/include/linux/nommu_userspace_pool.h
@@ -10,9 +10,18 @@
 
 #include <linux/types.h>
 
+struct kobject;
+
 #ifdef CONFIG_NOMMU_USERSPACE_POOL
 
 /*
+ * The shared /sys/kernel/board kobject, created by the pool's
+ * device_initcall.  Other stamp-p4 sysfs users hang their files on it;
+ * NULL before that initcall or when the pool is not built in.
+ */
+extern struct kobject *board_kobj;
+
+/*
  * Try to allocate a contiguous range of @size bytes (page-aligned by the
  * caller) from the configured reserved pool. Returns a kernel-virtual
  * pointer on success, NULL if the pool is unavailable or out of space.
@@ -27,6 +36,8 @@
 
 #else /* !CONFIG_NOMMU_USERSPACE_POOL */
 
+#define board_kobj ((struct kobject *)0)
+
 static inline void *nommu_userspace_pool_alloc(size_t size)
 {
 	return NULL;
diff --git a/drivers/misc/esp32p4-bootflash.c b/drivers/misc/esp32p4-bootflash.c
--- a/drivers/misc/esp32p4-bootflash.c
+++ b/drivers/misc/esp32p4-bootflash.c
@@ -38,6 +38,7 @@
 #include <linux/kobject.h>
 #include <linux/ktime.h>
 #include <linux/mutex.h>
+#include <linux/nommu_userspace_pool.h>
 #include <linux/of.h>
 #include <linux/slab.h>
 #include <linux/stop_machine.h>
@@ -413,12 +414,17 @@
 	sector_buf = kmalloc(FLASH_SECTOR, GFP_KERNEL);
 	if (!sector_buf)
 		return -ENOMEM;
-	kobj = kobject_create_and_add("board", kernel_kobj);
+	/* The NOMMU pool's device_initcall already made /sys/kernel/board;
+	 * attach to it (or make it when the pool is not built in). */
+	kobj = board_kobj;
+	if (!kobj)
+		kobj = kobject_create_and_add("board", kernel_kobj);
 	if (!kobj)
 		return -ENOMEM;
 	r = sysfs_create_file(kobj, &boot_commit_attr.attr);
 	if (r) {
-		kobject_put(kobj);
+		if (!board_kobj)
+			kobject_put(kobj);
 		return r;
 	}
 	pr_info("bootflash: flash id %06x, /boot commits without a reboot\n",
