diff --git a/drivers/irqchip/irq-esp32p4-clic.c b/drivers/irqchip/irq-esp32p4-clic.c
--- a/drivers/irqchip/irq-esp32p4-clic.c
+++ b/drivers/irqchip/irq-esp32p4-clic.c
@@ -24,6 +24,7 @@
 #include <linux/io.h>
 #include <linux/of_address.h>
 #include <linux/of_irq.h>
+#include <linux/smp.h>
 
 #define CLIC_NUM_IRQS     240
 #define CLIC_INTIP_OFF      0
@@ -39,6 +40,10 @@
 static void __iomem *clic_intmtx_base[2];
 
 static u8 clic_intmtx_source[CLIC_NUM_IRQS];
+static bool clic_timer_map_logged;
+static unsigned int clic_timer_mask_count;
+static unsigned int clic_timer_unmask_count;
+static bool clic_timer_local_logged;
 static u8 clic_trig_edge[CLIC_NUM_IRQS];
 
 struct irq_domain *esp32p4_clic_domain;
@@ -47,11 +51,51 @@
 static void clic_irq_mask(struct irq_data *d)
 {
 	writeb(0, clic_base + d->hwirq * 4 + CLIC_INTIE_OFF);
+	if (raw_smp_processor_id() == 1 &&
+	    clic_intmtx_source[d->hwirq] == 54) {
+		unsigned int count = ++clic_timer_mask_count;
+
+		if (count <= 9 || (count && !(count & (count - 1))))
+			pr_info("OBS timer-mask #%u cpu=1 hwirq=%lu source=54 "
+				"IP=%u IE=%u ATTR=0x%02x CTL=0x%02x\n",
+				count, d->hwirq,
+				readb(clic_base + d->hwirq * 4 + CLIC_INTIP_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTIE_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTATTR_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTCTL_OFF));
+	}
 }
 
 static void clic_irq_unmask(struct irq_data *d)
 {
 	writeb(1, clic_base + d->hwirq * 4 + CLIC_INTIE_OFF);
+	if (raw_smp_processor_id() == 1 &&
+	    clic_intmtx_source[d->hwirq] == 54) {
+		unsigned int count = ++clic_timer_unmask_count;
+		if (!READ_ONCE(clic_timer_local_logged)) {
+			pr_info("OBS timer-clic-local cpu=1 hwirq=%lu "
+				"CLIC_LOCAL_SLOT=%lu CLIC_LOCAL_OFF=0x5c "
+				"IP=%u IE=%u ATTR=0x%02x CTL=0x%02x "
+				"INTMTX1_OFF=0xd8 INTMTX1=0x%08x\n",
+				d->hwirq, d->hwirq,
+				readb(clic_base + d->hwirq * 4 + CLIC_INTIP_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTIE_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTATTR_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTCTL_OFF),
+				clic_intmtx_base[1] ?
+				readl(clic_intmtx_base[1] + 54 * 4) : 0xffffffff);
+			WRITE_ONCE(clic_timer_local_logged, true);
+		}
+
+		if (count <= 9 || (count && !(count & (count - 1))))
+			pr_info("OBS timer-unmask #%u cpu=1 hwirq=%lu source=54 "
+				"IP=%u IE=%u ATTR=0x%02x CTL=0x%02x\n",
+				count, d->hwirq,
+				readb(clic_base + d->hwirq * 4 + CLIC_INTIP_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTIE_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTATTR_OFF),
+				readb(clic_base + d->hwirq * 4 + CLIC_INTCTL_OFF));
+	}
 }
 
 static void clic_irq_ack(struct irq_data *d)
@@ -127,6 +157,20 @@
 
 	writeb(attr,             clic_base + hwirq * 4 + CLIC_INTATTR_OFF);
 	writeb(CLIC_INTCTL_MAX,  clic_base + hwirq * 4 + CLIC_INTCTL_OFF);
+	if (clic_intmtx_source[hwirq] == 54 &&
+	    !READ_ONCE(clic_timer_map_logged)) {
+		u32 map0 = clic_intmtx_base[0] ?
+			readl(clic_intmtx_base[0] + 54 * 4) : 0xffffffff;
+		u32 map1 = clic_intmtx_base[1] ?
+			readl(clic_intmtx_base[1] + 54 * 4) : 0xffffffff;
+
+		pr_info("OBS timer-map virq=%u hwirq=%lu source=54 "
+			"INTMTX0=0x%08x INTMTX1=0x%08x ATTR=0x%02x CTL=0x%02x\n",
+			irq, hwirq, map0, map1,
+			readb(clic_base + hwirq * 4 + CLIC_INTATTR_OFF),
+			readb(clic_base + hwirq * 4 + CLIC_INTCTL_OFF));
+		WRITE_ONCE(clic_timer_map_logged, true);
+	}
 
 	irq_domain_set_info(d, irq, hwirq, &esp32p4_clic_chip, NULL,
 			    handler, NULL, NULL);

diff --git a/drivers/irqchip/irq-esp32p4-ipi.c b/drivers/irqchip/irq-esp32p4-ipi.c
--- a/drivers/irqchip/irq-esp32p4-ipi.c
+++ b/drivers/irqchip/irq-esp32p4-ipi.c
@@ -31,6 +31,8 @@
 static void __iomem *esp32p4_ipi_base;
 static unsigned int esp32p4_ipi_parent_irq[ESP32P4_IPI_NR_CPUS];
 static DEFINE_PER_CPU(int, esp32p4_ipi_dev);
+static unsigned int esp32p4_ipi_send_count[ESP32P4_IPI_NR_CPUS];
+static unsigned int esp32p4_ipi_irq_count;
 
 static unsigned int esp32p4_ipi_reg(unsigned int cpu)
 {
@@ -44,13 +46,29 @@
 		return;
 	}
 
-	writel(ESP32P4_IPI_FROM_CPU_BIT,
-	       esp32p4_ipi_base + esp32p4_ipi_reg(cpu));
+	{
+		unsigned int count = ++esp32p4_ipi_send_count[cpu];
+
+		writel(ESP32P4_IPI_FROM_CPU_BIT,
+		       esp32p4_ipi_base + esp32p4_ipi_reg(cpu));
+		if (count <= 9 || (count && !(count & (count - 1))))
+			pr_info("OBS ipi-send #%u from_cpu=%u target=%u "
+				"REG=0x%08x\n",
+				count, raw_smp_processor_id(), cpu,
+				readl(esp32p4_ipi_base + esp32p4_ipi_reg(cpu)));
+	}
 }
 
 static irqreturn_t esp32p4_ipi_interrupt(int irq, void *dev_id)
 {
 	unsigned int cpu = smp_processor_id();
+	unsigned int count = ++esp32p4_ipi_irq_count;
+	u32 pre = cpu < ESP32P4_IPI_NR_CPUS ?
+		readl(esp32p4_ipi_base + esp32p4_ipi_reg(cpu)) : 0xffffffff;
+
+	if (count <= 9 || (count && !(count & (count - 1))))
+		pr_info("OBS ipi-irq #%u irq=%d actual_cpu=%u REG_PRE=0x%08x\n",
+			count, irq, cpu, pre);
 
 	if (cpu < ESP32P4_IPI_NR_CPUS)
 		writel(0, esp32p4_ipi_base + esp32p4_ipi_reg(cpu));
@@ -58,6 +76,12 @@
 		pr_warn_ratelimited("interrupt on unsupported CPU%u\n", cpu);
 
 	ipi_mux_process();
+	if (count <= 9 || (count && !(count & (count - 1))))
+		pr_info("OBS ipi-post #%u actual_cpu=%u REG_POST=0x%08x\n",
+			count, cpu,
+			cpu < ESP32P4_IPI_NR_CPUS ?
+			readl(esp32p4_ipi_base + esp32p4_ipi_reg(cpu)) :
+			0xffffffff);
 	return IRQ_HANDLED;
 }
 

