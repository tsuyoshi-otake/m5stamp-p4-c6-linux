 		timeout_ns, tmout >> 8);
 }
 
+
+/* Stamp-P4 B: error-only CMD53 / DW-MMC provenance (observe-only). */
+#define ES_MMC_CMD53_PRINT_CAP 8
+
+static void es_mmc_cmd53_mark_start(struct dw_mci *host, struct mmc_command *cmd)
+{
+	if (!cmd || cmd->opcode != 53)
+		return;
+	host->es_cmd53_active = 1;
+	host->es_cmd53_seq++;
+	host->es_cmd53_t0_ns = ktime_get_ns();
+	host->es_cmd53_tmout = mci_readl(host, TMOUT);
+	host->es_cmd53_cmd_status = 0;
+	host->es_cmd53_data_status = 0;
+	host->es_cmd53_irq_pending = 0;
+	host->es_cmd53_idsts = 0;
+	host->es_cmd53_status = 0;
+	host->es_cmd53_rintsts = 0;
+	host->es_cmd53_mintsts = 0;
+}
+
+static void es_mmc_cmd53_snap_irq(struct dw_mci *host, u32 pending)
+{
+	if (!host->es_cmd53_active)
+		return;
+	host->es_cmd53_irq_pending |= pending;
+	host->es_cmd53_mintsts = pending;
+	host->es_cmd53_rintsts = mci_readl(host, RINTSTS);
+	host->es_cmd53_status = mci_readl(host, STATUS);
+	if (host->dma_64bit_address)
+		host->es_cmd53_idsts = mci_readl(host, IDSTS64);
+	else
+		host->es_cmd53_idsts = mci_readl(host, IDSTS);
+}
+
+static void es_mmc_cmd53_emit_if_err(struct dw_mci *host, struct mmc_request *mrq)
+{
+	struct mmc_command *cmd;
+	struct mmc_data *data;
+	int cmd_err = 0, data_err = 0;
+	u64 elapsed_us;
+	u32 bytes = 0, blocks = 0, blksz = 0, resp0 = 0;
+
+	if (!host->es_cmd53_active || !mrq || !mrq->cmd)
+		return;
+	cmd = mrq->cmd;
+	if (cmd->opcode != 53)
+		goto out;
+	data = mrq->data;
+	cmd_err = cmd->error;
+	if (data) {
+		data_err = data->error;
+		bytes = data->bytes_xfered;
+		blocks = data->blocks;
+		blksz = data->blksz;
+	}
+	if (!cmd_err && !data_err)
+		goto out;
+	if (host->es_cmd53_prints >= ES_MMC_CMD53_PRINT_CAP)
+		goto out;
+	host->es_cmd53_prints++;
+	elapsed_us = div_u64(ktime_get_ns() - host->es_cmd53_t0_ns, 1000ULL);
+	resp0 = cmd->resp[0];
+	printk(KERN_EMERG
+	       "ES_MMC CMD53_ERR seq=%u cmd_arg=0x%08x cmd_err=%d data_err=%d resp0=0x%08x bytes_xfered=%u blocks=%u blksz=%u cmd_status=0x%08x data_status=0x%08x state=%u dir_status=%u rintsts=0x%08x mintsts=0x%08x status=0x%08x idsts=0x%08x tmout=0x%08x irq_pending=0x%08x elapsed_us=%llu using_dma=%d\n",
+	       host->es_cmd53_seq, cmd->arg, cmd_err, data_err, resp0, bytes,
+	       blocks, blksz, host->es_cmd53_cmd_status,
+	       host->es_cmd53_data_status, (unsigned int)host->state,
+	       host->dir_status, host->es_cmd53_rintsts, host->es_cmd53_mintsts,
+	       host->es_cmd53_status, host->es_cmd53_idsts, host->es_cmd53_tmout,
+	       host->es_cmd53_irq_pending, (unsigned long long)elapsed_us,
+	       host->using_dma);
+out:
+	host->es_cmd53_active = 0;
+}
+
 static void dw_mci_start_request(struct dw_mci *host, struct mmc_command *cmd)
 {
 	struct mmc_request *mrq;
