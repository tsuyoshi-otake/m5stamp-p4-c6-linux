Subject: [PATCH] mmc: dw_mmc: es_dma_threshold override for #35 (default off)

The P4 SDMMC FIFO does not pop on CPU reads: with fiford_mode 5,
STATUS.FCNT stays the same across every mci_fifo_readl(), so any PIO
read longer than one 32-bit word returns the first word repeated.
Normal esp-hosted traffic does take that path for transfers below
host->dma_threshold (16 bytes).

es_dma_threshold >= 0 replaces host->dma_threshold so short, aligned
transfers can go through IDMAC instead.  -1 (the default) keeps the
upstream value.  Set it at runtime through
/sys/module/dw_mmc/parameters/es_dma_threshold.

---
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -1236,6 +1236,15 @@
 	.cleanup = dw_mci_dma_cleanup,
 };

+/* EasyStick #35: the P4 FIFO does not pop on CPU reads, so every PIO
+ * read longer than one word is corrupt.  es_dma_threshold >= 0 replaces
+ * host->dma_threshold (16) so short transfers can take IDMAC instead;
+ * -1 (the default) keeps upstream behavior.
+ */
+static int dw_mmc_es_dma_threshold = -1;
+module_param_named(es_dma_threshold, dw_mmc_es_dma_threshold, int, 0644);
+MODULE_PARM_DESC(es_dma_threshold, "#35: DMA threshold override (-1=default)");
+
 static int dw_mci_pre_dma_transfer(struct dw_mci *host,
 				   struct mmc_data *data,
 				   int cookie)
@@ -1252,6 +1261,8 @@
 	 * with all the DMA setup overhead for short transfers.
 	 */
-	if (data->blocks * data->blksz < host->dma_threshold)
+	if (data->blocks * data->blksz <
+	    (dw_mmc_es_dma_threshold >= 0 ? (u32)dw_mmc_es_dma_threshold :
+	     host->dma_threshold))
 		return -EINVAL;

 	if (data->blksz & 3)
