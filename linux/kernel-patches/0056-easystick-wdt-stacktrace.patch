Subject: [PATCH] easystick: print a bounded WDT pretimeout stack trace

The crash capsule preserves EPC, RA, SP, and 32 bytes of stack.  When kernel
stacktrace support is enabled, also print the active trace during the
pretimeout window so the matching vmlinux can resolve the call chain offline.
This patch is selected only for the diagnostic image; it changes no watchdog
timeout, reset stage, or recovery behavior.

---
 drivers/watchdog/esp32p4_wdt.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/watchdog/esp32p4_wdt.c b/drivers/watchdog/esp32p4_wdt.c
--- a/drivers/watchdog/esp32p4_wdt.c
+++ b/drivers/watchdog/esp32p4_wdt.c
@@ -371,12 +371,15 @@ static irqreturn_t esp32p4_wdt_pretimeout(int irq, void *data)
 	struct esp32p4_wdt *wdt = data;
 
 	easystick_capture_crash(wdt, get_irq_regs(),
 				EASYSTICK_CRASH_CAPSULE_REASON_WDT);
 
 	pr_emerg("EASYSTICK_WDT PRETIMEOUT\n");
+#ifdef CONFIG_STACKTRACE
+	dump_stack();
+#endif
 	esp32p4_wdt_unlock(wdt);
 	writel(TIMG_WDT_INT, wdt->base + TIMG_INT_CLR_TIMERS);
 	esp32p4_wdt_relock(wdt);
 
 	return IRQ_HANDLED;
 }
