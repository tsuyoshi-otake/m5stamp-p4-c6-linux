--- /dev/null
+++ b/include/net/easystick_tcp_ledger.h
@@ -0,0 +1,183 @@
+/* EasyStick 0024-C2: TCP/22 bidirectional observe ledger (m3-lab only).
+ * Observe-only. No behaviour change. Port 22 only; payload>0 preferred;
+ * pure ACK only after a port-22 payload was seen on this boot.
+ */
+#ifndef _NET_EASYSTICK_TCP_LEDGER_H
+#define _NET_EASYSTICK_TCP_LEDGER_H
+
+#include <linux/atomic.h>
+#include <linux/ip.h>
+#include <linux/printk.h>
+#include <linux/skbuff.h>
+#include <linux/tcp.h>
+#include <net/inet_sock.h>
+#include <net/sock.h>
+#include <net/tcp.h>
+
+#define ES_TCP_PREFIX		"ES_TCP"
+#define ES_TCP_PORT		22
+#define ES_TCP_LOG_CAP		48
+
+/* Armed when any TCP/22 payload segment is observed (TX or RX). */
+extern unsigned long es_tcp_ssh_armed;
+
+static inline bool es_tcp_budget(void)
+{
+	static atomic_t n = ATOMIC_INIT(0);
+
+	return atomic_inc_return(&n) <= ES_TCP_LOG_CAP;
+}
+
+static inline bool es_tcp_port22(u16 sport, u16 dport)
+{
+	return sport == ES_TCP_PORT || dport == ES_TCP_PORT;
+}
+
+static inline bool es_tcp_sk_port22(const struct sock *sk)
+{
+	const struct inet_sock *inet;
+
+	if (!sk || sk->sk_protocol != IPPROTO_TCP)
+		return false;
+	inet = inet_sk(sk);
+	return es_tcp_port22(ntohs(inet->inet_sport), ntohs(inet->inet_dport));
+}
+
+static inline void es_tcp_arm(void)
+{
+	WRITE_ONCE(es_tcp_ssh_armed, 1);
+}
+
+static inline bool es_tcp_want_ack(void)
+{
+	return READ_ONCE(es_tcp_ssh_armed) != 0;
+}
+
+static inline void es_tcp_emit(const char *stage, u16 sport, u16 dport,
+			       u32 seq, u32 ack, u16 plen, u8 flags,
+			       const struct sock *sk)
+{
+	const struct tcp_sock *tp;
+	u32 snd_una = 0, snd_nxt = 0, rcv_nxt = 0;
+	u8 state = 0;
+
+	if (!es_tcp_budget())
+		return;
+	if (sk) {
+		state = (u8)sk->sk_state;
+		if (sk_fullsock(sk) && sk->sk_protocol == IPPROTO_TCP) {
+			tp = tcp_sk(sk);
+			snd_una = tp->snd_una;
+			snd_nxt = tp->snd_nxt;
+			rcv_nxt = tp->rcv_nxt;
+		}
+	}
+	/* Match ES_TX: KERN_EMERG survives lab oneshot `dmesg -n 1`. */
+	printk_deferred(KERN_EMERG ES_TCP_PREFIX
+	       " %s sport=%u dport=%u seq=%u ack=%u plen=%u flags=0x%x state=%u snd_una=%u snd_nxt=%u rcv_nxt=%u\n",
+	       stage, sport, dport, seq, ack, plen, flags, state,
+	       snd_una, snd_nxt, rcv_nxt);
+}
+
+static inline void es_tcp_mark_sk_stage(const char *stage, const struct sock *sk,
+					u32 seq, u32 ack, u16 plen, u8 flags)
+{
+	const struct inet_sock *inet;
+
+	if (!es_tcp_sk_port22(sk))
+		return;
+	inet = inet_sk(sk);
+	if (plen)
+		es_tcp_arm();
+	else if (!es_tcp_want_ack())
+		return;
+	es_tcp_emit(stage, ntohs(inet->inet_sport), ntohs(inet->inet_dport),
+		    seq, ack, plen, flags, sk);
+}
+
+static inline bool es_tcp_parse_ipv4_tcp(const struct sk_buff *skb,
+					 u16 *sport, u16 *dport,
+					 u32 *seq, u32 *ack, u16 *plen,
+					 u8 *flags)
+{
+	const struct iphdr *iph;
+	const struct tcphdr *th;
+	unsigned int ihl, thl, tot, avail;
+
+	if (!skb || skb->network_header == (typeof(skb->network_header))~0U)
+		return false;
+	avail = skb_tail_pointer(skb) - skb_network_header(skb);
+	if (avail < sizeof(*iph))
+		return false;
+	iph = ip_hdr(skb);
+	if (!iph || iph->version != 4 || iph->protocol != IPPROTO_TCP)
+		return false;
+	ihl = iph->ihl * 4u;
+	if (ihl < sizeof(*iph) || avail < ihl + sizeof(*th))
+		return false;
+	th = (const struct tcphdr *)((const u8 *)iph + ihl);
+	if (th->doff < 5)
+		return false;
+	thl = th->doff * 4u;
+	if (avail < ihl + thl)
+		return false;
+	tot = ntohs(iph->tot_len);
+	if (tot < ihl + thl)
+		return false;
+	*sport = ntohs(th->source);
+	*dport = ntohs(th->dest);
+	if (!es_tcp_port22(*sport, *dport))
+		return false;
+	*seq = ntohl(th->seq);
+	*ack = ntohl(th->ack_seq);
+	*plen = tot - ihl - thl;
+	*flags = ((const u8 *)th)[13];
+	return true;
+}
+
+static inline void es_tcp_mark_skb_stage(const char *stage,
+					 const struct sk_buff *skb,
+					 const struct sock *sk)
+{
+	u16 sport, dport, plen;
+	u32 seq, ack;
+	u8 flags;
+
+	if (!es_tcp_parse_ipv4_tcp(skb, &sport, &dport, &seq, &ack, &plen, &flags))
+		return;
+	if (plen)
+		es_tcp_arm();
+	else if (!es_tcp_want_ack())
+		return;
+	es_tcp_emit(stage, sport, dport, seq, ack, plen, flags, sk ? sk : skb->sk);
+}
+
+static inline void es_tcp_mark_th_stage(const char *stage, const struct sock *sk,
+					const struct tcphdr *th, unsigned int len)
+{
+	u16 sport, dport, plen;
+	u32 seq, ack;
+	u8 flags;
+	unsigned int thl;
+
+	if (!th || th->doff < 5)
+		return;
+	sport = ntohs(th->source);
+	dport = ntohs(th->dest);
+	if (!es_tcp_port22(sport, dport))
+		return;
+	thl = th->doff * 4u;
+	if (len < thl)
+		return;
+	plen = len - thl;
+	seq = ntohl(th->seq);
+	ack = ntohl(th->ack_seq);
+	flags = ((const u8 *)th)[13];
+	if (plen)
+		es_tcp_arm();
+	else if (!es_tcp_want_ack())
+		return;
+	es_tcp_emit(stage, sport, dport, seq, ack, plen, flags, sk);
+}
+
+#endif /* _NET_EASYSTICK_TCP_LEDGER_H */
