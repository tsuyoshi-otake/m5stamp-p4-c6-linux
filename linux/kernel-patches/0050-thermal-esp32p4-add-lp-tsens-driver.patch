diff --git a/drivers/thermal/Kconfig b/drivers/thermal/Kconfig
--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -18,5 +18,19 @@ if THERMAL
 if THERMAL
 
+config ESP32P4_TSENS
+	tristate "ESP32-P4 LP temperature sensor"
+	depends on OF
+	help
+	  Enable the built-in ESP32-P4 low-power temperature sensor.
+
+	  This bring-up driver programs the SAR/TSENS analog range through
+	  the internal REGI2C master, verifies the DAC write/readback path,
+	  and exposes a tripless thermal zone in /sys/class/thermal.
+
+	  The driver intentionally uses the fixed ESP-IDF range offset=0,
+	  REGI2C value 15. It is a vendor bring-up driver, not an upstream
+	  clock/reset/nvmem provider implementation.
+
 config THERMAL_NETLINK
 	bool "Thermal netlink management"
 	depends on NET
diff --git a/drivers/thermal/Makefile b/drivers/thermal/Makefile
