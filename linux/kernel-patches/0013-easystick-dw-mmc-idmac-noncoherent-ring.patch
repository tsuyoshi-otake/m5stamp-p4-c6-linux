+/*
+ * One OWN poll iteration.
+ *
+ * Take the ring into the CPU domain before reading, so the read cannot be
+ * answered from a line the device has since updated.  If IDMAC still owns the
+ * descriptor, hand the ring straight back to the device domain before the
+ * caller waits and polls again, so the next iteration's invalidate has
+ * something to re-fetch.  There is no unsynchronised read on this path.
+ *
+ * Both helpers are no-ops once the ring is already in the requested domain, so
+ * a settled poll costs one invalidate and a settled coherent ring costs
+ * nothing.  Callers must have the ring in the CPU domain and hold no dirty
+ * descriptor writes when they start polling: the invalidate below would throw
+ * such writes away.  dw_mci_prepare_desc{32,64}() satisfy this by polling the
+ * whole chain before writing any of it.
+ */
+static u32 dw_mci_idmac_own64(struct dw_mci *host,
+			      struct idmac_desc_64addr *desc)
+{
+	u32 val;
+
+	dw_mci_idmac_ring_to_cpu(host);
+	val = READ_ONCE(desc->des0);
+	if (val & IDMAC_DES0_OWN)
+		dw_mci_idmac_ring_to_device(host);
+
+	return val;
+}
