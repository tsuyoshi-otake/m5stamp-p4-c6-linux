+/*
+ * Descriptor-ring ownership helpers.
+ *
+ * When dmam_alloc_coherent() is unavailable the ring is an ordinary cached
+ * allocation obtained from dma_alloc_noncoherent(), so every handover between
+ * the CPU and IDMAC has to be made explicit.  Both directions act on the same
+ * memory - the CPU writes descriptors and IDMAC writes the OWN bit back - so
+ * the ring is synchronised as DMA_BIDIRECTIONAL throughout.
+ *
+ * The ring is synchronised whole rather than per descriptor.  On this
+ * architecture dma_sync_single_for_cpu(DMA_BIDIRECTIONAL) is an invalidate
+ * with no write-back, and a descriptor is far smaller than a cache line
+ * (16 bytes against dma_get_cache_alignment()), so a partial sync would
+ * discard whatever a neighbouring descriptor in the same line was holding.
+ * Whole-ring granularity has no such interior boundary, and the allocation is
+ * page-sized and page-aligned, so both ends are already cache-line aligned and
+ * the sync cannot reach memory outside the ring.
+ *
+ * sg_device_owned makes the state machine explicit and idempotent:
+ *	CPU-owned -> to_device -> device-owned -> completion/stop -> CPU-owned
+ * A repeated call in the direction the ring is already in does nothing, so
+ * these are safe to place on every path that could transfer ownership.
+ *
+ * On a coherent ring both are no-ops by construction: the sync calls are
+ * skipped entirely rather than relying on them being cheap, because the
+ * streaming sync API does not apply to a coherent allocation.
+ */
+static void dw_mci_idmac_ring_to_device(struct dw_mci *host)
+{
+	if (!host->sg_noncoherent || host->sg_device_owned)
+		return;
+
+	dma_sync_single_for_device(host->dev, host->sg_dma,
+				   DESC_RING_BUF_SZ, DMA_BIDIRECTIONAL);
+	host->sg_device_owned = true;
+}
+
+static void dw_mci_idmac_ring_to_cpu(struct dw_mci *host)
+{
+	if (!host->sg_noncoherent || !host->sg_device_owned)
+		return;
+
+	dma_sync_single_for_cpu(host->dev, host->sg_dma,
+				DESC_RING_BUF_SZ, DMA_BIDIRECTIONAL);
+	host->sg_device_owned = false;
+}
