-/* SYSTIMER register byte offsets (struct size = 0x100) */
-#define ST_CONF          0x00   /* clk_en[31], unit0_work_en[30], target0_work_en[24] */
-#define ST_UNIT0_OP      0x04   /* update[30] (WT), valid[29] (RO) */
-#define ST_TARGET0_HI    0x1C   /* target high 20 bits */
-#define ST_TARGET0_LO    0x20   /* target low 32 bits */
-#define ST_TARGET0_CONF  0x34   /* period_mode[30]=0 (oneshot), unit_sel[31]=0 (unit0) */
-#define ST_UNIT0_VAL_HI  0x40   /* latched counter high 20 bits */
-#define ST_UNIT0_VAL_LO  0x44   /* latched counter low 32 bits */
-#define ST_COMP0_LOAD    0x50   /* write 1 to apply target_val[0] to comparator */
-#define ST_INT_ENA       0x64   /* target0_int_ena[0] */
-#define ST_INT_CLR       0x6C   /* target0_int_clr[0] (WT) */
-#define ST_INT_ST        0x70   /* target0_int_st[0] (RO) */
-
-#define ST_CONF_CLK_EN         BIT(31)
-#define ST_CONF_UNIT0_WORK_EN  BIT(30)
-#define ST_CONF_TARGET0_EN     BIT(24)
-#define ST_UNIT0_OP_UPDATE     BIT(30)
-#define ST_UNIT0_OP_VALID      BIT(29)
