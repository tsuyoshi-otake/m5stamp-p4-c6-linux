-	writel((u32)(target >> 32) & 0xFFFFF, st_base + ST_TARGET0_HI);
-	writel((u32)target,                    st_base + ST_TARGET0_LO);
-
-	/* Oneshot mode, unit 0 — clear period_mode and unit_sel */
-	writel(0, st_base + ST_TARGET0_CONF);
-
-	/* Sync target value into hardware comparator */
-	writel(1, st_base + ST_COMP0_LOAD);
-
-	/* Enable target-0 interrupt and re-arm alarm */
