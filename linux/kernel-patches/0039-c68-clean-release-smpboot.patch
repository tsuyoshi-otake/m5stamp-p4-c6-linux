+/* C68-CLEAN-RELEASE: nm-fixed boot-shim IRAM words (must match cpu_ops_spinwait.c). */
+#define EASYSTICK_C68_RELEASE_PA	0xC68DEAD1u
+#define EASYSTICK_C68_STAGE_PA		0xC68DEAD2u
+#define easystick_c68_release_ptr()	((volatile u32 __force *)EASYSTICK_C68_RELEASE_PA)
+#define easystick_c68_stage_ptr()	((volatile u32 __force *)EASYSTICK_C68_STAGE_PA)
