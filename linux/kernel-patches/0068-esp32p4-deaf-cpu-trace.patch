Subject: [PATCH] stamp-p4: esp32p4 diagnostic for a CPU that stops taking interrupts (#5)

Under maxcpus=2, CPU1 sometimes takes no tick and no IPI any more (RCU:
"0 ticks this GP", "timer wakeup didn't happen ... on cpu=1").  Stamp
jiffies from each CPU's SYSTIMER interrupt.

- An idle CPU whose own stamp is more than a second old records its
  CSRs, CLIC slots 20/23, the matrix route of source 54 and the SYSTIMER
  state, twice 2 ms apart; CPU0 prints it as ES_DEAF lines.  It does
  not read the CLIC CSRs mintthresh (0x347) or mintstatus (0xfb1).  On
  a deaf CPU1, csrr 0x347 faults: CPU1 either stays on that instruction
  or reaches an illegal-instruction oops and a kernel panic.  csrr 0xfb1
  at trap entry is illegal too (0077).  A step marker and an
  arch_cpu_idle entry counter show how far CPU1 got.
- CPU1 is not always idle when it goes deaf, so CPU0 also watches
  CPU1's stamp.  When it is a second old CPU0 prints
  what it can see from outside (SYSTIMER target 1, both matrix routes of
  sources 54 and 80) as ES_DEAF0, sends CPU1 an IPI and reports 200 ms
  later whether CPU1 ticked again.
- Around the IPI CPU0 also samples CPU1's live PC and SP eight times
  through the assist_debug PC recorder (0x3ff06000 + 0xc4/0xc8/0xcc),
  which CPU0 switches on from its first SMP tick.

Opt-in with C68_DEAF_TRACE=1.  Observe-only apart from the one
extra IPI.

---
--- a/arch/riscv/kernel/process.c
+++ b/arch/riscv/kernel/process.c
@@ -41,8 +41,193 @@
 extern asmlinkage void ret_from_fork_kernel_asm(void);
 extern asmlinkage void ret_from_fork_user_asm(void);
 
+#if defined(CONFIG_SOC_ESP32P4) && defined(CONFIG_SMP)
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/cpumask.h>
+#include <linux/printk.h>
+
+/*
+ * #5 diagnostic: under SMP, CPU1 sometimes stops taking any interrupt
+ * (no tick, no IPI) while it keeps running its idle loop.  Each CPU
+ * stamps jiffies from its own SYSTIMER interrupt; an idle CPU whose
+ * stamp is more than a second old records its interrupt state twice,
+ * 2 ms apart, and CPU0 prints the record from its next tick.
+ */
+#define ES_DEAF_CLIC_CFG	0x20800000UL
+#define ES_DEAF_CLIC		0x20801000UL
+#define ES_DEAF_INTMTX0		0x500d6000UL
+#define ES_DEAF_INTMTX1		0x500d6800UL
+#define ES_DEAF_IPI_TO_CPU1	0x500e5014UL
+#define ES_DEAF_SYSTIMER	0x500e2000UL
+#define ES_DEAF_ASSIST_DEBUG	0x3ff06000UL
+
+enum { DF_CPU, DF_JIF, DF_LAST, DF_MSTATUS, DF_MIE, DF_MIP,
+       DF_MCAUSE, DF_MTVEC, DF_CLICTHR, DF_CLIC20, DF_CLIC23,
+       DF_MTX54, DF_STCONF, DF_STENA, DF_STRAW, DF_STST, DF_STT1CONF,
+       DF_MIP2, DF_CLIC23_2, DF_STRAW2, DF_JIF2, DF_WORDS };
+
+static inline u32 es_deaf_rd(unsigned long pa)
+{
+	return readl((void __iomem *)pa);
+}
+
+static unsigned long es_deaf_jif[NR_CPUS];
+static u32 es_deaf_rec[DF_WORDS];
+static int es_deaf_state;	/* 0 armed, 1 recorded, 2 printed */
+static int es_deaf0_state;	/* CPU0 watch of CPU1: 0 armed, 1 IPI sent, 2 done */
+static unsigned long es_deaf0_jif;
+static unsigned long es_deaf_idle[NR_CPUS];	/* arch_cpu_idle entries */
+static unsigned int es_deaf_step;	/* CPU1 progress through its check */
+
+/*
+ * The assist_debug block samples each core's PC and SP while
+ * RECORDEN|PDEBUGEN are set; CPU0 reads CPU1's live PC from outside.
+ */
+#define ES_DEAF_AD_C1_EN	(ES_DEAF_ASSIST_DEBUG + 0xc4)
+#define ES_DEAF_AD_C1_PC	(ES_DEAF_ASSIST_DEBUG + 0xc8)
+#define ES_DEAF_AD_C1_SP	(ES_DEAF_ASSIST_DEBUG + 0xcc)
+#define ES_DEAF_AD_C1_LASTPC	(ES_DEAF_ASSIST_DEBUG + 0xf0)
+
+static void es_deaf_pc1(const char *when)
+{
+	u32 pc[8], sp[8];
+	int i;
+
+	for (i = 0; i < 8; i++) {
+		pc[i] = es_deaf_rd(ES_DEAF_AD_C1_PC);
+		sp[i] = es_deaf_rd(ES_DEAF_AD_C1_SP);
+		udelay(100);
+	}
+	pr_emerg("ES_DEAF0 cpu1 pc %s: %08x %08x %08x %08x %08x %08x %08x %08x sp=%08x/%08x lastpc_exc=%08x rcd_en=%08x\n",
+		 when, pc[0], pc[1], pc[2], pc[3], pc[4], pc[5], pc[6], pc[7],
+		 sp[0], sp[7], es_deaf_rd(ES_DEAF_AD_C1_LASTPC),
+		 es_deaf_rd(ES_DEAF_AD_C1_EN));
+}
+
+/*
+ * CPU1 can go silent inside wfi, where its own check never runs.  CPU0
+ * then reports what it can see from outside: the SYSTIMER target 1
+ * state, both matrix routes of the CPU1 timer (source 54) and IPI
+ * (source 80), and whether an explicit IPI wakes CPU1.
+ */
+static void es_deaf_watch_cpu1(void)
+{
+	unsigned long l1 = READ_ONCE(es_deaf_jif[1]), now = jiffies;
+
+	if (es_deaf0_state == 0) {
+		if (!(es_deaf_rd(ES_DEAF_AD_C1_EN) & 3))
+			writel(3, (void __iomem *)ES_DEAF_AD_C1_EN);
+		if (!l1 || time_before(now, l1 + HZ))
+			return;
+		pr_emerg("ES_DEAF0 cpu1 idle1=%lu step=%u\n",
+			 READ_ONCE(es_deaf_idle[1]), READ_ONCE(es_deaf_step));
+		pr_emerg("ES_DEAF0 cpu1 silent jif=%lu last1=%lu mtx0_s54=%08x mtx1_s54=%08x mtx0_s80=%08x mtx1_s80=%08x st_conf=%08x st_ena=%08x st_raw=%08x st_st=%08x st_t1conf=%08x ipi1=%08x\n",
+			 now, l1,
+			 es_deaf_rd(ES_DEAF_INTMTX0 + 54 * 4),
+			 es_deaf_rd(ES_DEAF_INTMTX1 + 54 * 4),
+			 es_deaf_rd(ES_DEAF_INTMTX0 + 80 * 4),
+			 es_deaf_rd(ES_DEAF_INTMTX1 + 80 * 4),
+			 es_deaf_rd(ES_DEAF_SYSTIMER + 0x00),
+			 es_deaf_rd(ES_DEAF_SYSTIMER + 0x64),
+			 es_deaf_rd(ES_DEAF_SYSTIMER + 0x68),
+			 es_deaf_rd(ES_DEAF_SYSTIMER + 0x70),
+			 es_deaf_rd(ES_DEAF_SYSTIMER + 0x38),
+			 es_deaf_rd(ES_DEAF_IPI_TO_CPU1));
+		es_deaf_pc1("before IPI");
+		writel(1, (void __iomem *)ES_DEAF_IPI_TO_CPU1);
+		es_deaf0_jif = now;
+		es_deaf0_state = 1;
+	} else if (es_deaf0_state == 1 && time_after(now, es_deaf0_jif + HZ / 5)) {
+		pr_emerg("ES_DEAF0 +200ms after IPI: last1=%lu (%s) st_raw=%08x ipi1=%08x\n",
+			 l1, time_after(l1, es_deaf0_jif) ? "woke" : "still silent",
+			 es_deaf_rd(ES_DEAF_SYSTIMER + 0x68),
+			 es_deaf_rd(ES_DEAF_IPI_TO_CPU1));
+		es_deaf_pc1("after IPI");
+		pr_emerg("ES_DEAF0 cpu1 idle1=%lu step=%u\n",
+			 READ_ONCE(es_deaf_idle[1]), READ_ONCE(es_deaf_step));
+		es_deaf0_state = 2;
+	}
+}
+
+void esp32p4_deaf_tick(unsigned int cpu);
+
+void esp32p4_deaf_tick(unsigned int cpu)
+{
+	const u32 *r = es_deaf_rec;
+
+	if (cpu >= NR_CPUS)
+		return;
+	WRITE_ONCE(es_deaf_jif[cpu], jiffies);
+	if (cpu != 0)
+		return;
+	if (num_online_cpus() > 1)
+		es_deaf_watch_cpu1();
+	if (smp_load_acquire(&es_deaf_state) != 1)
+		return;
+	WRITE_ONCE(es_deaf_state, 2);
+	pr_emerg("ES_DEAF cpu=%u jif=%u last=%u mstatus=%08x mie=%08x mip=%08x mcause=%08x mtvec=%08x clicthr=%08x\n",
+		 r[DF_CPU], r[DF_JIF], r[DF_LAST], r[DF_MSTATUS], r[DF_MIE],
+		 r[DF_MIP], r[DF_MCAUSE], r[DF_MTVEC], r[DF_CLICTHR]);
+	pr_emerg("ES_DEAF clic20=%08x clic23=%08x mtx1_s54=%08x st_conf=%08x st_ena=%08x st_raw=%08x st_st=%08x st_t1conf=%08x\n",
+		 r[DF_CLIC20], r[DF_CLIC23], r[DF_MTX54], r[DF_STCONF],
+		 r[DF_STENA], r[DF_STRAW], r[DF_STST], r[DF_STT1CONF]);
+	pr_emerg("ES_DEAF +2ms jif=%u mip=%08x clic23=%08x st_raw=%08x\n",
+		 r[DF_JIF2], r[DF_MIP2], r[DF_CLIC23_2], r[DF_STRAW2]);
+}
+
+static void es_deaf_check(void)
+{
+	unsigned int cpu = raw_smp_processor_id();
+	unsigned long last, now = jiffies;
+	u32 *r = es_deaf_rec;
+
+	if (cpu >= NR_CPUS)
+		return;
+	es_deaf_idle[cpu]++;
+	if (cpu == 0 || READ_ONCE(es_deaf_state) != 0)
+		return;
+	last = READ_ONCE(es_deaf_jif[cpu]);
+	if (!last || time_before(now, last + HZ))
+		return;
+
+	/* Standard CSRs and MMIO only: csrr 0x347/0xfb1 fault on this core. */
+	WRITE_ONCE(es_deaf_step, 1);
+	r[DF_CPU] = cpu;
+	r[DF_JIF] = now;
+	r[DF_LAST] = last;
+	r[DF_MSTATUS] = csr_read(CSR_MSTATUS);
+	r[DF_MIE] = csr_read(CSR_MIE);
+	r[DF_MIP] = csr_read(CSR_MIP);
+	r[DF_MCAUSE] = csr_read(CSR_MCAUSE);
+	r[DF_MTVEC] = csr_read(CSR_MTVEC);
+	WRITE_ONCE(es_deaf_step, 2);
+	r[DF_CLICTHR] = es_deaf_rd(ES_DEAF_CLIC_CFG + 0x8);
+	r[DF_CLIC20] = es_deaf_rd(ES_DEAF_CLIC + 20 * 4);
+	r[DF_CLIC23] = es_deaf_rd(ES_DEAF_CLIC + 23 * 4);
+	r[DF_MTX54] = es_deaf_rd(ES_DEAF_INTMTX1 + 54 * 4);
+	r[DF_STCONF] = es_deaf_rd(ES_DEAF_SYSTIMER + 0x00);
+	r[DF_STENA] = es_deaf_rd(ES_DEAF_SYSTIMER + 0x64);
+	r[DF_STRAW] = es_deaf_rd(ES_DEAF_SYSTIMER + 0x68);
+	r[DF_STST] = es_deaf_rd(ES_DEAF_SYSTIMER + 0x70);
+	r[DF_STT1CONF] = es_deaf_rd(ES_DEAF_SYSTIMER + 0x38);
+	WRITE_ONCE(es_deaf_step, 3);
+	udelay(2000);
+	r[DF_JIF2] = jiffies;
+	r[DF_MIP2] = csr_read(CSR_MIP);
+	r[DF_CLIC23_2] = es_deaf_rd(ES_DEAF_CLIC + 23 * 4);
+	r[DF_STRAW2] = es_deaf_rd(ES_DEAF_SYSTIMER + 0x68);
+	WRITE_ONCE(es_deaf_step, 4);
+	smp_store_release(&es_deaf_state, 1);
+}
+#else
+static inline void es_deaf_check(void) { }
+#endif
+
 void noinstr arch_cpu_idle(void)
 {
+	es_deaf_check();
 	cpu_do_idle();
 }
 
--- a/drivers/clocksource/timer-esp32p4-systimer.c
+++ b/drivers/clocksource/timer-esp32p4-systimer.c
@@ -197,6 +197,9 @@
 	return 0;
 }
 
+/* #5 diagnostic, arch/riscv/kernel/process.c */
+void esp32p4_deaf_tick(unsigned int cpu);
+
 static irqreturn_t esp32p4_timer_interrupt(int irq, void *dev_id)
 {
 	struct clock_event_device *ce;
@@ -213,6 +216,7 @@
 	 * CPU enables this per-CPU parent IRQ. Clear the matching global target
 	 * before entering the clockevent callback.
 	 */
+	esp32p4_deaf_tick(cpu);
 	esp32p4_timer_stop(cpu);
 	ce = this_cpu_ptr(&esp32p4_clock_event);
 	ce->event_handler(ce);
