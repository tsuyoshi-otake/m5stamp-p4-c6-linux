Subject: [PATCH] easystick: pstore/ram on NOMMU ESP32-P4

ramoops in RAM that pfn_valid() accepts goes through vmap(), which is
BUG() on NOMMU: EASYSTICK_PSTORE=1 images died at boot with
"kernel BUG at mm/nommu.c:311" (#26).  RAM is identity mapped here, so
use phys_to_virt() and skip vunmap().

PSRAM is behind a write-back cache that the panic/watchdog reset drops:
the console record lost its last lines and no dmesg record survived.
Write the zone back after every persistent_ram_write().

---
diff --git a/fs/pstore/ram_core.c b/fs/pstore/ram_core.c
--- a/fs/pstore/ram_core.c
+++ b/fs/pstore/ram_core.c
@@ -17,6 +17,7 @@
 #include <linux/slab.h>
 #include <linux/uaccess.h>
 #include <linux/vmalloc.h>
+#include <linux/dma-map-ops.h>
 #include <linux/mm.h>
 #include <asm/page.h>
 
@@ -350,6 +351,15 @@
 
 	persistent_ram_update_header_ecc(prz);
 
+#if defined(CONFIG_SOC_ESP32P4) && defined(CONFIG_RISCV_DMA_NONCOHERENT)
+	/*
+	 * PSRAM sits behind a write-back L1D/L2 that a watchdog or panic
+	 * reset discards; without this the tail of the console and the whole
+	 * dmesg dump are lost.  Push the zone out to PSRAM on every write.
+	 */
+	arch_sync_dma_for_device(prz->paddr, prz->size, DMA_TO_DEVICE);
+#endif
+
 	return count;
 }
 
@@ -421,6 +431,13 @@
 	unsigned int i;
 	void *vaddr;
 
+#ifndef CONFIG_MMU
+	/*
+	 * NOMMU: RAM is identity mapped and vmap() is BUG(); use the linear
+	 * address.  memtype cannot be honoured without page tables.
+	 */
+	return phys_to_virt(start);
+#endif
 	page_start = start - offset_in_page(start);
 	page_count = DIV_ROUND_UP(size + offset_in_page(start), PAGE_SIZE);
 
@@ -583,7 +600,8 @@
 	if (prz->vaddr) {
 		if (pfn_valid(prz->paddr >> PAGE_SHIFT)) {
 			/* We must vunmap() at page-granularity. */
-			vunmap(prz->vaddr - offset_in_page(prz->paddr));
+			if (IS_ENABLED(CONFIG_MMU))
+				vunmap(prz->vaddr - offset_in_page(prz->paddr));
 		} else {
 			iounmap(prz->vaddr);
 			release_mem_region(prz->paddr, prz->size);
