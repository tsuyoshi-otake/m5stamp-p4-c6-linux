Subject: [PATCH] easystick: serialise ESP32-P4 ROM cache thunks across harts

The ROM cache-sync helpers drive one shared set of CACHE_SYNC registers.
The callers only disabled local interrupts, which is enough on UP but not
with maxcpus=2: flush_icache_all() runs local_flush_icache_all() on every
CPU at the same time, and the noncoherent-DMA sync ops can run on either
hart.  Two harts in the engine at once left CPU1 stuck with interrupts off
(IDF "Guru Meditation Error: Core 1", or no reply to the call-function
IPI) while CPU0 spun in smp_call_function_many_cond() under execve ->
load_flat_binary -> flush_icache_all, until the HP watchdog reset the
chip (#5).

Take one raw spinlock (IRQs off) around every thunk sequence.

---
diff --git a/arch/riscv/include/asm/cacheflush.h b/arch/riscv/include/asm/cacheflush.h
--- a/arch/riscv/include/asm/cacheflush.h
+++ b/arch/riscv/include/asm/cacheflush.h
@@ -8,6 +8,11 @@
 
 #include <linux/mm.h>
 
+#ifdef CONFIG_SOC_ESP32P4
+/* Serialises the ROM cache-sync thunks across harts (esp32p4_cache.c). */
+extern raw_spinlock_t esp32p4_cache_sync_lock;
+#endif
+
 static inline void local_flush_icache_all(void)
 {
 #ifdef CONFIG_SOC_ESP32P4
@@ -25,9 +30,11 @@
 	 * The ROM cache-sync engine drives one shared set of CACHE_SYNC
 	 * registers and is not reentrant -- ESP-IDF wraps every call in a
 	 * spinlock critical section. The same thunks are invoked from IRQ
-	 * context by the noncoherent-DMA sync ops (esp32p4_cache.c), so
-	 * run the sequence with local IRQs disabled or a nested DMA sync
-	 * can clobber an in-flight operation.
+	 * context by the noncoherent-DMA sync ops (esp32p4_cache.c) and,
+	 * with SMP, from the other hart (flush_icache_all() runs this on
+	 * every CPU at once).  Hold esp32p4_cache_sync_lock with IRQs off:
+	 * local IRQ masking alone let both harts drive the engine together,
+	 * and CPU1 never came back from it (#5).
 	 *
 	 * Deliberately NO whole-L2 invalidate here: L2 is unified, so
 	 * after the writeback it already serves coherent I-fetches, and
@@ -39,11 +46,11 @@
 	void (*inv_all)(uint32_t) = (void (*)(uint32_t))0x4fc00404UL;
 	unsigned long flags;
 
-	local_irq_save(flags);
+	raw_spin_lock_irqsave(&esp32p4_cache_sync_lock, flags);
 	wb_all(0x10);   /* L1 DCACHE writeback */
 	wb_all(0x20);   /* L2 writeback */
 	inv_all(0x03);  /* L1 ICACHE (both halves) invalidate */
-	local_irq_restore(flags);
+	raw_spin_unlock_irqrestore(&esp32p4_cache_sync_lock, flags);
 #endif
 	asm volatile ("fence.i" ::: "memory");
 }
@@ -60,12 +67,12 @@
 	unsigned long flags;
 
 	/* Same non-reentrancy rule as local_flush_icache_all(). */
-	local_irq_save(flags);
+	raw_spin_lock_irqsave(&esp32p4_cache_sync_lock, flags);
 	wb_addr(0x10, (uint32_t)start, size);   /* L1 D writeback */
 	wb_addr(0x20, (uint32_t)start, size);   /* L2 writeback */
 	inv_addr(0x03, (uint32_t)start, size);  /* L1 I invalidate */
 	inv_addr(0x20, (uint32_t)start, size);  /* L2 invalidate */
-	local_irq_restore(flags);
+	raw_spin_unlock_irqrestore(&esp32p4_cache_sync_lock, flags);
 	/*
 	 * The ranged ops above are the complete maintenance for [start,
 	 * end) -- do NOT fall through to local_flush_icache_all(). The
diff --git a/drivers/cache/esp32p4_cache.c b/drivers/cache/esp32p4_cache.c
--- a/drivers/cache/esp32p4_cache.c
+++ b/drivers/cache/esp32p4_cache.c
@@ -20,6 +20,7 @@
 #include <linux/init.h>
 #include <linux/irqflags.h>
 #include <linux/printk.h>
+#include <linux/spinlock.h>
 #include <linux/types.h>
 #include <asm/cacheflush.h>
 #include <asm/dma-noncoherent.h>
@@ -41,37 +42,42 @@
  *
  * Invalidates run outer-to-inner (L2 before L1D) so a refill between
  * the two ops cannot repopulate L1 from a still-stale L2 line.
+ *
+ * IRQ masking only covers this hart; with SMP the other hart can enter the
+ * engine at the same time, so every sequence also takes this lock (#5).
  */
+DEFINE_RAW_SPINLOCK(esp32p4_cache_sync_lock);
+EXPORT_SYMBOL(esp32p4_cache_sync_lock);
 static void esp32p4_dma_cache_wback(phys_addr_t paddr, size_t size)
 {
 	unsigned long flags;
 
-	local_irq_save(flags);
+	raw_spin_lock_irqsave(&esp32p4_cache_sync_lock, flags);
 	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L1D, (uint32_t)paddr, (uint32_t)size);
 	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L2,  (uint32_t)paddr, (uint32_t)size);
-	local_irq_restore(flags);
+	raw_spin_unlock_irqrestore(&esp32p4_cache_sync_lock, flags);
 }
 
 static void esp32p4_dma_cache_inv(phys_addr_t paddr, size_t size)
 {
 	unsigned long flags;
 
-	local_irq_save(flags);
+	raw_spin_lock_irqsave(&esp32p4_cache_sync_lock, flags);
 	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L2,  (uint32_t)paddr, (uint32_t)size);
 	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L1D, (uint32_t)paddr, (uint32_t)size);
-	local_irq_restore(flags);
+	raw_spin_unlock_irqrestore(&esp32p4_cache_sync_lock, flags);
 }
 
 static void esp32p4_dma_cache_wback_inv(phys_addr_t paddr, size_t size)
 {
 	unsigned long flags;
 
-	local_irq_save(flags);
+	raw_spin_lock_irqsave(&esp32p4_cache_sync_lock, flags);
 	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L1D, (uint32_t)paddr, (uint32_t)size);
 	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L2,  (uint32_t)paddr, (uint32_t)size);
 	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L2,  (uint32_t)paddr, (uint32_t)size);
 	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L1D, (uint32_t)paddr, (uint32_t)size);
-	local_irq_restore(flags);
+	raw_spin_unlock_irqrestore(&esp32p4_cache_sync_lock, flags);
 }
 
 static const struct riscv_nonstd_cache_ops esp32p4_cache_ops __initconst = {
