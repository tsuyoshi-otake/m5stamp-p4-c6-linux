+/* Program the i2s0 module clock to rate*256 Hz from XTAL 40 MHz
+ * using the same fractional-division scheme as IDF
+ * i2s_hal_calc_mclk_precise_division(): sclk/mclk = n + num/den,
+ * hardware-encoded as x = den/z - 1, y = den % z,
+ * z = num (or den - num when the fraction rounds up, yn1 = 1).
+ * Returns the achieved module clock in Hz. */
+static u32 esp32p4_i2s_set_mclk(struct esp32_p4_i2s *i2s,
+			      unsigned int rate, bool tx)
+{
+	u32 mclk = rate * 256, n, x = 0, y = 0, z = 0, yn1 = 0;
+	u32 err, g, den = 0, num = 0, d;
+
+	n = ESP32P4_I2S_SCLK / mclk;
+	err = ESP32P4_I2S_SCLK % mclk;
+	if (err && err < mclk - mclk / (ESP32P4_I2S_FRACT_MAX - 1) * 2) {
+		g = gcd(mclk, err);
+		den = mclk / g;
+		num = err / g;
+		d = den / ESP32P4_I2S_FRACT_MAX + 1;
+		den /= d;
+		num /= d;
+		if (den && num) {
+			yn1 = num * 2 > den;
+			z = yn1 ? den - num : num;
+			x = den / z - 1;
+			y = den % z;
+		}
+	} else if (err) {
+		n++;
+	}
+
+	if (tx) {
+		/* CTRL13: tx clk_en + src=0, div n[20:13] x[29:21];
+		 * CTRL14: y[8:0] z[17:9] yn1[18] mst_sel[19] */
+		clkrst_set(i2s, CLKRST_PERI_CLK_CTRL13,
+			   (0xff << 13) | (0x1ff << 21) |
+			   CLKRST_TX_CLK_EN | (3 << CLKRST_TX_CLK_SRC_S),
+			   (n << 13) | (x << 21) | CLKRST_TX_CLK_EN);
+		writel(y | (z << 9) | (yn1 << 18) | CLKRST_MST_CLK_SEL,
+		       i2s->clkrst + CLKRST_PERI_CLK_CTRL14);
+	} else {
+		/* CTRL12: rx div n[7:0] x[16:8] y[25:17];
+		 * CTRL13 low bits: rx z[8:0] yn1[9] */
+		writel(n | (x << 8) | (y << 17),
+		       i2s->clkrst + CLKRST_PERI_CLK_CTRL12);
+		clkrst_set(i2s, CLKRST_PERI_CLK_CTRL13, 0x3ff,
+			   z | (yn1 << 9));
+	}
+
+	/* 64/32 divide must go through div64_u64: a plain u64 division
+	 * lowers to __udivdi3, whose PLT slot resolves to a data
+	 * address on this NOMMU kernel (wild branch -> oops). */
+	return num ? (u32)DIV64_U64_ROUND_CLOSEST(
+			mul_u32_u32(ESP32P4_I2S_SCLK, den), n * den + num)
+		   : ESP32P4_I2S_SCLK / n;
+}
