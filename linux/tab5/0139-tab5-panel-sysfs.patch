Subject: [PATCH tab5] misc: tab5-panel: publish the shim's panel kind
 in /sys/kernel/board

The boot shim already identifies which display/touch panel the board
carries -- ST7121, ST7123 or the ILI9881C SKU -- from the touch
controller's firmware byte during display bring-up, but Linux could
not see the result: userspace needed it for #36 (per-SKU touch and
panel parameters), and reading it back through the I2C expander again
would race the Linux panel driver.

The shim now writes the name into the fixed 8-byte "nopanel0"
placeholder of /chosen/m5stack,panel in the DTB it hands over
("st7121", "st7123", "ili9881c" or "none").  This driver exposes it
as /sys/kernel/board/panel next to wake_reason: a late_initcall so
the shared board kobject from the NOMMU pool init exists by then, and
a plain of_chosen read so nothing is probed twice.  A missing
property (old DTB or a headless unit) reports "none".

 2 files changed, 56 insertions(+)

diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index 1111111..2222222 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -77,3 +77,4 @@
 obj-$(CONFIG_ESP32P4_BOOTFLASH)	+= esp32p4-bootflash.o
 obj-$(CONFIG_ESP32P4_SLEEP)	+= esp32p4-sleep.o
 obj-y				+= esp32p4_dsi_scanout.o
+obj-y				+= tab5-panel.o
diff --git a/drivers/misc/tab5-panel.c b/drivers/misc/tab5-panel.c
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/drivers/misc/tab5-panel.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * /sys/kernel/board/panel -- which panel the boot shim detected.
+ *
+ * tab5_detect_panel() in the boot shim reads the touch controller's
+ * firmware byte over the bit-banged panel I2C during display
+ * bring-up and rewrites the fixed-width "nopanel0" placeholder of
+ * /chosen/m5stack,panel in the DTB to the panel name ("st7121",
+ * "st7123", "ili9881c" or "none").  This file only publishes it;
+ * "none" also covers a missing property (headless boot or an old
+ * DTB without the placeholder).
+ */
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/kobject.h>
+#include <linux/nommu_userspace_pool.h>
+#include <linux/of.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+
+static char panel_name[16] = "none";
+
+static ssize_t panel_show(struct kobject *kobj,
+			  struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%s\n", panel_name);
+}
+static struct kobj_attribute panel_attr = __ATTR_RO(panel);
+
+static int __init tab5_panel_init(void)
+{
+	struct kobject *kobj = board_kobj;
+	const char *name;
+
+	if (!of_machine_is_compatible("m5stack,tab5"))
+		return 0;
+	if (of_chosen &&
+	    !of_property_read_string(of_chosen, "m5stack,panel", &name))
+		strscpy(panel_name, name, sizeof(panel_name));
+	if (!kobj)
+		kobj = kobject_create_and_add("board", kernel_kobj);
+	if (!kobj)
+		return -ENOMEM;
+	return sysfs_create_file(kobj, &panel_attr.attr);
+}
+late_initcall(tab5_panel_init);
