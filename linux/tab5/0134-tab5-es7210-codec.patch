--- a/sound/soc/codecs/es7210.c
+++ b/sound/soc/codecs/es7210.c
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal ES7210 driver for the M5Stack Tab5 (B12/#24).
+ *
+ * The part is a four-channel ADC front end; on the Tab5 only MIC1 and
+ * MIC2 are wired (on-board mics AMIC1/AMIC2), so this driver runs the
+ * chip as a plain stereo I2S ADC -- no TDM.  The register writes below
+ * reproduce the vendor esp-adf es7210.c init sequence verbatim for
+ * slave mode (verified against the published source).
+ */
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <sound/soc.h>
+
+struct es7210_priv {
+	struct regmap *regmap;
+};
+
+/* Vendor es7210_adc_init order: reset, timing, HPF quick-setup,
+ * slave mode, analog/VMID, mic bias, OSR, main clock. */
+static const struct reg_sequence es7210_init[] = {
+	{ 0x00, 0xff },		/* reset */
+	{ 0x00, 0x41 },
+	{ 0x01, 0x3f },		/* all clocks off */
+	{ 0x09, 0x30 },		/* state-machine timing */
+	{ 0x0a, 0x30 },
+	{ 0x23, 0x2a },		/* ADC12 HPF */
+	{ 0x22, 0x0a },
+	{ 0x20, 0x0a },		/* ADC34 HPF */
+	{ 0x21, 0x2a },
+	{ 0x08, 0x00 },		/* slave mode */
+	{ 0x40, 0x43 },		/* analog on, VDDA 3.3 V, VMID 5k */
+	{ 0x41, 0x70 },		/* MIC12 bias ~2.87 V */
+	{ 0x42, 0x70 },		/* MIC34 bias ~2.87 V */
+	{ 0x07, 0x20 },		/* OSR */
+	{ 0x02, 0xc1 },		/* main clock: adc_div1, dll bypass */
+};
+
+/* MIC1|MIC2 select: power ADC12 pair, PGA on, 24 dB gain, no TDM. */
+static const struct reg_sequence es7210_mic12[] = {
+	{ 0x4b, 0xff },		/* MIC12 pair power off first */
+	{ 0x4c, 0xff },		/* MIC34 pair off (mics 3/4 unused) */
+	{ 0x4b, 0x00 },		/* ADC12 pair on */
+	{ 0x43, 0x18 },		/* MIC1 PGA on, 24 dB */
+	{ 0x44, 0x18 },		/* MIC2 PGA on, 24 dB */
+	{ 0x12, 0x00 },		/* stereo, no TDM */
+	{ 0x11, 0x60 },		/* SDP iface: I2S fmt, 16-bit data */
+	{ 0x01, 0x34 },		/* 0x3f & ~0x0b: ADC12 clocks run */
+};
+
+/* Vendor coeff_div rows, restricted to the MCLK the card supplies
+ * (rate*256 -> 12.288 MHz or 11.2896 MHz families).  reg02 packs
+ * adc_div | doubler<<6 | dll_bypass<<7; reg04/05 are the LRCK
+ * divider (MCLK/LRCK). */
+struct es7210_coeff {
+	unsigned int rate;
+	u8 reg02, reg04, reg05;
+};
+
+static const struct es7210_coeff es7210_coeffs[] = {
+	{  8000, 0x83, 0x06, 0x00 },	/* 12.288M: div3 dll_byp, lrck/1536 */
+	{ 16000, 0xc3, 0x03, 0x00 },	/* 12.288M: div3+doubler, lrck/768 */
+	{ 22050, 0x81, 0x02, 0x00 },	/* 11.2896M: div1, lrck/512 */
+	{ 24000, 0x81, 0x02, 0x00 },	/* 12.288M: div1, lrck/512 */
+	{ 32000, 0x81, 0x01, 0x80 },	/* 12.288M: div1, lrck/384 */
+	{ 44100, 0x81, 0x01, 0x00 },	/* 11.2896M: div1, lrck/256 */
+	{ 48000, 0x81, 0x01, 0x00 },	/* 12.288M: div1, lrck/256 */
+};
+
+static int es7210_hw_params(struct snd_pcm_substream *substream,
+			    struct snd_pcm_hw_params *params,
+			    struct snd_soc_dai *dai)
+{
+	struct es7210_priv *priv = snd_soc_dai_get_drvdata(dai);
+	unsigned int rate = params_rate(params);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(es7210_coeffs); i++)
+		if (es7210_coeffs[i].rate == rate)
+			break;
+	if (i == ARRAY_SIZE(es7210_coeffs))
+		return -EINVAL;
+
+	regmap_write(priv->regmap, 0x02, es7210_coeffs[i].reg02);
+	regmap_write(priv->regmap, 0x07, 0x20);
+	regmap_write(priv->regmap, 0x04, es7210_coeffs[i].reg04);
+	regmap_write(priv->regmap, 0x05, es7210_coeffs[i].reg05);
+	return 0;
+}
+
+static int es7210_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S)
+		return -EINVAL;
+	return 0;
+}
+
+static const struct snd_soc_dai_ops es7210_dai_ops = {
+	.hw_params	= es7210_hw_params,
+	.set_fmt	= es7210_set_fmt,
+};
+
+static struct snd_soc_dai_driver es7210_dai = {
+	.name = "es7210-hifi",
+	.capture = {
+		.stream_name	= "Capture",
+		.channels_min	= 2,
+		.channels_max	= 2,
+		.rates		= SNDRV_PCM_RATE_8000_96000,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE |
+				  SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &es7210_dai_ops,
+};
+
+static const struct snd_soc_component_driver es7210_component = {
+	.name = "es7210",
+};
+
+static const struct regmap_config es7210_regmap_config = {
+	.reg_bits	= 8,
+	.val_bits	= 8,
+	.max_register	= 0x4c,
+	.cache_type	= REGCACHE_NONE,
+};
+
+static int es7210_i2c_probe(struct i2c_client *i2c)
+{
+	struct es7210_priv *priv;
+	int i, ret;
+
+	priv = devm_kzalloc(&i2c->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->regmap = devm_regmap_init_i2c(i2c, &es7210_regmap_config);
+	if (IS_ERR(priv->regmap))
+		return PTR_ERR(priv->regmap);
+
+	for (i = 0; i < ARRAY_SIZE(es7210_init); i++) {
+		ret = regmap_write(priv->regmap, es7210_init[i].reg,
+				   es7210_init[i].def);
+		if (ret)
+			return dev_err_probe(&i2c->dev, ret,
+					     "es7210 init write %d failed", i);
+	}
+	for (i = 0; i < ARRAY_SIZE(es7210_mic12); i++) {
+		ret = regmap_write(priv->regmap, es7210_mic12[i].reg,
+				   es7210_mic12[i].def);
+		if (ret)
+			return dev_err_probe(&i2c->dev, ret,
+					     "es7210 mic write %d failed", i);
+	}
+
+	i2c_set_clientdata(i2c, priv);
+	return devm_snd_soc_register_component(&i2c->dev,
+			&es7210_component, &es7210_dai, 1);
+}
+
+static const struct of_device_id es7210_of_match[] = {
+	{ .compatible = "everest,es7210" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, es7210_of_match);
+
+static const struct i2c_device_id es7210_i2c_id[] = {
+	{ "es7210" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, es7210_i2c_id);
+
+static struct i2c_driver es7210_i2c_driver = {
+	.driver = {
+		.name		= "es7210",
+		.of_match_table	= es7210_of_match,
+	},
+	.probe		= es7210_i2c_probe,
+	.id_table	= es7210_i2c_id,
+};
+module_i2c_driver(es7210_i2c_driver);
+
+MODULE_DESCRIPTION("Minimal ES7210 ADC driver (stereo MIC1/MIC2)");
+MODULE_LICENSE("GPL");
