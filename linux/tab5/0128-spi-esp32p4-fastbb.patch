--- a/drivers/spi/Kconfig
+++ b/drivers/spi/Kconfig
@@ -500,6 +500,17 @@ config SPI_GPIO
 	  GPIO operations, you should be able to leverage that for better
 	  speed with a custom version of this driver; see the source code.
 
+config SPI_ESP32P4_FASTBB
+	tristate "ESP32-P4 fast bit-bang SPI (direct GPIO MMIO)"
+	depends on GPIOLIB && HAS_IOMEM
+	select SPI_BITBANG
+	help
+	  A drop-in replacement for spi-gpio that drives the SCK/MOSI/CS
+	  lines and samples MISO with single GPIO OUT_W1TS/W1TC/IN register
+	  accesses instead of gpiolib calls.  On the ESP32-P4 that cuts the
+	  per-bit cost to a few MMIO operations, roughly an order of
+	  magnitude faster than spi-gpio's per-bit gpiolib path.
+
