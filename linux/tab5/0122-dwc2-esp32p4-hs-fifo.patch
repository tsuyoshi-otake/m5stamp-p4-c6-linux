From: Devin <devin@cognition.ai>
Subject: [PATCH tab5] usb: dwc2: params for the esp32p4 HS OTG core

diff --git a/drivers/usb/dwc2/params.c b/drivers/usb/dwc2/params.c
index 488f414..2b1f784 100644
--- a/drivers/usb/dwc2/params.c
+++ b/drivers/usb/dwc2/params.c
@@ -318,8 +318,31 @@ static void dwc2_set_esp32p4_params(struct dwc2_hsotg *hsotg)
 	p->power_down = DWC2_POWER_DOWN_PARAM_NONE;
 }
 
+/*
+ * The P4 HS OTG core (0x50000000, dedicated UTMI PHY) only carries the
+ * generic snps,dwc2 defaults: the auto-detected host FIFO split
+ * oversubscribes the real data-FIFO depth and trips the "invalid fifo
+ * sizes" gate.  Apply the balanced split the ESP-IDF dwc host driver
+ * uses on this core: nptx = depth/4, ptx = depth/8, rx = the rest.
+ * hw->total_fifo_size is already populated when this callback runs.
+ */
+static void dwc2_set_esp32p4_hs_params(struct dwc2_hsotg *hsotg)
+{
+	struct dwc2_core_params *p = &hsotg->params;
+	struct dwc2_hw_params *hw = &hsotg->hw_params;
+
+	if (hw->total_fifo_size < 384)
+		return;
+
+	p->host_nperio_tx_fifo_size = hw->total_fifo_size / 4;
+	p->host_perio_tx_fifo_size = hw->total_fifo_size / 8;
+	p->host_rx_fifo_size = hw->total_fifo_size -
+		p->host_nperio_tx_fifo_size - p->host_perio_tx_fifo_size;
+}
+
 const struct of_device_id dwc2_of_match_table[] = {
 	{ .compatible = "brcm,bcm2835-usb", .data = dwc2_set_bcm_params },
+	{ .compatible = "espressif,esp32p4-otg", .data = dwc2_set_esp32p4_hs_params },
 	{ .compatible = "espressif,esp32p4-otg11", .data = dwc2_set_esp32p4_params },
 	{ .compatible = "hisilicon,hi6220-usb", .data = dwc2_set_his_params },
 	{ .compatible = "ingenic,jz4775-otg", .data = dwc2_set_jz4775_params },
