+static int esp32p4_pcm_open(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+
+	snd_soc_set_runtime_hwparams(substream, &esp32p4_pcm_hardware);
+	return 0;
+}
+
+static int esp32p4_pcm_new(struct snd_soc_component *component,
+			   struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_card *card = rtd->card->snd_card;
+	struct esp32_p4_i2s *i2s = dev_get_drvdata(component->dev);
+	size_t size = 64 * 1024;
+
+	i2s->tx_descs = dmam_alloc_coherent(card->dev,
+				ESP32P4_MAX_DESCS * sizeof(*i2s->tx_descs),
+				&i2s->tx_descs_phys, GFP_KERNEL);
+	i2s->rx_descs = dmam_alloc_coherent(card->dev,
+				ESP32P4_MAX_DESCS * sizeof(*i2s->rx_descs),
+				&i2s->rx_descs_phys, GFP_KERNEL);
+	if (!i2s->tx_descs || !i2s->rx_descs)
+		return -ENOMEM;
+
+	snd_pcm_set_managed_buffer_all(rtd->pcm, SNDRV_DMA_TYPE_DEV,
+				       card->dev, size, size);
+	return 0;
+}
+
+static int esp32p4_i2s_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params,
+				 struct snd_soc_dai *dai)
+{
+	struct esp32_p4_i2s *i2s = dev_get_drvdata(dai->dev);
+	unsigned int data_bits, chan_bits = 32, bck_div;
+	u32 conf, conf1;
+	bool tx = substream->stream == SNDRV_PCM_STREAM_PLAYBACK;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		data_bits = 16;
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+		data_bits = 24;
+		break;
+	case SNDRV_PCM_FORMAT_S32_LE:
+		data_bits = 32;
+		break;
+	default:
+		return -EINVAL;
+	}
+	bck_div = DIV_ROUND_CLOSEST(ESP32P4_MOD_CLK,
+			params_rate(params) * params_channels(params) *
+			chan_bits);
+	if (!bck_div || bck_div > 63)
+		return -EINVAL;
+
+	/* std/philips on P4 runs the TDM engine with 2 slots;
+	 * msb_shift gives the 1-BCK data delay I2S expects. */
+	conf = I2S_TDM_EN | I2S_MSB_SHIFT;
+	conf |= (bck_div << I2S_BCK_DIV_NUM_S) & I2S_BCK_DIV_NUM_M;
+	conf1 = (chan_bits - 1)
+		| (((data_bits - 1) << I2S_BITS_MOD_S) & I2S_BITS_MOD_M)
+		| (((chan_bits - 1) << I2S_HALF_SAMPLE_BITS_S) &
+		   I2S_HALF_SAMPLE_BITS_M)
+		| (((chan_bits - 1) << I2S_TDM_CHAN_BITS_S) &
+		   I2S_TDM_CHAN_BITS_M);
+
+	if (tx) {
+		conf |= I2S_TX_STOP_EN;
+		i2s_wr(i2s, I2S_TX_CONF, conf);
+		i2s_wr(i2s, I2S_TX_CONF1, conf1);
+		i2s_wr(i2s, I2S_TX_TDM_CTRL,
+		       (1 << I2S_TDM_TOT_CHAN_NUM_S) | 0x3);
+	} else {
+		i2s_wr(i2s, I2S_RX_CONF, conf);
+		i2s_wr(i2s, I2S_RX_CONF1, conf1);
+		i2s_wr(i2s, I2S_RX_TDM_CTRL,
+		       (1 << I2S_TDM_TOT_CHAN_NUM_S) | 0x3);
+	}
+	return 0;
+}
