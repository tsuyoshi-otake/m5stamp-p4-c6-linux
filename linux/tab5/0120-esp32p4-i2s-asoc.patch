+static int esp32p4_i2s_probe(struct platform_device *pdev)
+{
+	struct esp32_p4_i2s *i2s;
+	u32 v;
+	int ret;
+
+	i2s = devm_kzalloc(&pdev->dev, sizeof(*i2s), GFP_KERNEL);
+	if (!i2s)
+		return -ENOMEM;
+	i2s->dev = &pdev->dev;
+	platform_set_drvdata(pdev, i2s);
+
+	i2s->i2s = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(i2s->i2s))
+		return PTR_ERR(i2s->i2s);
+	i2s->dma = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(i2s->dma))
+		return PTR_ERR(i2s->dma);
+	i2s->clkrst = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(i2s->clkrst))
+		return PTR_ERR(i2s->clkrst);
+	i2s->lpclkrst = devm_platform_ioremap_resource(pdev, 3);
+	if (IS_ERR(i2s->lpclkrst))
+		return PTR_ERR(i2s->lpclkrst);
+	i2s->gpio = devm_platform_ioremap_resource(pdev, 4);
+	if (IS_ERR(i2s->gpio))
+		return PTR_ERR(i2s->gpio);
+
+	i2s->irq_tx = platform_get_irq(pdev, 0);
+	if (i2s->irq_tx < 0)
+		return i2s->irq_tx;
+	i2s->irq_rx = platform_get_irq(pdev, 1);
+	if (i2s->irq_rx < 0)
+		return i2s->irq_rx;
+
+	i2s->peri = 3;
+	i2s->unit = 0;
+	of_property_read_u32(pdev->dev.of_node, "espressif,peri-sel", &v);
+	if (v)
+		i2s->peri = v;
+	of_property_read_u32(pdev->dev.of_node, "espressif,i2s-unit", &v);
+	if (v)
+		i2s->unit = v;
+	i2s->tx_chan = 0;
+	i2s->rx_chan = 1;
+	i2s->mclk_pin = -1;
+	i2s->bck_pin = -1;
+	i2s->ws_pin = -1;
+	i2s->dout_pin = -1;
+	i2s->din_pin = -1;
+	of_property_read_u32(pdev->dev.of_node, "espressif,mclk-pin", &v);
+	i2s->mclk_pin = (int)v;
+	of_property_read_u32(pdev->dev.of_node, "espressif,bck-pin", &v);
+	i2s->bck_pin = (int)v;
+	of_property_read_u32(pdev->dev.of_node, "espressif,ws-pin", &v);
+	i2s->ws_pin = (int)v;
+	of_property_read_u32(pdev->dev.of_node, "espressif,dout-pin", &v);
+	i2s->dout_pin = (int)v;
+	of_property_read_u32(pdev->dev.of_node, "espressif,din-pin", &v);
+	i2s->din_pin = (int)v;
+
+	ret = devm_request_irq(&pdev->dev, i2s->irq_tx, esp32p4_tx_irq, 0,
+			       pdev->name, i2s);
+	if (ret)
+		return ret;
+	ret = devm_request_irq(&pdev->dev, i2s->irq_rx, esp32p4_rx_irq, 0,
+			       pdev->name, i2s);
+	if (ret)
+		return ret;
+
+	esp32p4_i2s_hw_init(i2s);
+	pin_out(i2s, i2s->mclk_pin, I2S0_MCLK);
+	pin_out(i2s, i2s->bck_pin, I2S0_O_BCK);
+	pin_out(i2s, i2s->ws_pin, I2S0_O_WS);
+	pin_out(i2s, i2s->dout_pin, I2S0_SD);
+	pin_in(i2s, i2s->din_pin, I2S0_SD);
+
+	ret = devm_snd_soc_register_component(&pdev->dev, &esp32p4_component,
+					      &esp32p4_dai, 1);
+	if (ret)
+		return ret;
+
+	dev_info(&pdev->dev, "ESP32-P4 I2S%u registered\n", i2s->unit);
+	return 0;
+}
