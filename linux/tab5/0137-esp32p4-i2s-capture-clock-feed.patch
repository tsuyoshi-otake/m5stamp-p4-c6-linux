+/* The codec pins are driven by the TX clock tree only: O_BCK,
+ * O_WS and MCLK are TX-side outputs and the ES7210/ES8388 are bus
+ * slaves, so a capture-only stream still needs the TX unit
+ * running or the ADC sees no clocks and SDOUT stays low (every
+ * sample reads 0).  The IDF oracle proves the working model: TX
+ * owns the pin clocks and RX is a slave tapping them.  With no
+ * playback, TX runs a constant-zero feed (STOP_EN off so an empty
+ * FIFO can never kill the clock generator). */
+static void esp32p4_tx_clock_start(struct esp32_p4_i2s *i2s,
+				   unsigned int rate)
+{
+	u32 mclk = esp32p4_i2s_set_mclk(i2s, rate, true);
+	u32 bck_div = DIV_ROUND_CLOSEST(mclk, rate * 2 * 16);
+	u32 conf = I2S_TDM_EN | I2S_MSB_SHIFT | I2S_PCM_BYPASS |
+		   I2S_RX_MONO_FST_VLD | I2S_TX_BCK_NO_DLY |
+		   I2S_TX_SIG_LOOPBACK;
+	u32 conf1 = 15 | (15 << I2S_BITS_MOD_S) |
+		    (15 << I2S_HALF_SAMPLE_BITS_S) |
+		    (15 << I2S_TDM_CHAN_BITS_S);
+
+	if (bck_div && bck_div <= 63)
+		conf |= ((bck_div - 1) << I2S_BCK_DIV_NUM_S) &
+			I2S_BCK_DIV_NUM_M;
+	i2s_wr(i2s, I2S_CONF_SIGLE_DATA, 0);
+	i2s_wr(i2s, I2S_TX_CONF1, conf1);
+	i2s_wr(i2s, I2S_TX_TDM_CTRL,
+	       (1 << I2S_TDM_TOT_CHAN_NUM_S) | 0x3);
+	i2s_wr(i2s, I2S_TX_CONF, conf | I2S_START | I2S_UPDATE);
+}
+
+static void esp32p4_tx_clock_stop(struct esp32_p4_i2s *i2s)
+{
+	i2s_wr(i2s, I2S_TX_CONF, i2s_rd(i2s, I2S_TX_CONF) & ~I2S_START);
+}
