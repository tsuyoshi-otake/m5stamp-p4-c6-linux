 /* Clean up, drop to user privileges, set up the environment and execute
  * the command/shell. This function does not return. */
+#if DROPBEAR_VFORK
+/* Environment for the session child, built in the parent right before
+ * vfork().  The child shares the parent's whole address space until exec,
+ * so it must not run clearenv()/putenv()/malloc()/free() or anything else
+ * that writes shared globals or the shared heap. */
+static void envp_add(char ***penvp, unsigned int *pn,
+		const char *name, const char *val) {
+	char *s;
+	if (val == NULL) {
+		return;
+	}
+	s = m_malloc(strlen(name) + strlen(val) + 2);
+	sprintf(s, "%s=%s", name, val);
+	*penvp = m_realloc(*penvp, (*pn + 2) * sizeof(char*));
+	(*penvp)[(*pn)++] = s;
+	(*penvp)[*pn] = NULL;
+}
+
+/* Same variable set the child used to install via clearenv()+addnewvar(),
+ * but assembled in the parent where heap/env manipulation is safe. */
+static char **build_child_envp(const struct ChanSess *chansess) {
+	char **envp = NULL;
+	unsigned int n = 0;
+
+	envp_add(&envp, &n, "USER", ses.authstate.pw_name);
+	envp_add(&envp, &n, "LOGNAME", ses.authstate.pw_name);
+	envp_add(&envp, &n, "HOME", ses.authstate.pw_dir);
+	envp_add(&envp, &n, "SHELL", get_user_shell());
+	envp_add(&envp, &n, "PATH",
+			getuid() == 0 ? DEFAULT_ROOT_PATH : DEFAULT_PATH);
+	envp_add(&envp, &n, "LANG", getenv("LANG"));
+	envp_add(&envp, &n, "TERM", chansess->term);
+	envp_add(&envp, &n, "SSH_TTY", chansess->tty);
+	envp_add(&envp, &n, "SSH_CONNECTION", chansess->connection_string);
+	envp_add(&envp, &n, "SSH_CLIENT", chansess->client_string);
+	envp_add(&envp, &n, "SSH_ORIGINAL_COMMAND", chansess->original_command);
+#if DROPBEAR_SVR_PUBKEY_OPTIONS_BUILT
+	if (ses.authstate.pubkey_options
+		&& ses.authstate.pubkey_options->info_env) {
+		envp_add(&envp, &n, "SSH_PUBKEYINFO",
+				ses.authstate.pubkey_options->info_env);
+	}
+#endif
+#if DROPBEAR_SVR_AGENTFWD
+	if (chansess->agentlistener) {
+		int len = strlen(chansess->agentdir)
+				+ strlen(chansess->agentfile) + 2;
+		char *path = m_malloc(len);
+		snprintf(path, len, "%s/%s", chansess->agentdir,
+				chansess->agentfile);
+		envp_add(&envp, &n, "SSH_AUTH_SOCK", path);
+		m_free(path);
+	}
+#endif
+	return envp;
+}
+
+static void free_child_envp(void) {
+	char **e = svr_child_envp;
+	if (e) {
+		while (*e) {
+			m_free(*e++);
+		}
+		m_free(svr_child_envp);
+		svr_child_envp = NULL;
+	}
+}
+#endif /* DROPBEAR_VFORK */
