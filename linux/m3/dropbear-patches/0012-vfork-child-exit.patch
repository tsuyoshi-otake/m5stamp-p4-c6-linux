-	/* Re-enable SIGPIPE for the executed process */
+	/* Re-enable SIGPIPE for the executed process; the server ignores it
+	 * (svr-main.c commonsetup) and SIG_IGN survives execve, so the reset
+	 * is required.  Under vfork the child shares the parent's memory and
+	 * libc signal() would write uClibc's shared sighandler[] table, so
+	 * reset via a raw rt_sigaction instead - vfork has no CLONE_SIGHAND,
+	 * only the child's kernel sigaction changes. */
+#if DROPBEAR_VFORK
+	{
+		struct kernel_sigaction {
+			void (*handler)(int);
+			unsigned long flags;
+			void (*restorer)(void);
+			unsigned long mask[2];
+		} ka;
+		ka.handler = SIG_DFL;
+		ka.flags = 0;
+		ka.restorer = NULL;
+		ka.mask[0] = ka.mask[1] = 0;
+		syscall(SYS_rt_sigaction, SIGPIPE, &ka, NULL, sizeof(ka.mask));
+	}
+#else
 	if (signal(SIGPIPE, SIG_DFL) == SIG_ERR) {
 		dropbear_exit("signal() error");
 	}
+#endif
 
 	/* close file descriptors except stdin/stdout/stderr
 	 * Need to be sure FDs are closed here to avoid reading files as root */
