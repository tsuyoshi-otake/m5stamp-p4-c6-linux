# M3 optional profile: Dropbear SSH over the C6 network interface.
#
# Apply this fragment after easystick_stamp_p4_defconfig.  It is intentionally
# not part of the M1 image: the NOMMU server needs BusyBox inetd, and the
# writable /config mount is not implemented until the board-specific MTD
# overlay has been validated on hardware.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/board/easystick-stamp-p4/rootfs-overlay $(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/../m3/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/board/easystick-stamp-p4/post-build.sh $(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/../m3/post-build.sh"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/../m3/users.txt"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/../m3/busybox.fragment"

BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_TZDATA=y
BR2_PACKAGE_KMOD=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_DROPBEAR_SMALL=y
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS_FILE="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/../m3/dropbear-localoptions.h"
