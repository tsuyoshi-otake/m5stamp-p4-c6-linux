CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MEMMAP=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_TASK_WDT=n
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_INT_WDT=n
# C68-CLEAN-RELEASE: do not start CPU1 as a FreeRTOS secondary core.
CONFIG_FREERTOS_UNICORE=y

# LP core programs: the Deep Sleep temperature check (#57, lp/lp_monitor.c)
# and the user's lp.bin (#59), which must be built with the same reserve.
# The 16 KB sit at the start of LP RAM, so the RTC_NOINIT data moves up by
# that much; about 13 KB of LP RAM stay free above it.
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=16384
