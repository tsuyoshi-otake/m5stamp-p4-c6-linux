# C68-CLEAN-RELEASE kernel fragment. Appended only when
# EASYSTICK_C68_CLEAN_RELEASE=1. The UP baseline linux.config stays CONFIG_SMP=n.
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_RISCV_BOOT_SPINWAIT=y
CONFIG_ESP32P4_IPI=y
# CONFIG_HOTPLUG_CPU is not set
CONFIG_OVERLAY_FS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_MASS_STORAGE=m
CONFIG_USB_MASS_STORAGE=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZACAS is not set
CONFIG_SERIAL_ESP32_ACM=y
CONFIG_SERIAL_ESP32_ACM_CONSOLE=y
CONFIG_CMDLINE="earlycon=esp32p4usbjtag,mmio32,0x500d2000 console=ttyGS1,115200n8 loglevel=4 root=/dev/mtdblock0 rootfstype=squashfs ro init=/sbin/init maxcpus=1"
