# BusyBox services for the NOMMU Dropbear inetd front-end (inetd itself is
# in busybox-daemons, below) and for directional Wi-Fi bring-up diagnostics
# (ARP/ICMP/TCP/22 on the STA iface).
CONFIG_PASSWD=y
CONFIG_MODPROBE=y
# S05 passes file=/removable=/iSerialNumber= to g_mass_storage on the
# modprobe command line; busybox-minimal drops them without this.
CONFIG_FEATURE_CMDLINE_MODULE_OPTIONS=y
CONFIG_INSMOD=y
CONFIG_LSMOD=y
CONFIG_RMMOD=y
# Buildroot's stock udhcpc default.script calls the BusyBox mktemp
# applet while applying a lease.
CONFIG_MKTEMP=y
CONFIG_SHA256SUM=y
CONFIG_DEVMEM=y
CONFIG_NETSTAT=y
CONFIG_NC=y
CONFIG_DEFAULT_MODULES_DIR="/lib/modules"
CONFIG_DEFAULT_DEPMOD_FILE="modules.dep"
CONFIG_VI=y
CONFIG_FEATURE_VI_MAX_LEN=4096
CONFIG_FEATURE_VI_8BIT=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_READONLY=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASK_TERMINAL=y

# ==============================================================================
# NOMMU Memory Optimization: Disable bulky non-essential applets to bring
# total RAM load requirement below 480KB (order 7 / 512KB buddy limit).
# Target: ~460KB - 475KB (comfortably under 512KB with args and stack).
# ==============================================================================
# 1. Bulky math / utilities (~30KB)
# CONFIG_BC is not set
# CONFIG_DC is not set
# CONFIG_FEATURE_BC_INTERACTIVE is not set
# CONFIG_FEATURE_BC_LONG_OPTIONS is not set
# CONFIG_FACTOR is not set

# 2. IProute2 suite (~20KB) - S40network uses standard ifconfig/route/iw
# CONFIG_IP is not set
# CONFIG_IPADDR is not set
# CONFIG_IPLINK is not set
# CONFIG_IPROUTE is not set
# CONFIG_FEATURE_IP_ADDRESS is not set
# CONFIG_FEATURE_IP_LINK is not set
# CONFIG_FEATURE_IP_ROUTE is not set

# 3. Bulky network clients & services (~20KB)
# ntpd is kept for a one-shot `ntpd -q` after DHCP in station mode (#25);
# the daemon and server parts stay out.
CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
# CONFIG_FEATURE_NTPD_CONF is not set
# CONFIG_IFUP is not set
# CONFIG_IFDOWN is not set
# CONFIG_FEATURE_IFUPDOWN_EXTERNAL_DHCP is not set
# CONFIG_FEATURE_IFUPDOWN_IP is not set
# CONFIG_FEATURE_IFUPDOWN_IPV4 is not set
# CONFIG_WGET is not set
# CONFIG_FEATURE_WGET_FTP is not set
# CONFIG_TELNET is not set
# CONFIG_FEATURE_TELNET_AUTOLOGIN is not set
# CONFIG_FEATURE_TELNET_TTYPE is not set
# CONFIG_FEATURE_TELNET_WIDTH is not set
# CONFIG_ARPING is not set

# 4. Decompressors & formats (~15KB) - squashfs/kernel handled by OS
# CONFIG_BZCAT is not set
# CONFIG_FEATURE_BZIP2_DECOMPRESS is not set
# CONFIG_XZCAT is not set
# CONFIG_LZCAT is not set
# CONFIG_LZOPCAT is not set
# CONFIG_UNLZOP is not set
# CONFIG_ZCAT is not set

# 5. Miscellaneous non-essential CLI utilities (~25KB)
# CONFIG_STTY is not set
# CONFIG_HEXEDIT is not set
# CONFIG_TREE is not set
# CONFIG_FOLD is not set
# CONFIG_TS is not set
# CONFIG_TSORT is not set
# CONFIG_NL is not set
# CONFIG_PASTE is not set
# CONFIG_ASCII is not set
# CONFIG_BASE32 is not set
# CONFIG_UUDECODE is not set
# CONFIG_UUENCODE is not set
# CONFIG_LSSCSI is not set
# CONFIG_I2CTRANSFER is not set
# CONFIG_FSFREEZE is not set
# CONFIG_FREERAMDISK is not set
# CONFIG_GETFATTR is not set
# CONFIG_SETFATTR is not set
# CONFIG_SVC is not set
# CONFIG_SVOK is not set
# CONFIG_SETPRIV is not set
# CONFIG_MKDOSFS is not set
# CONFIG_CKSUM is not set
# CONFIG_CRC32 is not set
# CONFIG_SHA1SUM is not set
# CONFIG_SHA3SUM is not set
# CONFIG_SHA512SUM is not set
# CONFIG_DOS2UNIX is not set
# CONFIG_UNIX2DOS is not set
# CONFIG_W is not set
# CONFIG_WHO is not set
# CONFIG_WHOAMI is not set
# CONFIG_OD is not set
# CONFIG_START_STOP_DAEMON is not set
# CONFIG_FEATURE_START_STOP_DAEMON_FANCY is not set
# CONFIG_FEATURE_START_STOP_DAEMON_LONG_OPTIONS is not set
# CONFIG_FEATURE_MOUNT_CIFS is not set
# CONFIG_FALLOCATE is not set
# CONFIG_SHRED is not set
# CONFIG_HWCLOCK is not set
# CONFIG_NPROC is not set
# CONFIG_NUKE is not set
# CONFIG_RESUME is not set
# CONFIG_SETSERIAL is not set
# CONFIG_TRUNCATE is not set
# CONFIG_UNLINK is not set
# CONFIG_LINK is not set
# CONFIG_PARTPROBE is not set
# CONFIG_DNSDOMAINNAME is not set
# CONFIG_MESG is not set
# CONFIG_MIM is not set

# #23: on NOMMU every external command is a vfork+exec that re-copies the
# whole 450 KB bFLT image.  Run NOFORK applets (sleep, echo, test, ...) inside
# the shell itself so periodic loops stop allocating a fresh image per tick.
CONFIG_FEATURE_SH_NOFORK=y
CONFIG_FEATURE_PREFER_APPLETS=y

# #24: S05 hashes the per-device m5 password from credentials.txt at boot.
CONFIG_CRYPTPW=y

# #26: syslogd -s/-b in S05 (size-capped /run/messages).
CONFIG_FEATURE_ROTATE_LOGFILE=y

# #17: S05 formats the /tmp ramdisk (/dev/ram0) at boot.
CONFIG_MKE2FS=y

# #23: the resident daemons run from busybox-daemons, a minimal second
# BusyBox (package/busybox-daemons).  Leave them out here so PREFER_APPLETS
# cannot run them from this full image; init stays (Buildroot forces it)
# but /sbin/init points at busybox-daemons (post-build.sh).
# CONFIG_INETD is not set
# CONFIG_SYSLOGD is not set
# CONFIG_UDHCPD is not set

# #45: udhcpc runs from busybox-udhcpc, a dedicated minimal BusyBox; drop it
# from the full image so /sbin/udhcpc has a single owner and the resident
# shells shrink by the applet's size too.
# CONFIG_UDHCPC is not set

# #37: su lives in busybox-su, a separate setuid binary; keep it out of this
# one (close to the 512 KB allocation) so /bin/su has a single owner.
# CONFIG_SU is not set
