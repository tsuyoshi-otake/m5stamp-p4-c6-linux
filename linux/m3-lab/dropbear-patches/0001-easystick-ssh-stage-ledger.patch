+/* EasyStick M2.5 test-only SSH stage ledger.
+ * Dual sink (test-only): /dev/kmsg + /dev/ttyGS1, each opened once at start
+ * with O_WRONLY|O_CLOEXEC|O_NONBLOCK. Markers are write()-only; errno saved.
+ * Never stdout/stderr — inetd binds the SSH socket to stdio.
+ * No flash/MTD/PSRAM/RTC persistence.
+ *
+ * Observe: passive serial (ttyGS1) and/or dmesg | grep ES_SSH
+ *
+ * IDENT_SENT = userspace socket write of the full server banner completed.
+ * Pi observing the banner is a separate end-to-end RX check.
+ * EXEC success never returns: EXEC_BEGIN present + EXEC_FAIL absent + id stdout.
+ */
+#ifndef EASYSTICK_SSH_LEDGER_H_
+#define EASYSTICK_SSH_LEDGER_H_
+
+void es_ssh_ledger_open(void);
+void es_ssh_mark(const char *msg);
+/* After vfork: write a fixed string only; never open/snprintf/malloc. */
+void es_ssh_mark_vfork_child(void);
+/* Fail tags may reopen sinks without updating the long-lived fds
+ * (run_command closes fds 3..maxfd before execv; vfork shares .data). */
+void es_ssh_mark_fail(const char *tag, int err);
+
+#endif /* EASYSTICK_SSH_LEDGER_H_ */
--- /dev/null
+++ b/src/easystick-ssh-ledger.c
@@ -0,0 +1,92 @@
+/* EasyStick M2.5 test-only SSH stage ledger implementation. */
+#include "easystick-ssh-ledger.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static int es_ssh_kmsg_fd = -1;
+static int es_ssh_tty_fd = -1;
+
+static void es_ssh_write_sinks(const char *msg, size_t len) {
+	if (es_ssh_kmsg_fd >= 0) {
+		(void)write(es_ssh_kmsg_fd, msg, len);
+	}
+	if (es_ssh_tty_fd >= 0) {
+		(void)write(es_ssh_tty_fd, msg, len);
+	}
+}
+
+void es_ssh_ledger_open(void) {
+	int saved = errno;
+
+	if (es_ssh_kmsg_fd < 0) {
+		es_ssh_kmsg_fd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC | O_NONBLOCK);
+	}
+	if (es_ssh_tty_fd < 0) {
+		es_ssh_tty_fd = open("/dev/ttyGS1", O_WRONLY | O_CLOEXEC | O_NONBLOCK);
+	}
+	errno = saved;
+}
+
+void es_ssh_mark(const char *msg) {
+	int saved = errno;
+	size_t len;
+
+	if (msg == NULL) {
+		errno = saved;
+		return;
+	}
+	if (es_ssh_kmsg_fd < 0 || es_ssh_tty_fd < 0) {
+		es_ssh_ledger_open();
+	}
+	len = strlen(msg);
+	es_ssh_write_sinks(msg, len);
+	errno = saved;
+}
+
+void es_ssh_mark_vfork_child(void) {
+	/* Shared address space until exec: only write() to pre-opened fds. */
+	static const char msg[] = "ES_SSH VFORK_CHILD\n";
+	int saved = errno;
+
+	es_ssh_write_sinks(msg, sizeof(msg) - 1);
+	errno = saved;
+}
+
+void es_ssh_mark_fail(const char *tag, int err) {
+	char buf[48];
+	int saved = errno;
+	int n;
+	int fd;
+
+	n = snprintf(buf, sizeof(buf), "ES_SSH %s errno=%d\n", tag, err);
+	if (n <= 0) {
+		errno = saved;
+		return;
+	}
+
+	/* Prefer the long-lived fds when still open. */
+	if (es_ssh_kmsg_fd >= 0 || es_ssh_tty_fd >= 0) {
+		es_ssh_write_sinks(buf, (size_t)n);
+		errno = saved;
+		return;
+	}
+
+	/* After run_command closes 3..maxfd (or open failed at start): one-shot
+	 * reopen. Do not store into static fds — under vfork those are shared
+	 * with the suspended parent. */
+	fd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC | O_NONBLOCK);
+	if (fd >= 0) {
+		(void)write(fd, buf, (size_t)n);
+		(void)close(fd);
+	}
+	fd = open("/dev/ttyGS1", O_WRONLY | O_CLOEXEC | O_NONBLOCK);
+	if (fd >= 0) {
+		(void)write(fd, buf, (size_t)n);
+		(void)close(fd);
+	}
+	errno = saved;
+}
