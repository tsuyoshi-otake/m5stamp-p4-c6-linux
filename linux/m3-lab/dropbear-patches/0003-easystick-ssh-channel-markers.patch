 }
+
+static const char *es_ssh_pkt_type_name(unsigned char pkt_type) {
+	switch (pkt_type) {
+	case SSH_MSG_USERAUTH_SUCCESS:
+		return "USERAUTH_SUCCESS";
+	case SSH_MSG_CHANNEL_OPEN_CONFIRMATION:
+		return "CHANNEL_OPEN_CONFIRM";
+	case SSH_MSG_CHANNEL_WINDOW_ADJUST:
+		return "WINDOW_ADJUST";
+	case SSH_MSG_CHANNEL_DATA:
+		return "CHANNEL_DATA";
+	case SSH_MSG_CHANNEL_EXTENDED_DATA:
+		return "CHANNEL_EXT_DATA";
+	case SSH_MSG_CHANNEL_EOF:
+		return "CHANNEL_EOF";
+	case SSH_MSG_CHANNEL_CLOSE:
+		return "CHANNEL_CLOSE";
+	case SSH_MSG_CHANNEL_REQUEST:
+		return "CHANNEL_REQUEST";
+	default:
+		return NULL;
+	}
+}
+
+void es_ssh_mark_channel_data_build(unsigned int chan, unsigned int len) {
+	char buf[72];
+	int n;
+	int saved = errno;
+
+	n = snprintf(buf, sizeof(buf),
+		"ES_SSH CHANNEL_DATA_BUILD chan=%u len=%u\n", chan, len);
+	if (n > 0) {
+		es_ssh_mark(buf);
+	}
+	errno = saved;
+}
+
+void es_ssh_mark_channel_data_queue(unsigned int chan, unsigned int len) {
+	char buf[72];
+	int n;
+	int saved = errno;
+
+	n = snprintf(buf, sizeof(buf),
+		"ES_SSH CHANNEL_DATA_QUEUE chan=%u len=%u\n", chan, len);
+	if (n > 0) {
+		es_ssh_mark(buf);
+	}
+	errno = saved;
+}
+
+void es_ssh_mark_encrypt_begin(unsigned int ssh_seq, unsigned char pkt_type) {
+	const char *name;
+	char buf[80];
+	int n;
+	int saved = errno;
+
+	es_ssh_encrypt_begin_active = 0;
+	name = es_ssh_pkt_type_name(pkt_type);
+	if (name == NULL) {
+		errno = saved;
+		return;
+	}
+	n = snprintf(buf, sizeof(buf),
+		"ES_SSH ENCRYPT_BEGIN ssh_seq=%u type=%s\n", ssh_seq, name);
+	if (n > 0) {
+		es_ssh_mark(buf);
+		es_ssh_encrypt_begin_active = 1;
+		es_ssh_encrypt_begin_type = pkt_type;
+	}
+	errno = saved;
+}
+
+void es_ssh_mark_encrypt_done(unsigned int ssh_seq, unsigned int wire_len) {
+	char buf[72];
+	int n;
+	int saved = errno;
+
+	if (!es_ssh_encrypt_begin_active) {
+		errno = saved;
+		return;
+	}
+	es_ssh_encrypt_begin_active = 0;
+	n = snprintf(buf, sizeof(buf),
+		"ES_SSH ENCRYPT_DONE ssh_seq=%u wire_len=%u\n", ssh_seq, wire_len);
+	if (n > 0) {
+		es_ssh_mark(buf);
+	}
+	/* Socket BEGIN/DONE track the CHANNEL_DATA wire write only. */
+	if (es_ssh_encrypt_begin_type == SSH_MSG_CHANNEL_DATA
+			|| es_ssh_encrypt_begin_type == SSH_MSG_CHANNEL_EXTENDED_DATA) {
+		es_ssh_pending_seq = ssh_seq;
+		es_ssh_pending_wire_len = wire_len;
+		es_ssh_have_pending_sock = 1;
+		es_ssh_sock_begin_marked = 0;
+		es_ssh_sock_done_marked = 0;
+	}
+	errno = saved;
+}
+
+void es_ssh_mark_socket_write_begin(void) {
+	char buf[72];
+	int n;
+	int saved = errno;
+
+	if (!es_ssh_have_pending_sock || es_ssh_sock_begin_marked) {
+		errno = saved;
+		return;
+	}
+	es_ssh_sock_begin_marked = 1;
+	n = snprintf(buf, sizeof(buf),
+		"ES_SSH SOCKET_WRITE_BEGIN ssh_seq=%u wire_len=%u\n",
+		es_ssh_pending_seq, es_ssh_pending_wire_len);
+	if (n > 0) {
+		es_ssh_mark(buf);
+	}
+	errno = saved;
+}
+
+void es_ssh_mark_socket_write_done(void) {
+	char buf[72];
+	int n;
+	int saved = errno;
+
+	if (!es_ssh_have_pending_sock || es_ssh_sock_done_marked) {
+		errno = saved;
+		return;
+	}
+	es_ssh_sock_done_marked = 1;
+	n = snprintf(buf, sizeof(buf),
+		"ES_SSH SOCKET_WRITE_DONE ssh_seq=%u wire_len=%u\n",
+		es_ssh_pending_seq, es_ssh_pending_wire_len);
+	if (n > 0) {
+		es_ssh_mark(buf);
+	}
+	errno = saved;
+}
+
+void es_ssh_mark_channel_eof(void) {
+	if (es_ssh_channel_eof_marked) {
+		return;
+	}
+	es_ssh_channel_eof_marked = 1;
+	es_ssh_mark("ES_SSH CHANNEL_EOF\n");
+}
+
+void es_ssh_mark_exit_status(void) {
+	if (es_ssh_exit_status_marked) {
+		return;
+	}
+	es_ssh_exit_status_marked = 1;
+	es_ssh_mark("ES_SSH EXIT_STATUS\n");
+}
+
+void es_ssh_mark_channel_close(void) {
+	if (es_ssh_channel_close_marked) {
+		return;
+	}
+	es_ssh_channel_close_marked = 1;
+	es_ssh_mark("ES_SSH CHANNEL_CLOSE\n");
+}
