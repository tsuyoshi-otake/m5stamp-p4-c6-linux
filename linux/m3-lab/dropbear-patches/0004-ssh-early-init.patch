+
+void es_ssh_mark_fatal_site(unsigned int site) {
+	char buf[40];
+	int n;
+	int saved = errno;
+
+	n = snprintf(buf, sizeof(buf), "ES_SSH DROPBEAR_FATAL site=%u\n", site);
+	if (n > 0) {
+		es_ssh_write_sinks(buf, (size_t)n);
+	}
+	errno = saved;
+}
+
+void es_ssh_mark_signal_term(void) {
+	/* Async-signal-safe: fixed write to pre-opened fds only. */
+	static const char msg[] = "ES_SSH SIGNAL_TERM\n";
+	es_ssh_write_sinks(msg, sizeof(msg) - 1);
+}
+
