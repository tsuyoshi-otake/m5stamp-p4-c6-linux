--- a/src/easystick-ssh-ledger.c
+++ b/src/easystick-ssh-ledger.c
@@ -10,6 +10,8 @@
 
 static int es_ssh_kmsg_fd = -1;
 static int es_ssh_tty_fd = -1;
+static int es_ssh_pipe_read_marked;
+static int es_ssh_want_sock_write_mark;
 
 static void es_ssh_write_sinks(const char *msg, size_t len) {
 	if (es_ssh_kmsg_fd >= 0) {
@@ -90,3 +92,26 @@ void es_ssh_mark_fail(const char *tag, int err) {
 	}
 	errno = saved;
 }
+
+void es_ssh_mark_pipe_read_once(void) {
+	if (es_ssh_pipe_read_marked) {
+		return;
+	}
+	es_ssh_pipe_read_marked = 1;
+	es_ssh_mark("ES_SSH DROPBEAR_PIPE_READ\n");
+}
+
+void es_ssh_note_chan_data_queued(void) {
+	es_ssh_want_sock_write_mark = 1;
+}
+
+void es_ssh_try_mark_socket_write(void) {
+	static int done;
+
+	if (!es_ssh_want_sock_write_mark || done) {
+		return;
+	}
+	done = 1;
+	es_ssh_want_sock_write_mark = 0;
+	es_ssh_mark("ES_SSH DROPBEAR_SOCKET_WRITE\n");
+}
