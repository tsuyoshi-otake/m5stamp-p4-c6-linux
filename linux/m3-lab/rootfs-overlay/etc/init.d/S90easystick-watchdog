#!/bin/sh
# watchdog=1 in config.txt hands /dev/watchdog to the userland feeder (#32-6).
# Default off: the kernel keeps feeding the watchdog itself.

# NOMMU reserve gate (#50 round 4): keep the feeder system-side when a user
# restarts this script; same one-shot/fallback contract as S40network.
if [ -z "${ES_SYSMARK:-}" ] && [ -x /usr/sbin/easystick-sys ]; then
	rc=0
	ES_SYSMARK=1 /usr/sbin/easystick-sys "$0" "$@" || rc=$?
	[ "$rc" -eq 111 ] || exit "$rc"
fi

PIDFILE=/run/.es-watchdog.pid

enabled() {
	cr=$(printf '\r')
	v=$(sed -e "s/$cr\$//" /tmp/config.txt 2>/dev/null |
		sed -n 's/^[ 	]*watchdog[ 	]*=[ 	]*//p' | head -n1 | tr -d ' ')
	[ "$v" = "1" ]
}

stop() {
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null || true
		rm -f "$PIDFILE"
	fi
}

case "${1:-start}" in
	start)
		enabled || exit 0
		/usr/sbin/easystick-watchdog </dev/null &
		echo $! > "$PIDFILE"
		;;
	stop) stop ;;
	restart|reload)
		stop
		sleep 1
		"$0" start
		;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
