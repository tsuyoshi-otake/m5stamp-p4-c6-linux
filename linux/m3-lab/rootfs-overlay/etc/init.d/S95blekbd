#!/bin/sh
# BLE keyboard daemon (#41).  Runs only while at least one bond exists
# in the staged runtime store (S05tmpfs copies the image's bond file to
# /tmp; /boot itself is unmounted again before we run), so a board with
# no paired keyboard keeps no resident BLE process at all.

BONDS="${BLE_BONDS:-/tmp/ble-bonds.dat}"
BLEKBD="${BLEKBD:-/usr/bin/ble-kbd}"

case "${1:-start}" in
	start)
		[ -s "$BONDS" ] || exit 0
		"$BLEKBD" daemon >/dev/null 2>&1 &
		;;
	stop)
		killall ble-kbd 2>/dev/null || true
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
