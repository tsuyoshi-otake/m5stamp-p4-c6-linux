#!/bin/sh

# BusyBox ash in the RV32 NOMMU image does not implement `set -u`.
set -e

# Parsing helpers: tolerate a UTF-8 BOM, CRLF, spaces around "=" and comments.
# $3 is optional sed commands applied to the value.  Keep this one process:
# BusyBox is not shared text on NOMMU, so every pipeline stage costs another
# ~0.5 MB copy, and the old sed|sed|head (plus |tr) ran first-boot S40 out of
# memory ("Allocation of length 507904 ... failed").
conf_get() {
	bom=$(printf '\357\273\277')
	cr=$(printf '\r')
	sed -n -e "1s/^$bom//" -e "s/$cr\$//" \
		-e "/^[[:blank:]]*$1[[:blank:]]*=/{s/^[[:blank:]]*$1[[:blank:]]*=[[:blank:]]*//;${3:-}p;q;}" "$2" 2>/dev/null
}

UNQUOTE='s/^"//;s/"[ 	]*$//;'
NOSPACE='s/ //g;'

# sleep is not a NOFORK applet, so waiting with it in a loop is a vfork+exec
# (~480 KB on NOMMU) every second (#40).  Like bootsync's tick(): read -t on
# a FIFO nobody writes waits inside the shell itself.
NET_TICK_FIFO=/run/.es-net-tick
net_tick() {
	if [ -p "$NET_TICK_FIFO" ]; then
		read -r -t "$1" _ 0<> "$NET_TICK_FIFO" 2>/dev/null || true
	else
		sleep "$1"
	fi
}

# bootsync runs "apply" with stdout on /dev/null (a full restart is chatty);
# the per-key results go to the console next to bootsync's own lines.
net_note() {
	echo "$1" > /dev/console 2>/dev/null || echo "$1"
}

# Signal every running process named $1 ($2 = signal) with builtins only;
# killall/pidof are execs.
sig_if_running() {
	for f in /proc/[0-9]*/comm; do
		c=""
		read -r c < "$f" 2>/dev/null || continue
		[ "$c" = "$1" ] || continue
		pid=${f%/comm}
		kill "-$2" "${pid#/proc/}" 2>/dev/null || true
	done
}

proc_running() {
	for f in /proc/[0-9]*/comm; do
		c=""
		read -r c < "$f" 2>/dev/null || continue
		[ "$c" = "$1" ] && return 0
	done
	return 1
}

conf_ssid() {
	conf_get ssid "$1" "$UNQUOTE"
}

# DHCP failed: do not invent a lab address or claim to be connected.
dhcp_failed() {
	local ssid=$(conf_ssid "$CONF")
	echo "M3-lab: DHCP failed"
	ifconfig wlan0 2>/dev/null || true
	[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "DHCP_FAILED" "none" "none" "none" "${ssid:-none}" "sta" &
	return 0
}


# Run udhcpc and wait for an address.  NOMMU BusyBox re-execs and daemonizes
# udhcpc unless -f is given, so the parent returns 0 before any lease exists.
# With -f in a background job the client keeps running and renews the lease.
run_dhcp() {
	udhcpc -f -i wlan0 -t 5 -T 3 >/dev/null 2>&1 &
	n=0
	while [ "$n" -lt 30 ]; do
		if ifconfig wlan0 2>/dev/null | grep 'inet addr:' | grep -vq 'inet addr:0\.0\.0\.0'; then
			return 0
		fi
		n=$((n + 1))
		net_tick 1
	done
	return 1
}

# wpa_supplicant runs in the foreground under easystick-respawn, like udhcpd:
# if it dies it is restarted.  A shell "while" loop would keep a private
# ~500 KB BusyBox copy resident on NOMMU for each supervised daemon.
WPA_SUP=/run/.es-wpa-sup
WPA_PID=/run/.es-wpa-pid
stop_sup() {
	s=""
	read -r s 2>/dev/null < "$1" || true
	# The supervisor stops its child when it is terminated.
	[ -n "$s" ] && kill "$s" 2>/dev/null || true
	rm -f "$1"
}

stop_wpa() {
	stop_sup "$WPA_SUP"
	if wpa_alive; then
		kill "$p" 2>/dev/null || true
	fi
	rm -f "$WPA_PID"
	killall wpa_supplicant 2>/dev/null || true
	# Its 1.8 MB block must be free before the next one can be loaded.
	n=0
	while killall -0 wpa_supplicant 2>/dev/null && [ "$n" -lt 10 ]; do
		net_tick 1
		n=$((n + 1))
	done
}

# True while the current wpa_supplicant child is alive (kill -0 is a builtin).
wpa_alive() {
	p=""
	read -r p 2>/dev/null < "$WPA_PID" || return 1
	[ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

# `iw dev wlan0 link` says "Connected" once the C6 has associated, before the
# WPA handshake, and with a wrong PSK it keeps flipping back to it while the
# AP retries.  wpa_supplicant holds operstate at "dormant" until the keys are
# installed, so only "up" means the link carries traffic (#25).
sta_authorized() {
	o=""
	read -r o 2>/dev/null < /sys/class/net/wlan0/operstate || return 1
	[ "$o" = up ]
}

# A rejected config makes wpa_supplicant exit at once, on every respawn.  An
# exec that failed for want of 1.8 MB of contiguous RAM (NOMMU fragmentation)
# usually works on a respawn 5 s later, so give it two before falling back.
wpa_settled() {
	for t in 3 6 6 6; do
		net_tick "$t"
		wpa_alive && return 0
	done
	return 1
}

# Start wpa_supplicant with $CONF; if it rejects the file (short psk, syntax
# error, BOM...), fall back to the built-in default so the board stays reachable.
spawn_wpa() {
	# The udhcpc status hook reads the SSID from the file in use.
	echo "$CONF" > /run/.es-wpa-conf
	easystick-respawn -d 5 -p "$WPA_PID" -- \
		wpa_supplicant -q -i wlan0 -c "$CONF" >/dev/null 2>&1 &
	echo $! > "$WPA_SUP"
}

start_wpa() {
	stop_wpa
	spawn_wpa
	wpa_settled && return 0
	echo "M3-lab: wpa_supplicant failed with $CONF; falling back to /etc/easystick/wpa_supplicant.conf"
	CONF=/etc/easystick/wpa_supplicant.conf
	stop_wpa
	spawn_wpa
	wpa_settled || echo "M3-lab: wpa_supplicant fallback failed"
}

# channel= (1-13) in config.txt overrides the SoftAP frequency (#24).  The
# source file may be on the exported drive, so edit a copy on /run.
apply_channel() {
	[ -f "$CFG" ] || return 0
	ch=$(conf_get channel "$CFG" "$NOSPACE")
	[ -n "$ch" ] || return 0
	case "$ch" in
		[1-9]|1[0-3]) ;;
		*) echo "M3-lab: ignoring invalid channel=$ch (expected 1-13)"; return 0 ;;
	esac
	freq=$((2407 + 5 * ch))
	if grep -q '^[[:space:]]*frequency=' "$CONF"; then
		sed "s/^\([[:space:]]*\)frequency=.*/\1frequency=$freq/" "$CONF" > /run/wpa_ap.conf
	else
		sed "s/^\([[:space:]]*\)mode=2.*/&\n\1frequency=$freq/" "$CONF" > /run/wpa_ap.conf
	fi
	chmod 600 /run/wpa_ap.conf
	CONF=/run/wpa_ap.conf
	echo "M3-lab: SoftAP channel $ch ($freq MHz)"
}

# country=XX in config.txt sets the regulatory domain (#32).  Without it the
# board stays on the world domain, which is the safe default.
apply_country() {
	[ -f "$CFG" ] || return 0
	cc=$(conf_get country "$CFG" "${NOSPACE}y/abcdefghijklmnopqrstuvwxyz/ABCDEFGHIJKLMNOPQRSTUVWXYZ/;")
	[ -n "$cc" ] || return 0
	case "$cc" in
		[A-Z][A-Z]) ;;
		*) echo "M3-lab: CONFIG ERROR: country=$cc is not a two-letter code; ignored"; return 0 ;;
	esac
	# Built-in cfg80211 asks for regulatory.db before the rootfs is mounted
	# and keeps that failure, so "iw reg set" silently stays on 00 until the
	# database is reloaded (#12).
	iw reg reload 2>/dev/null || true
	if iw reg set "$cc" 2>/dev/null; then
		echo "M3-lab: regulatory domain $cc"
	else
		echo "M3-lab: could not set regulatory domain $cc"
	fi
}

# wifi_ssid= / wifi_psk= in config.txt generate the Wi-Fi config so users do not
# have to write wpa_supplicant.conf (#25).  wifi_mode=ap makes it a SoftAP,
# otherwise a station.  Invalid values are reported and ignored.
config_wifi() {
	[ -f "$CFG" ] || return 0
	w_ssid=$(conf_get wifi_ssid "$CFG" "$UNQUOTE")
	[ -n "$w_ssid" ] || return 0
	w_psk=$(conf_get wifi_psk "$CFG" "$UNQUOTE")
	w_mode=$(conf_get wifi_mode "$CFG" "$NOSPACE")
	case "$w_ssid$w_psk" in
		*'"'*|*'\'*)
			echo "M3-lab: CONFIG ERROR: wifi_ssid/wifi_psk must not contain \" or \\; using $CONF"
			return 0 ;;
	esac
	if [ "${#w_ssid}" -gt 32 ]; then
		echo "M3-lab: CONFIG ERROR: wifi_ssid is longer than 32 bytes; using $CONF"
		return 0
	fi
	if [ -n "$w_psk" ] && { [ "${#w_psk}" -lt 8 ] || [ "${#w_psk}" -gt 63 ]; }; then
		echo "M3-lab: CONFIG ERROR: wifi_psk must be 8-63 characters; using $CONF"
		return 0
	fi
	if [ "$w_mode" = "ap" ] && [ -z "$w_psk" ]; then
		echo "M3-lab: CONFIG ERROR: wifi_mode=ap needs wifi_psk; using $CONF"
		return 0
	fi
	# wifi_pmf=1: optional management frame protection (802.11w, #32).  Peers
	# without PMF still connect.  Opt-in until tested with the C6 firmware.
	w_akm=WPA-PSK
	w_pmf=""
	if [ "$(conf_get wifi_pmf "$CFG" "$NOSPACE")" = "1" ] && [ -n "$w_psk" ]; then
		w_akm="WPA-PSK WPA-PSK-SHA256"
		w_pmf=1
	fi
	{
		echo "update_config=0"
		echo "ap_scan=1"
		echo "network={"
		printf '\tssid="%s"\n' "$w_ssid"
		if [ "$w_mode" = "ap" ]; then
			printf '\tmode=2\n\tfrequency=2437\n\tkey_mgmt=%s\n\tproto=RSN\n' "$w_akm"
			printf '\tpairwise=CCMP\n\tgroup=CCMP\n'
		elif [ -n "$w_psk" ]; then
			printf '\tscan_ssid=1\n\tkey_mgmt=%s\n' "$w_akm"
		else
			printf '\tscan_ssid=1\n\tkey_mgmt=NONE\n'
		fi
		[ -n "$w_pmf" ] && printf '\tieee80211w=1\n'
		[ -n "$w_psk" ] && printf '\tpsk="%s"\n' "$w_psk"
		echo "}"
	} > /run/wpa_cfg.conf
	chmod 600 /run/wpa_cfg.conf
	CONF=/run/wpa_cfg.conf
	echo "M3-lab: Wi-Fi config generated from config.txt (ssid=$w_ssid mode=${w_mode:-sta}${w_pmf:+ pmf=optional})"
}

# Choose the effective wpa_supplicant conf and config.txt the same way at
# boot and on a live apply: /boot, then /tmp, then the built-in defaults;
# config_wifi may switch CONF to the generated /run/wpa_cfg.conf.
select_conf() {
	CONF=/etc/easystick/wpa_supplicant.conf
	if [ -f /boot/wpa_supplicant.conf ]; then
		CONF=/boot/wpa_supplicant.conf
	elif [ -f /tmp/wpa_supplicant.conf ]; then
		CONF=/tmp/wpa_supplicant.conf
	fi

	CFG=/etc/easystick/config.txt
	if [ -f /boot/config.txt ]; then
		CFG=/boot/config.txt
	elif [ -f /tmp/config.txt ]; then
		CFG=/tmp/config.txt
	fi
	config_wifi || true
}

# No RTC: set the clock once from NTP after a station lease (#25).  -q exits
# after the first sync so no daemon stays resident.  ntp_server= in config.txt
# overrides the pool; ntp_server=none disables it.
sync_time() {
	command -v ntpd >/dev/null 2>&1 || return 0
	srv=$(conf_get ntp_server "$CFG" "$NOSPACE")
	[ "$srv" = "none" ] && return 0
	( ntpd -n -q -p "${srv:-pool.ntp.org}" >/dev/null 2>&1 &&
		echo "M3-lab: clock set from NTP: $(date)" ) &
}

# udhcpd runs in the foreground under easystick-respawn (#29): it comes back
# if it dies, and -f keeps NOMMU udhcpd from re-execing itself as a daemon.
UDHCPD_SUP=/run/.es-udhcpd-sup
stop_udhcpd() {
	stop_sup "$UDHCPD_SUP"
	killall udhcpd 2>/dev/null || true
}

start() {
	# The cmdline boots with loglevel=4, so kernel markers at KERN_INFO and
	# below (ES_WDT, OBS) stay in dmesg only.  Console traffic at loglevel 8
	# starves SDIO/ARP on this NOMMU target even after the quiet ESP-Hosted
	# patches (0024/0025), so it stays opt-in: debug=1 in config.txt raises
	# the console to KERN_DEBUG for bring-up captures (#26); expect slower
	# Wi-Fi/SSH while it is on.  The ES_* lines from init scripts are plain
	# echo output and always print; check-boot-log.py depends on them.
	if [ "$(conf_get debug /tmp/config.txt "$NOSPACE")" = "1" ]; then
		echo "M3-lab: debug=1: console loglevel 8 (all kernel messages)"
		dmesg -n 8 2>/dev/null || true
	else
		dmesg -n 4 2>/dev/null || true
	fi

	# sdio_mhz= in config.txt overrides the built-in rate (#21).  The module
	# cannot be unloaded, so it applies at boot only, and the DTB's
	# max-frequency still caps the bus.
	WANT_MHZ="${ES_SDIO_MHZ:-}"
	if [ -z "$WANT_MHZ" ]; then
		WANT_MHZ=$(conf_get sdio_mhz /tmp/config.txt "$NOSPACE")
		case "$WANT_MHZ" in
			'') ;;
			1|2|5|10|20|40) echo "M3-lab: sdio_mhz=$WANT_MHZ from config.txt" ;;
			*)
				echo "M3-lab: ignoring sdio_mhz=$WANT_MHZ (use 1, 2, 5, 10, 20 or 40)"
				WANT_MHZ=
				;;
		esac
	fi
	if [ -z "$WANT_MHZ" ] && [ -r /etc/easystick/sdio-clock-mhz ]; then
		WANT_MHZ=$(cat /etc/easystick/sdio-clock-mhz)
	fi
	WANT_MHZ="${WANT_MHZ:-5}"
	case "$WANT_MHZ" in
		1|2|5|10|20|40) ;;
		*) echo "ES_SDIO_CLOCK_FAIL invalid requested_mhz=$WANT_MHZ" >&2; exit 70 ;;
	esac
	MODULE_DIR="/lib/modules/$(uname -r)"
	KO="$MODULE_DIR/updates/esp32_sdio.ko"
	[ -f "$KO" ] || KO="$MODULE_DIR/extra/esp32_sdio.ko"
	if grep -q '^esp32_sdio ' /proc/modules; then
		echo "ES_SDIO_PRELOADED=1 requested_mhz=$WANT_MHZ (reusing loaded module)"
	else
		[ -f "$KO" ] || {
			echo "ES_SDIO_INSMOD_FAIL missing_ko=$KO requested_mhz=$WANT_MHZ" >&2
			exit 70
		}
		if insmod "$KO" "clockspeed=$WANT_MHZ"; then
			MODULE_SOURCE=S40
		else
			rc=$?
			echo "ES_SDIO_INSMOD_FAIL rc=$rc ko=$KO requested_mhz=$WANT_MHZ" >&2
			exit "$rc"
		fi
		[ -r /sys/module/esp32_sdio/parameters/clockspeed ] || {
			echo "ES_SDIO_CLOCK_FAIL module_param_unavailable source=$MODULE_SOURCE requested_mhz=$WANT_MHZ" >&2
			exit 70
		}
		ACTUAL_PARAM_MHZ=$(cat /sys/module/esp32_sdio/parameters/clockspeed)
		[ "$ACTUAL_PARAM_MHZ" = "$WANT_MHZ" ] || {
			echo "ES_SDIO_CLOCK_FAIL source=$MODULE_SOURCE requested_mhz=$WANT_MHZ module_param_mhz=$ACTUAL_PARAM_MHZ" >&2
			exit 70
		}
		MODULE_SHA256=$(sha256sum "$KO" 2>/dev/null)
		MODULE_SHA256=${MODULE_SHA256%% *}
		echo "ES_SDIO_LOAD_OK source=$MODULE_SOURCE requested_mhz=$WANT_MHZ module_param_mhz=$ACTUAL_PARAM_MHZ module_sha256=${MODULE_SHA256:-unavailable}"
	fi

	# All modules the image needs were just insmod'ed (or modprobe'd in
	# S05); nothing loads on demand later.  An empty helper name makes the
	# kernel's request_module() return without forking /sbin/modprobe --
	# a ~480 KB BusyBox exec observed inside every reload (#40).  If a
	# driver ever does need a lazy module it must be added to the explicit
	# insmod list above instead.
	# echo, not ": >": a bare truncate never reaches the sysctl handler.
	echo > /proc/sys/kernel/modprobe 2>/dev/null || true

	# S05 cached the initial configuration before exporting boot.img.  Runtime
	# updates are staged by easystick-bootsync only after a host SCSI eject;
	# never inspect the backing image from a network reload while it is exported.

	select_conf

	is_ap=0
	if [ -f "$CFG" ]; then
		cfg_mode=$(conf_get wifi_mode "$CFG" "$NOSPACE")
		cfg_host=$(conf_get hostname "$CFG" "$NOSPACE")
		# On a full restart after hostname= was deleted, go back to the boot name.
		[ -n "$cfg_host" ] || read -r cfg_host < /etc/hostname 2>/dev/null || true
		if [ -n "$cfg_host" ]; then
			hostname "$cfg_host" 2>/dev/null || true
		fi
		# The conf that wpa_supplicant runs decides the mode; a wifi_mode= that
		# contradicts it would start an AP with a station conf or the reverse,
		# so report it and follow the conf (#9).
		if grep -q '^[[:space:]]*mode=2' "$CONF" 2>/dev/null; then
			is_ap=1
		fi
		if [ "$cfg_mode" = "ap" ] && [ "$is_ap" -eq 0 ]; then
			echo "M3-lab: CONFIG ERROR: wifi_mode=ap but $CONF is a station config (no mode=2); starting station mode"
		elif [ "$cfg_mode" = "sta" ] && [ "$is_ap" -eq 1 ]; then
			echo "M3-lab: CONFIG ERROR: wifi_mode=sta but $CONF is an AP config (mode=2); starting SoftAP"
		fi
	elif grep -q '^[[:space:]]*mode=2' "$CONF" 2>/dev/null; then
		is_ap=1
	fi

	i=0
	while [ "$i" -lt 30 ]; do
		if ifconfig wlan0 >/dev/null 2>&1; then
			echo "M3-lab: wlan0 appeared"
			apply_country || true

			if [ "$is_ap" -eq 1 ]; then
				echo "M3-lab: starting SoftAP mode from $CONF"
				stop_udhcpd
				ifconfig wlan0 down 2>/dev/null || true
				iw dev wlan0 set type __ap 2>/dev/null || iw dev wlan0 set type ap 2>/dev/null || true
				ifconfig wlan0 192.168.4.1 netmask 255.255.255.0 up || true
				rm -rf /var/run/wpa_supplicant* 2>/dev/null || true
				apply_channel || true
				start_wpa
				net_tick 1
				if command -v udhcpd >/dev/null 2>&1; then
					mkdir -p /tmp /var/lib/misc
					touch /run/udhcpd.leases
					easystick-respawn -- udhcpd -f -S /etc/udhcpd.conf >/dev/null 2>&1 &
					echo $! > "$UDHCPD_SUP"
					echo "M3-lab: udhcpd started on wlan0 (192.168.4.1)"
				else
					echo "M3-lab: udhcpd not found"
				fi
				AP_SSID=$(conf_ssid "$CONF")
				echo "M3-lab: SoftAP started (SSID: ${AP_SSID:-m5}, IP: 192.168.4.1)"
				[ -x /etc/init.d/S85easystick-ssh ] && /etc/init.d/S85easystick-ssh restart &
				[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "AP_ACTIVE" "192.168.4.1" "255.255.255.0" "192.168.4.1" "${AP_SSID:-m5}" "ap" &
				return 0
			fi

			# STA / managed mode
			ifconfig wlan0 down 2>/dev/null || true
			iw dev wlan0 set type managed || true
			ifconfig wlan0 0.0.0.0 up || true
			rm -rf /var/run/wpa_supplicant* 2>/dev/null || true
			start_wpa
			j=0
			while [ "$j" -lt 60 ]; do
				if sta_authorized; then
					echo "M3-lab: association complete; configuring IPv4"
					if command -v udhcpc >/dev/null 2>&1; then
						if run_dhcp; then
							sync_time
						else
							dhcp_failed
						fi
					else
						dhcp_failed
					fi
					[ -x /etc/init.d/S85easystick-ssh ] && /etc/init.d/S85easystick-ssh restart &
					return 0
				fi
				j=$((j + 1))
				net_tick 1
			done
			echo "M3-lab: wlan0 link status after timeout"
			iw dev wlan0 link 2>/dev/null || true
			ifconfig wlan0 2>/dev/null || true
			sta_ssid=$(conf_ssid "$CONF")
			# wpa_supplicant's scans fill the cfg80211 cache: an SSID that is
			# there but never associated points at the PSK (#25).
			sta_state=SSID_NOT_FOUND
			if [ -n "$sta_ssid" ] && iw dev wlan0 scan dump 2>/dev/null |
				grep -Fqx "	SSID: $sta_ssid"; then
				sta_state=AUTH_FAILED
			fi
			echo "M3-lab: wlan0 did not associate ($sta_state)"
			[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "$sta_state" "none" "none" "none" "${sta_ssid:-none}" "sta" &
			return 0
		fi
		i=$((i + 1))
		net_tick 1
	done
	echo "M3-lab: wlan0 did not appear"
}

# The existing full restart, shared by "reload"/"restart" and by apply for
# wifi_mode or anything without a targeted handler (#39).
net_reload_seq() {
	stop_udhcpd
	stop_wpa
	killall udhcpc 2>/dev/null || true
	ifconfig wlan0 down 2>/dev/null || true
	rm -rf /var/run/wpa_supplicant* 2>/dev/null || true
	net_tick 1
	start
}

# Wi-Fi credential keys with the mode still "sta": regenerate the conf and
# SIGHUP the running wpa_supplicant (2.x re-reads its -c file and keeps the
# OLD config if the new one does not parse, so a broken save degrades to
# "still on the old network" rather than killing the daemon), then make
# udhcpc release and renew the lease.  No 1.8 MB re-exec (#39).  Returns 1
# whenever the HUP path cannot apply the change; the caller then runs the
# full restart, which keeps the /etc/easystick/wpa_supplicant.conf fallback.
apply_wpa_hup() {
	select_conf
	# A SoftAP conf is rebuilt, not reloaded.
	if grep -q '^[[:space:]]*mode=2' "$CONF" 2>/dev/null; then
		return 1
	fi
	# wpa_supplicant re-reads the -c file it was started with; a different
	# conf path needs a re-exec.
	cur=""
	read -r cur 2>/dev/null < /run/.es-wpa-conf || true
	[ "$cur" = "$CONF" ] || return 1
	wpa_alive || return 1
	kill -HUP "$p" 2>/dev/null || return 1
	# operstate is still "up" from the old association right after the
	# signal.  A reconfigure deauthenticates first; if the link never
	# drops, the new conf was rejected and the old one is still in use.
	n=0
	while sta_authorized; do
		[ "$n" -ge 3 ] && return 1
		n=$((n + 1))
		net_tick 1
	done
	n=0
	while [ "$n" -lt 15 ]; do
		sta_authorized && break
		n=$((n + 1))
		net_tick 1
	done
	sta_authorized || return 1
	if proc_running udhcpc; then
		# Release the old lease, then ask for a new one on the new network.
		sig_if_running udhcpc USR2
		net_tick 1
		sig_if_running udhcpc USR1
	else
		# The last start() never authorized (wrong PSK, AP missing), so it
		# stopped before DHCP and there is no client to renew: correcting
		# the PSK would leave the link up with no address.
		if run_dhcp; then
			sync_time
		else
			dhcp_failed
		fi
		[ -x /etc/init.d/S85easystick-ssh ] && /etc/init.d/S85easystick-ssh restart &
	fi
	net_note "M3-lab: Wi-Fi settings applied without a restart (wpa_supplicant reloaded)"
	return 0
}

# One apply/reload at a time (#39): a second requester appends its keys to
# /run/.netapply.pending and returns; the lock holder drains the file when
# it finishes.  The lock is an mkdir (atomic in hush); a holder killed
# mid-run leaves a stale lock, so a requester whose mkdir fails checks the
# recorded PID and steals the lock when that process is gone.  /run is
# tmpfs, so a reboot clears both files.
NET_LOCK=/run/.netapply.lock
NET_PENDING=/run/.netapply.pending

net_acquire() {
	if mkdir "$NET_LOCK" 2>/dev/null; then
		echo $$ > "$NET_LOCK/pid"
		return 0
	fi
	p=""
	read -r p 2>/dev/null < "$NET_LOCK/pid" || true
	if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then
		rm -rf "$NET_LOCK"
		if mkdir "$NET_LOCK" 2>/dev/null; then
			echo $$ > "$NET_LOCK/pid"
			return 0
		fi
	fi
	return 1
}

# Run the actions for one batch of queued request tokens.  Unknown keys are
# never ignored: they get the full restart (#39).
net_dispatch() {
	full=0
	hup=0
	for k in "$@"; do
		case "$k" in
			full|wifi_mode)
				full=1 ;;
			ssh_password_auth|sdio_mhz|watchdog|maxcpus)
				net_note "ES_CONFIG: $k= changed; applies at the next boot" ;;
			autorun*|auto_reboot)
				# autorun_* is applied by bootsync's autorun_apply;
				# auto_reboot is re-read on every save.
				;;
			debug)
				if [ "$(conf_get debug /tmp/config.txt "$NOSPACE")" = "1" ]; then
					dmesg -n 8 2>/dev/null || true
				else
					dmesg -n 4 2>/dev/null || true
				fi ;;
			hostname)
				h=$(conf_get hostname /tmp/config.txt "$NOSPACE") || h=""
				# A deleted hostname= goes back to the boot name.
				[ -n "$h" ] || read -r h < /etc/hostname 2>/dev/null || true
				[ -n "$h" ] && hostname "$h" 2>/dev/null || true
				# easystick-mdns answers with gethostname() per query,
				# so the new name serves mDNS with no restart or HUP.
				;;
			country)
				# apply_country reads $CFG, which only start() sets.
				CFG=/tmp/config.txt
				apply_country || true ;;
			ntp_server)
				# Read on the next lease's sync_time; nothing to do now.
				;;
			channel)
				# A different SoftAP frequency means rebuilding the AP;
				# in station mode the key is unused.
				select_conf
				if grep -q '^[[:space:]]*mode=2' "$CONF" 2>/dev/null; then
					full=1
				fi ;;
			wifi_ssid|wifi_psk|wifi_pmf|ssid|wpa_supplicant.conf)
				hup=1 ;;
			*)
				net_note "ES_CONFIG: $k has no targeted apply; restarting the network"
				full=1 ;;
		esac
	done
	if [ "$full" -eq 1 ]; then
		net_reload_seq
	elif [ "$hup" -eq 1 ]; then
		apply_wpa_hup || {
			net_note "M3-lab: Wi-Fi reload without a restart failed; restarting the network"
			net_reload_seq
		}
	fi
	return 0
}

net_apply() {
	case " $* " in
		*" full "*) echo full > "$NET_PENDING" ;;
		*) echo "$*" >> "$NET_PENDING" ;;
	esac
	# The holder may already be past its last pending check; retry once so a
	# just-released lock is picked up instead of stranding our queued keys.
	if ! net_acquire; then
		net_tick 1
		net_acquire || return 0
	fi
	rounds=0
	while :; do
		passes=0
		while [ -s "$NET_PENDING" ] && [ "$passes" -lt 5 ]; do
			passes=$((passes + 1))
			reqs=""
			while IFS= read -r l || [ -n "$l" ]; do
				reqs="$reqs $l"
			done < "$NET_PENDING"
			rm -f "$NET_PENDING"
			net_dispatch $reqs
		done
		rm -rf "$NET_LOCK"
		# A request written between the last drain and the unlock had no
		# holder to drain it; pick it up ourselves.  If another requester
		# already holds the lock it drains the file instead.
		[ -s "$NET_PENDING" ] || break
		rounds=$((rounds + 1))
		[ "$rounds" -ge 4 ] && break
		net_acquire || break
	done
	return 0
}

[ -p "$NET_TICK_FIFO" ] || mkfifo -m 600 "$NET_TICK_FIFO" 2>/dev/null || true

case "${1:-start}" in
	start) start ;;
	stop)
		stop_udhcpd
		stop_wpa
		killall udhcpc 2>/dev/null || true
		ifconfig wlan0 down 2>/dev/null || true
		rm -rf /var/run/wpa_supplicant* 2>/dev/null || true
		[ -x /usr/sbin/easystick-update-status ] && /usr/sbin/easystick-update-status "STOPPED" "none" "none" "none" "none" "none" &
		;;
	reload|restart)
		net_apply full
		;;
	apply)
		shift
		net_apply "$@"
		;;
	*) echo "Usage: $0 {start|stop|restart|reload|apply KEY...}" >&2; exit 1 ;;
esac

exit 0
