#!/bin/sh

# BusyBox ash in the RV32 NOMMU image does not implement `set -u`.
set -e

es_log() {
	printf '%s\n' "$1"
}

# Per-device credentials (#24) -----------------------------------------------
# No 0/O/1/I/l so the values can be read off a screen and typed.
CRED_CHARS='A-HJ-NP-Za-km-z2-9'

rand_str() {
	s=""
	while [ "${#s}" -lt "$1" ]; do
		s="$s$(dd if=/dev/urandom bs=64 count=1 2>/dev/null | tr -dc "$2")"
	done
	printf '%s' "$s" | head -c "$1"
}

# /dev/urandom does not block; wait (first boot only) until the kernel reports
# the CRNG as seeded so the generated secrets are not predictable.
wait_crng() {
	n=0
	while [ "$n" -lt 20 ]; do
		[ "$(cat /proc/sys/kernel/random/entropy_avail 2>/dev/null || echo 0)" -ge 256 ] && return 0
		dmesg 2>/dev/null | grep -q 'crng init done' && return 0
		n=$((n + 1))
		sleep 1
	done
	return 1
}

# The image ships with the same SSID/PSK on every board; replace exactly that.
is_default_wifi() {
	[ ! -f "$1" ] && return 0
	grep -q '^[[:space:]]*ssid="m5"' "$1" && grep -q '^[[:space:]]*psk="m5stamp-p4-c6"' "$1"
}

# First boot: write /boot/credentials.txt and, if the Wi-Fi config is still the
# shipped default, a SoftAP config with SSID m5-<id>, a random PSK and a
# channel spread over 1/6/11.  The Wi-Fi MAC is not known yet (wlan0 appears
# in S40, after the drive is exported), so <id> is a random device id.
generate_credentials() {
	wait_crng || es_log "ES_CREDENTIALS WARN: CRNG not reported ready; using /dev/urandom anyway"
	id=$(rand_str 4 '0-9A-F')
	pw=$(rand_str 12 "$CRED_CHARS")
	rpw=$(rand_str 12 "$CRED_CHARS")
	case "$id" in
		[0-4]*) ch=1 ;;
		[5-9A]*) ch=6 ;;
		*) ch=11 ;;
	esac
	{
		echo "# EasyStick credentials, generated on first boot."
		echo "# password= is the SSH/console password of user m5.  Edit and save it:"
		echo "# it is applied a few seconds later and at every boot."
		echo "# root_password= is the su password of root (#37), same rules."
		echo "# The Wi-Fi settings in effect are wpa_supplicant.conf (ssid/psk) and"
		echo "# config.txt (channel=); ssid/psk below are the generated values."
		echo "device_id=$id"
		echo "password=$pw"
		echo "root_password=$rpw"
	} > /boot/credentials.txt
	if is_default_wifi /boot/wpa_supplicant.conf; then
		psk=$(rand_str 12 "$CRED_CHARS")
		cat > /boot/wpa_supplicant.conf <<-EOF
		update_config=0
		ap_scan=1

		network={
		$(printf '\t')ssid="m5-$id"
		$(printf '\t')mode=2
		$(printf '\t')frequency=$((2407 + 5 * ch))
		$(printf '\t')key_mgmt=WPA-PSK
		$(printf '\t')proto=RSN
		$(printf '\t')pairwise=CCMP
		$(printf '\t')group=CCMP
		$(printf '\t')psk="$psk"
		}
		EOF
		{
			echo "ssid=m5-$id"
			echo "psk=$psk"
		} >> /boot/credentials.txt
		if ! grep -q '^[[:space:]]*channel[[:space:]]*=' /boot/config.txt 2>/dev/null; then
			printf '\n# SoftAP channel (1-13), applied by S40network.\nchannel=%s\n' "$ch" >> /boot/config.txt
		fi
		# The template's static status.txt still names the old shared SSID.
		rm -f /boot/status.txt
		es_log "ES_CREDENTIALS NEW: ssid=m5-$id psk=$psk channel=$ch user=m5 password=$pw root_password=$rpw"
	else
		es_log "ES_CREDENTIALS NEW: user=m5 password=$pw root_password=$rpw (custom wpa_supplicant.conf kept)"
	fi
	es_log "ES_CREDENTIALS: also in credentials.txt on the USB drive and /tmp/credentials.txt (root)"
}

# apply_password, apply_root_password, install_keys, install_root_keys;
# bootsync uses them too.
. /usr/lib/easystick/credentials.sh
# autorun_stage (#34).
. /usr/lib/easystick/autorun.sh

start() {
	es_log "ES_TMPFS BEGIN"
	mkdir -p /tmp 2>/dev/null || true
	# NOMMU: tmpfs is ramfs here and ignores size=, so /tmp is ext2 on the
	# 2 MB brd ramdisk to give it a hard cap (#17).  ramfs is the fallback.
	if mke2fs -q -m 0 -i 4096 /dev/ram0 >/dev/null 2>&1 &&
	   mount -t ext2 /dev/ram0 /tmp 2>/dev/null; then
		chmod 1777 /tmp
		rmdir /tmp/lost+found 2>/dev/null || true
		es_log "ES_TMPFS OK: ext2 on /dev/ram0"
	else
		mount -t tmpfs -o mode=1777 tmpfs /tmp 2>/dev/null || true
		es_log "ES_TMPFS FAIL: no /dev/ram0 ext2, /tmp is uncapped ramfs"
	fi

	# /run (= /var/run) lives on the read-only squashfs; wpa_supplicant
	# ctrl_interface, PID files and /etc/dropbear need it writable.
	mkdir -p /run 2>/dev/null || true
	mount -t tmpfs -o mode=0755,size=512k tmpfs /run 2>/dev/null || true

	# Fix devpts ptmx permissions and optimize VM memory fragmentation
	mount -o remount,gid=5,mode=620,ptmxmode=0666 /dev/pts 2>/dev/null || true
	# The resident daemons fill the 6 MB nommu pool, so every exec after boot
	# takes a 512 KB block from the 20 MB buddy heap.  A 4 MB reserve made
	# that fail with free memory just above it and 512 KB blocks free (#23);
	# 1 MB still leaves the Wi-Fi driver's atomic allocations headroom.
	echo 1024 > /proc/sys/vm/min_free_kbytes 2>/dev/null || true
	echo 500 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null || true
	# Watermark boost raises min by up to 8 MB after a fragmenting allocation
	# and only kswapd reclaim clears it.  With no swap and almost no page cache
	# nothing is reclaimable, so order-0 allocations OOM with 10 MB free
	# (seen killing wpa_supplicant on a switch to station mode).
	echo 0 > /proc/sys/vm/watermark_boost_factor 2>/dev/null || true

	# Hardening: root daemons write fixed names in world-writable /tmp, so make
	# the kernel refuse symlink/hardlink/regular-file tricks there.  NOMMU has
	# no memory isolation, so an Oops must reset the board (panic=5) instead of
	# running on with corrupted memory.
	echo 1 > /proc/sys/fs/protected_symlinks 2>/dev/null || true
	echo 1 > /proc/sys/fs/protected_hardlinks 2>/dev/null || true
	echo 2 > /proc/sys/fs/protected_regular 2>/dev/null || true
	echo 1 > /proc/sys/kernel/dmesg_restrict 2>/dev/null || true
	echo 1 > /proc/sys/kernel/kptr_restrict 2>/dev/null || true
	echo 1 > /proc/sys/kernel/panic_on_oops 2>/dev/null || true
	# vm.overcommit_memory stays 0 (#16): NOMMU backs every mapping with real
	# pages when it is made, so nothing is overcommitted, and mode 2 would cap
	# commitments at half of RAM and refuse ordinary allocations.

	# Clock floor: with no RTC the time starts at 1970.  Use the build time so
	# certificates and file times are at least plausible until NTP exists.
	if [ "$(date +%Y)" -lt 2026 ] && [ -r /etc/easystick-release ]; then
		bd=$(sed -n "s/^build_date=//p" /etc/easystick-release | head -n1 | tr T Z | sed "s/Z/ /;s/Z$//")
		[ -n "$bd" ] && date -s "$bd" >/dev/null 2>&1 || true
	fi

	# Syslog to /run/messages, root-only, rotated at 32 KB with one old copy
	# (#26).  The shared-memory ring (-C, logread) needs SysV IPC, which the
	# kernel leaves out.
	if command -v syslogd >/dev/null 2>&1; then
		( umask 077; syslogd -O /run/messages -s 32 -b 1 ) 2>/dev/null || true
	fi

	# Login records (#37), root:utmp 0664 as on Debian so m5 can run who and
	# last.  Dropbear writes them with the utmp group but cannot create them,
	# and copies wtmp (on this /tmp ramdisk) over wtmp.1 at 32 KiB (dropbear
	# patch 0011), so wtmp.1 must exist too.
	for f in /var/run/utmp /var/log/wtmp /var/log/wtmp.1; do
		{ : > "$f" && chown root:utmp "$f" && chmod 664 "$f"; } 2>/dev/null ||
			es_log "ES_LOGIN_RECORDS FAIL: $f"
	done

	# ramoops records of the previous boot (#26; absent in images built
	# with EASYSTICK_PSTORE=0).
	if [ -d /sys/fs/pstore ] && grep -qw pstore /proc/filesystems 2>/dev/null; then
		if mount -t pstore -o nosuid,nodev,noexec pstore /sys/fs/pstore 2>/dev/null; then
			n=$(ls /sys/fs/pstore | grep -c '' || true)
			es_log "ES_PSTORE OK: $n record(s) in /sys/fs/pstore"
		else
			es_log "ES_PSTORE FAIL: mount"
		fi
	fi

	# Writable /home, /root, /var/lib: copy the few squashfs entries to /tmp
	# and bind-mount the copy.  Not overlayfs: ext2 and ramfs lack
	# RENAME_WHITEOUT/EXCHANGE, so a lower name that was deleted could not be
	# created again until reboot (mkdir /home/m5 -> EINVAL, #12).
	es_log "ES_OVERLAY BEGIN"
	for d in /home /root /var/lib; do
		mkdir -p "$d" "/tmp/rw${d}" 2>/dev/null || true
		if cp -a "${d}/." "/tmp/rw${d}/" 2>/dev/null &&
		   mount -o bind "/tmp/rw${d}" "$d" 2>/dev/null; then
			es_log "ES_OVERLAY OK: $d"
		else
			es_log "ES_OVERLAY FAIL: $d"
		fi
	done
	es_log "ES_OVERLAY COMPLETE"

	# Mount the 256KB FAT filesystem locally only before exporting it. Once the
	# LUN is attached, Linux must not mount or modify the backing image.
	es_log "ES_BOOT_FAT BEGIN"
	if [ ! -f /tmp/boot.img ]; then
		# Restore the flashed boot image through the boot-shim PSRAM handoff.
		# 0x499c0000 = 1234960384 bytes, 1234960384 / 4096 = 301504 blocks
		if [ -c /dev/mem ]; then
			es_log "ES_BOOT_FAT: attempting restore from PSRAM 0x499c0000"
			dd if=/dev/mem bs=4096 skip=301504 count=64 of=/tmp/boot.img 2>/dev/null || true
		fi
		# Verify whether /tmp/boot.img is a valid 256KB FAT image (test mount)
		IMG_SZ=$(wc -c < /tmp/boot.img 2>/dev/null || echo 0)
		VALID_FAT=0
		if [ "$IMG_SZ" -eq 262144 ]; then
			mkdir -p /tmp/.test_mnt_fat
			if mount -t vfat -o ro,loop /tmp/boot.img /tmp/.test_mnt_fat 2>/dev/null; then
				umount /tmp/.test_mnt_fat 2>/dev/null || true
				VALID_FAT=1
			fi
			rm -rf /tmp/.test_mnt_fat 2>/dev/null || true
		fi
		if [ "$VALID_FAT" -ne 1 ]; then
			es_log "ES_BOOT_FAT: PSRAM image invalid or empty; using boot-template.img"
			if [ -f /etc/easystick/boot-template.img ]; then
				cp -f /etc/easystick/boot-template.img /tmp/boot.img
			fi
		else
			es_log "ES_BOOT_FAT: successfully restored valid FAT image from PSRAM"
			# What flash holds; bootsync writes only an image that
			# differs from it.
			md5sum /tmp/boot.img 2>/dev/null | cut -d' ' -f1 > /run/.boot-flash-md5 || true
		fi
	fi
	# The image holds credentials.txt and the Wi-Fi PSK (#11).
	chmod 600 /tmp/boot.img 2>/dev/null || true

	mkdir -p /boot 2>/dev/null || true
	if [ -f /tmp/boot.img ]; then
		if mount -t vfat -o loop,rw,sync,umask=0000 /tmp/boot.img /boot 2>/dev/null; then
			es_log "ES_BOOT_FAT OK: mounted /tmp/boot.img on /boot"
		else
			es_log "ES_BOOT_FAT FAIL: fallback bind-mount"
			mkdir -p /tmp/boot
			mount --bind /tmp/boot /boot 2>/dev/null || true
		fi
	else
		mkdir -p /tmp/boot
		mount --bind /tmp/boot /boot 2>/dev/null || true
	fi

	# The boot shim leaves "FAIL" in the update request when it could not
	# write the last USB drive changes to flash (#13).  Say so on the console
	# and on the drive, then clear the marker.
	if [ "$(devmem 0x499bf000 32 2>/dev/null)" = 0x45534243 ] &&
		[ "$(devmem 0x499bf010 32 2>/dev/null)" = 0x4641494C ]; then
		es_log "ES_BOOT_UPDATE FAIL: the last USB drive changes could not be saved to flash; the drive shows the previous contents"
		printf '%s\r\n' "The last changes to this drive could not be saved to flash." \
			"The drive shows the previous contents. Make the changes again." \
			"Delete this file when done." \
			> /boot/UPDATE-FAILED.txt 2>/dev/null || true
		devmem 0x499bf010 32 0 2>/dev/null || true
	fi

	# Factory reset (#32): an empty file named factory-reset on the USB drive
	# restores the shipped template, so the code below generates new
	# credentials and saves the reset image to flash.
	# factory-reset.txt too: Notepad adds the extension.
	if { [ -f /boot/factory-reset ] || [ -f /boot/factory-reset.txt ]; } &&
		[ -f /etc/easystick/boot-template.img ]; then
		es_log "ES_FACTORY_RESET: restoring the boot FAT template"
		umount /boot 2>/dev/null || true
		cp -f /etc/easystick/boot-template.img /tmp/boot.img
		mount -t vfat -o loop,rw,sync,umask=0000 /tmp/boot.img /boot 2>/dev/null ||
			es_log "ES_FACTORY_RESET FAIL: could not mount the template"
	fi

	# Initialize /boot files if not present
	if [ -d /boot ]; then
		if [ ! -f /boot/cmdline.txt ] && [ -r /proc/cmdline ]; then
			{ echo "# Reference only: a copy of /proc/cmdline. Editing this file has no effect."; cat /proc/cmdline; } > /boot/cmdline.txt 2>/dev/null || true
		fi
		if [ ! -f /boot/wpa_supplicant.conf ] && [ -r /etc/easystick/wpa_supplicant.conf ]; then
			cp -f /etc/easystick/wpa_supplicant.conf /boot/wpa_supplicant.conf 2>/dev/null || true
		fi
		if [ ! -f /boot/config.txt ]; then
			cat << 'EOF' > /boot/config.txt 2>/dev/null || true
# EasyStick Stamp-P4 Boot & Hardware Configuration
# Device: M5Stamp ESP32-P4 + C6 SDIO (EasyStick Stamp-P4)
# hostname is applied at boot by S40network.
hostname=easystick
# wifi_mode: ap or sta.  Leave unset to auto-detect from mode=2 in wpa_supplicant.conf.
#wifi_mode=ap
# wifi_ssid/wifi_psk replace wpa_supplicant.conf (station, or SoftAP with wifi_mode=ap).
#wifi_ssid=MyRouter
#wifi_psk=MyPassphrase
# Optional management frame protection (802.11w) with wifi_psk.
#wifi_pmf=1
# Keys only over SSH; needs an authorized_keys file on this drive.
#ssh_password_auth=no
# root SSH login is key-only: put a root_authorized_keys file on this drive
# (#37).  su uses root_password= in credentials.txt.
# maxcpus is fixed in the DTB (maxcpus=1); this file does not change the CPU count.
EOF
		fi
		CRED_NEW=0
		if [ ! -f /boot/credentials.txt ]; then
			if generate_credentials; then
				CRED_NEW=1
			else
				es_log "ES_CREDENTIALS FAIL: could not write credentials to /boot"
			fi
		elif ! grep -q '^root_password=' /boot/credentials.txt; then
			# Upgrade (#37): a credentials.txt from an older image has no
			# root_password=.  Generate one and append it; the commit below
			# writes it to flash like the first-boot credentials.
			rpw=$(rand_str 12 "$CRED_CHARS")
			if printf 'root_password=%s\n' "$rpw" >> /boot/credentials.txt; then
				CRED_NEW=1
				es_log "ES_CREDENTIALS NEW: root_password=$rpw (added for su)"
			else
				es_log "ES_CREDENTIALS FAIL: could not add root_password= to /boot/credentials.txt"
			fi
		fi
		apply_password /boot/credentials.txt || true
		apply_root_password /boot/credentials.txt || true
		install_keys /boot/authorized_keys || true
		install_root_keys /boot/root_authorized_keys || true
		if [ -f /boot/credentials.txt ]; then
			cp -f /boot/credentials.txt /tmp/credentials.txt 2>/dev/null || true
			chmod 600 /tmp/credentials.txt 2>/dev/null || true
		fi
		# Cache /boot configuration files to /tmp so S40network can access them
		# even after /boot is unmounted for USB Mass Storage
		if [ -f /boot/wpa_supplicant.conf ]; then
			cp -f /boot/wpa_supplicant.conf /tmp/wpa_supplicant.conf 2>/dev/null || true
			chmod 600 /tmp/wpa_supplicant.conf 2>/dev/null || true
		fi
		if [ -f /boot/config.txt ]; then
			cp -f /boot/config.txt /tmp/config.txt 2>/dev/null || true
			chmod 600 /tmp/config.txt 2>/dev/null || true
		fi
		# main.py/main.sh/main for autorun; bootsync starts it once the
		# init scripts are done.
		if autorun_stage /boot; then
			es_log "ES_AUTORUN STAGED"
		else
			es_log "ES_AUTORUN FAIL: could not copy the program from the drive"
		fi
		# Flush and unmount /boot before exposing backing file to USB host
		# to prevent concurrent filesystem cache corruption between Linux and Windows
		sync
		umount /boot 2>/dev/null || true
		es_log "ES_BOOT_FS SYNC_UMOUNT OK"
		# Save the image with the new credentials to the A/B flash slots.  If
		# the kernel cannot write flash it stays staged and boot-shim writes
		# it at the next normal reboot; until then a power cycle loses it and
		# the next boot generates new values.
		if [ "${CRED_NEW:-0}" -eq 1 ] && [ -f /tmp/boot.img ] && [ -x /usr/sbin/easystick-boot-commit ]; then
			rc=0
			/usr/sbin/easystick-boot-commit /tmp/boot.img || rc=$?
			case "$rc" in
				0)
					es_log "ES_CREDENTIALS: saved to flash"
					md5sum /tmp/boot.img 2>/dev/null | cut -d' ' -f1 > /run/.boot-flash-md5 || true
					;;
				2) es_log "ES_CREDENTIALS: staged; saved to flash at the next reboot" ;;
				*) es_log "ES_CREDENTIALS FAIL: could not stage boot.img; a power cycle generates new credentials" ;;
			esac
		fi
	fi

	# bootsync saves the drive when the host's writes change the image after
	# this point (easystick-bootsync, SEEN_REF).
	touch -r /tmp/boot.img /run/.bootsync-seen 2>/dev/null || true

	# Start USB Mass Storage Gadget on Full-Speed DWC2 (Type-A port)
	if [ -f /tmp/boot.img ]; then
		es_log "ES_USB_GADGET STARTING"
		USB_SERIAL=$(tr -d : 2>/dev/null < /sys/class/net/wlan0/address || true)
		if [ -z "$USB_SERIAL" ]; then
			USB_SERIAL=$(sed -n 's/^device_id=\([0-9A-F]*\).*/EASYSTICK\1/p' /tmp/credentials.txt 2>/dev/null | head -n1)
		fi
		USB_SERIAL=${USB_SERIAL:-EASYSTICK0001}
		if modprobe g_mass_storage file=/tmp/boot.img removable=1 stall=0 iSerialNumber="$USB_SERIAL" 2>&1; then
			es_log "ES_USB_GADGET OK: g_mass_storage enabled"
		elif modprobe g_mass_storage 2>&1; then
			es_log "ES_USB_GADGET OK: g_mass_storage enabled (modprobe.d)"
		else
			es_log "ES_USB_GADGET FAIL"
		fi

			# Now that g_mass_storage is ready, attach to USB host by enabling D+ pullup.
			# Runtime imports require a host-issued safe eject; bootsync never forces one.
		if command -v devmem >/dev/null 2>&1; then
			devmem 0x50080000 32 0x00163000 || true
			es_log "ES_USB_GADGET ATTACH: D+ pullup enabled (0x00163000)"
		fi
	fi

	# Seed the kernel RNG now that /var/lib is writable
	if command -v seedrng >/dev/null 2>&1; then
		mkdir -p /var/lib/seedrng
		seedrng || true
		es_log "ES_SEEDRNG OK"
	fi

	# Dump DWC2 status registers to syslog/dmesg for boot verification
	if command -v devmem >/dev/null 2>&1; then
		d_cfg=$(devmem 0x50040800 32 2>/dev/null || true)
		d_sts=$(devmem 0x50040808 32 2>/dev/null || true)
		d_ctl=$(devmem 0x50040804 32 2>/dev/null || true)
		g_otg=$(devmem 0x50040000 32 2>/dev/null || true)
		es_log "ES_DWC2_STATUS: DCFG=$d_cfg DSTS=$d_sts DCTL=$d_ctl GOTGCTL=$g_otg"
	fi
}

case "${1:-start}" in
	start) start ;;
	*) echo "Usage: $0 start" >&2; exit 1 ;;
esac
