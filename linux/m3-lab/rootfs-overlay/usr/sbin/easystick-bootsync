#!/bin/sh
# Import boot.img only after the USB host has issued SCSI eject. The empty LUN
# file attribute is the ownership hand-off; this daemon never forces eject.

BOOT_IMG="/tmp/boot.img"
LUN_CTL="/usr/sbin/easystick-usb-lun"
BOOT_COMMIT="/usr/sbin/easystick-boot-commit"
MNT_POINT="/tmp/mnt_snap"
LAST_HASH_FILE="/tmp/.bootsync_last_hash"

log() {
	echo "[bootsync] $1"
}

boot_hash() {
	HASH=""
	[ -f "$1" ] || return 1
	line=$(md5sum "$1" 2>/dev/null) || return 1
	HASH=${line%% *}
	[ -n "$HASH" ]
}

file_changed() {
	[ ! -f "$2" ] && return 0
	boot_hash "$1" || return 0
	left=$HASH
	boot_hash "$2" || return 0
	[ "$left" != "$HASH" ]
}

lun_state() {
	LUN_STATE=$($LUN_CTL state 2>/dev/null) || LUN_STATE="error"
}

reattach() {
	if ! $LUN_CTL reattach >/dev/null 2>&1; then
		log "ERROR: could not reattach boot.img; USB storage remains unavailable"
		return 1
	fi
	log "USB storage reattached"
}

mkdir -p "$MNT_POINT"
while [ ! -f "$BOOT_IMG" ] || [ ! -x "$LUN_CTL" ]; do
	sleep 2
done

LAST_STATE=""
log "Daemon started; use the host's safe-eject action to apply configuration"

while true; do
	sleep 1
	lun_state
	if [ "$LUN_STATE" != "$LAST_STATE" ]; then
		log "ownership=$LUN_STATE"
		LAST_STATE=$LUN_STATE
	fi
	[ "$LUN_STATE" = "device-owned" ] || continue

	SNAP_IMG="/tmp/boot-snap.$$"
	WPA_STAGE="/tmp/.bootsync-wpa.$$"
	CFG_STAGE="/tmp/.bootsync-config.$$"
	rm -f "$SNAP_IMG" "$WPA_STAGE" "$CFG_STAGE"

	if ! cp -f "$BOOT_IMG" "$SNAP_IMG" 2>/dev/null; then
		log "ERROR: snapshot copy failed"
		reattach
		continue
	fi
	lun_state
	if [ "$LUN_STATE" != "device-owned" ]; then
		log "ERROR: ownership changed during snapshot"
		rm -f "$SNAP_IMG"
		continue
	fi

	IMG_SIZE=$(wc -c < "$SNAP_IMG" 2>/dev/null || echo 0)
	if [ "$IMG_SIZE" -ne 262144 ]; then
		log "ERROR: rejected boot image size=$IMG_SIZE (expected 262144)"
		rm -f "$SNAP_IMG"
		reattach
		continue
	fi
	if ! boot_hash "$SNAP_IMG"; then
		log "ERROR: could not hash snapshot"
		rm -f "$SNAP_IMG"
		reattach
		continue
	fi
	NEW_HASH=$HASH

	if ! mount -t vfat -o ro,loop "$SNAP_IMG" "$MNT_POINT" 2>/dev/null; then
		log "ERROR: rejected invalid FAT snapshot"
		rm -f "$SNAP_IMG"
		reattach
		continue
	fi

	VALID=1
	for name in wpa_supplicant.conf config.txt; do
		path="$MNT_POINT/$name"
		[ ! -e "$path" ] && continue
		size=$(wc -c < "$path" 2>/dev/null || echo 65537)
		if [ ! -f "$path" ] || [ "$size" -le 0 ] || [ "$size" -gt 65536 ]; then
			log "ERROR: rejected $name size=$size"
			VALID=0
		fi
	done
	if [ "$VALID" -eq 1 ]; then
		[ ! -f "$MNT_POINT/wpa_supplicant.conf" ] ||
			cp -f "$MNT_POINT/wpa_supplicant.conf" "$WPA_STAGE" || VALID=0
		[ ! -f "$MNT_POINT/config.txt" ] ||
			cp -f "$MNT_POINT/config.txt" "$CFG_STAGE" || VALID=0
	fi
	if ! umount "$MNT_POINT" 2>/dev/null; then
		log "ERROR: snapshot unmount failed"
		VALID=0
	fi
	if [ "$VALID" -ne 1 ]; then
		rm -f "$SNAP_IMG" "$WPA_STAGE" "$CFG_STAGE"
		reattach
		continue
	fi

	CONFIG_CHANGED=0
	if [ -f "$WPA_STAGE" ] && file_changed "$WPA_STAGE" /tmp/wpa_supplicant.conf; then
		mv -f "$WPA_STAGE" /tmp/wpa_supplicant.conf
		CONFIG_CHANGED=1
	fi
	if [ -f "$CFG_STAGE" ] && file_changed "$CFG_STAGE" /tmp/config.txt; then
		mv -f "$CFG_STAGE" /tmp/config.txt
		CONFIG_CHANGED=1
	fi
	rm -f "$WPA_STAGE" "$CFG_STAGE"

	# The helper copies and verifies the exact snapshot in PSRAM, then writes
	# a commit record last.  Boot-shim validates that record and performs the
	# A/B flash update during the next normal reboot.
	if [ -x "$BOOT_COMMIT" ] && "$BOOT_COMMIT" "$SNAP_IMG"; then
		log "Validated snapshot staged for durable A/B commit hash=$NEW_HASH"
	else
		log "ERROR: durable boot-image staging failed; no reboot commit requested"
		rm -f "$SNAP_IMG"
		reattach
		continue
	fi
	rm -f "$SNAP_IMG"
	echo "$NEW_HASH" > "$LAST_HASH_FILE"

	if ! reattach; then
		continue
	fi
	LAST_STATE="host-owned"
	if [ "$CONFIG_CHANGED" -eq 1 ]; then
		log "Configuration changed; reloading network"
		/etc/init.d/S40network reload >/dev/null 2>&1 &
	else
		log "Validated snapshot contained no configuration change"
	fi
done
