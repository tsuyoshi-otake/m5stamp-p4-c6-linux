# M3-lab diagnostic extras on top of the M3 Dropbear profile.
#
# Applied only by build-m1.sh --profile m3-lab.  Production m3 must not
# inherit tcpdump or the Dropbear client; those are bring-up tools for
# separating AP isolation, hosted RX stop, and SSH listen/auth.
BR2_PACKAGE_LIBPCAP=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
