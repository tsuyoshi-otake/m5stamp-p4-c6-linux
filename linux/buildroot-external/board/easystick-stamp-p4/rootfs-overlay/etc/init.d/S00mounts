#!/bin/sh
# Mount the pseudo-filesystems required by networking, modules and diagnostics.
# Buildroot's minimal NOMMU image does not run mount-all automatically.
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true
exit 0
