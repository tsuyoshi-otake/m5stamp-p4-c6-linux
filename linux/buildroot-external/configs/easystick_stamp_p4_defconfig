BR2_riscv=y
BR2_RISCV_32=y
# Select the custom ISA choice so Buildroot does not imply the G (IMAFD)
# profile.  The P4 HP core has RV32IMAC only.
# BR2_riscv_g is not set
BR2_riscv_custom=y
# ESP32-P4 HP core exposes RV32IMAC; it has no F/D floating-point unit.
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y
# BR2_RISCV_ISA_RVF is not set
# BR2_RISCV_ISA_RVD is not set
BR2_RISCV_ABI_ILP32=y
# BR2_RISCV_USE_MMU is not set
BR2_BINFMT_FLAT=y
# Buildroot 2025.02.15 has no 6.18 header-series choice.  The locked
# Linux 6.18.35 tree is newer than 6.12, and the header check is intentionally
# loose for custom kernel headers.
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_TOOLCHAIN_BUILDROOT=y
# Keep the compiler cache opt-in by location: callers can set
# EASYSTICK_CCACHE_DIR to a persistent host/container path.  The cache is
# never part of the repository or a flash image.
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=5G"
BR2_TARGET_GENERIC_HOSTNAME="easystick-stamp-p4"
BR2_TARGET_GENERIC_ISSUE="EasyStick Stamp-P4 M1 NOMMU Linux"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_READ_ONLY=y
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/board/easystick-stamp-p4/busybox.fragment"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/board/easystick-stamp-p4/rootfs-overlay"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/board/easystick-stamp-p4/users.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/board/easystick-stamp-p4/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/board/easystick-stamp-p4/post-image.sh"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_DROPBEAR_SMALL=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.35"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_EASYSTICK_STAMP_P4_PATH)/../linux.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="espressif/easystick-stamp-p4"
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
