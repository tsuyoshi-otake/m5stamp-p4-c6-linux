# Merged over allnoconfig, then resolved with oldconfig.  Base settings match
# busybox-daemons; the only applet is su, installed setuid root (#37).  No
# syslog: FEATURE_SU_SYSLOG would need CONFIG_FEATURE_SYSLOG plumbing for a
# single audit line, and failed su is already loud on the tty.
CONFIG_LONG_OPTS=y
CONFIG_LFS=y
CONFIG_TIME64=y
CONFIG_PID_FILE_PATH=""
CONFIG_STATIC=y
CONFIG_NOMMU=y
CONFIG_STATIC_LIBGCC=y
CONFIG_NO_DEBUG_LIB=y
# No shell: su execs the target user's shell (/bin/sh from the main BusyBox).
# CONFIG_SH_IS_ASH is not set
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_NONE=y
# CONFIG_SHELL_HUSH is not set
# CONFIG_SHELL_ASH is not set
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_MONOTONIC_SYSCALL=y
# The binary runs setuid root; without FEATURE_SUID BusyBox refuses to run
# suid applets (bb_suid drops or errors out).
CONFIG_FEATURE_SUID=y
CONFIG_SU=y
# Read /etc/shadow (the runtime copy with root_password=) through uClibc and
# check the $6$ hash with BusyBox's crypt, as the main BusyBox does.
CONFIG_FEATURE_SHADOWPASSWDS=y
# CONFIG_USE_BB_PWD_GRP is not set
# CONFIG_USE_BB_SHADOW is not set
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
# /etc/shells is not shipped in this image; with CHECKS_SHELLS su would
# refuse every target user whose shell is not listed there.
# CONFIG_FEATURE_SU_CHECKS_SHELLS is not set
# CONFIG_FEATURE_SU_SYSLOG is not set
