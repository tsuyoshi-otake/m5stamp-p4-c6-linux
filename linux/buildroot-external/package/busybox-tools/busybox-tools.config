# Merged over allnoconfig, then resolved with oldconfig.  Base settings match
# busybox-daemons; the applets are the everyday commands the main m3-lab
# BusyBox leaves out to stay under the 512 KB NOMMU allocation (#23).
CONFIG_DESKTOP=y
CONFIG_LONG_OPTS=y
CONFIG_LFS=y
CONFIG_TIME64=y
CONFIG_FEATURE_SYSLOG=y
CONFIG_STATIC=y
CONFIG_NOMMU=y
CONFIG_STATIC_LIBGCC=y
CONFIG_NO_DEBUG_LIB=y
# No shell: these run from the main BusyBox's ash.
# CONFIG_SH_IS_ASH is not set
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_NONE=y
# CONFIG_SHELL_HUSH is not set
# CONFIG_SHELL_ASH is not set
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_MONOTONIC_SYSCALL=y

# Processes and system state
CONFIG_FREE=y
CONFIG_TOP=y
CONFIG_FEATURE_TOP_INTERACTIVE=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_TOP_CPU_GLOBAL_PERCENTS=y
CONFIG_FEATURE_TOP_SMP_CPU=y
CONFIG_FEATURE_TOPMEM=y
CONFIG_UPTIME=y
# Login records (#37): Dropbear writes /var/run/utmp and /var/log/wtmp,
# created by S05.  who, w and users read utmp, last reads wtmp, and uptime
# counts the users.
CONFIG_FEATURE_UTMP=y
CONFIG_FEATURE_WTMP=y
CONFIG_FEATURE_UPTIME_UTMP_SUPPORT=y
CONFIG_WHO=y
CONFIG_W=y
CONFIG_USERS=y
CONFIG_LAST=y
CONFIG_FEATURE_LAST_FANCY=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_PIDOF=y
CONFIG_IOSTAT=y
CONFIG_MPSTAT=y
CONFIG_NMETER=y
CONFIG_NPROC=y
CONFIG_WATCH=y
CONFIG_TIMEOUT=y
CONFIG_TIME=y
# chpst starts the USB drive's main.py/main.sh/main as m5.
CONFIG_CHPST=y
CONFIG_LSOF=y
CONFIG_WHOAMI=y
CONFIG_GROUPS=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FEATURE_STAT_FILESYSTEM=y
CONFIG_CLEAR=y
CONFIG_RESET=y
CONFIG_STTY=y
CONFIG_LOGGER=y
CONFIG_LSUSB=y
CONFIG_BLKID=y
CONFIG_CAL=y
CONFIG_FACTOR=y
CONFIG_BC=y
CONFIG_DC=y

# Text
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_FEATURE_AWK_GNU_EXTENSIONS=y
CONFIG_LESS=y
CONFIG_FEATURE_LESS_MAXLINES=9999999
CONFIG_FEATURE_LESS_BRACKETS=y
CONFIG_FEATURE_LESS_FLAGS=y
CONFIG_FEATURE_LESS_TRUNCATE=y
CONFIG_FEATURE_LESS_MARKS=y
CONFIG_FEATURE_LESS_REGEXP=y
CONFIG_FEATURE_LESS_WINCH=y
CONFIG_FEATURE_LESS_ASK_TERMINAL=y
CONFIG_FEATURE_LESS_DASHCMD=y
CONFIG_FEATURE_LESS_LINENUMS=y
CONFIG_FEATURE_LESS_RAW=y
CONFIG_FEATURE_LESS_ENV=y
CONFIG_DIFF=y
CONFIG_FEATURE_DIFF_LONG_OPTIONS=y
CONFIG_FEATURE_DIFF_DIR=y
CONFIG_PATCH=y
CONFIG_CMP=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_XXD=y
CONFIG_STRINGS=y
CONFIG_NL=y
CONFIG_PASTE=y
CONFIG_FOLD=y
CONFIG_TREE=y
CONFIG_DOS2UNIX=y
CONFIG_UNIX2DOS=y
CONFIG_SHA1SUM=y
CONFIG_SHA512SUM=y
CONFIG_CKSUM=y
CONFIG_TRUNCATE=y

# Archives
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_TAR_FROM=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_BZ2=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_GZIP=y
CONFIG_FEATURE_GZIP_LONG_OPTIONS=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_BUNZIP2=y
CONFIG_BZCAT=y
CONFIG_UNXZ=y
CONFIG_XZCAT=y
CONFIG_UNZIP=y
CONFIG_FEATURE_UNZIP_CDF=y

# Network
CONFIG_WGET=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_TIMEOUT=y
CONFIG_NSLOOKUP=y
CONFIG_TRACEROUTE=y
CONFIG_ARP=y
CONFIG_ARPING=y
CONFIG_TELNET=y
CONFIG_FEATURE_TELNET_TTYPE=y
CONFIG_FEATURE_TELNET_WIDTH=y
CONFIG_IP=y
CONFIG_IPADDR=y
CONFIG_IPLINK=y
CONFIG_IPROUTE=y
CONFIG_IPNEIGH=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_FEATURE_IP_NEIGH=y
