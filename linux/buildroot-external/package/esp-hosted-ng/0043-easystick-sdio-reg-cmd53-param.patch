From: EasyStick maintainers <noreply@example.invalid>
Subject: [PATCH] esp32_sdio: es_reg_cmd53 param to A/B register reads (#35)

Adds module parameter es_reg_cmd53 (default 0).  When nonzero,
esp_read_reg() uses the upstream CMD53 multi-byte read for size > 1
instead of the CMD52 byte loop from patch 0012, so the original "reads
return zeros" failure mode can be A/B-tested at runtime:

  echo 1 > /sys/module/esp32_sdio/parameters/es_reg_cmd53

The destination is pre-filled with 0xa5 so a 0x00 result proves the
slave/host really clocked zeros rather than an untouched buffer.
Reads only; esp_write_reg() stays on CMD52 either way.

---
--- a/sdio/esp_sdio_api.c
+++ b/sdio/esp_sdio_api.c
@@ -6,6 +6,7 @@
  *
  */
 #include "utils.h"
+#include <linux/moduleparam.h>
 #include <linux/mmc/sdio.h>
 #include <linux/mmc/sdio_func.h>
 #include <linux/mmc/sdio_ids.h>
@@ -13,6 +14,15 @@
 #include <linux/mmc/host.h>
 #include "esp_sdio_api.h"
 
+/* #35 debug (opt-in, default 0): when nonzero, esp_read_reg() uses the
+ * upstream CMD53 multi-byte read for size > 1 instead of the CMD52 byte
+ * loop from patch 0012, so the two paths can be A/B-compared at runtime.
+ * Writes stay on CMD52 either way. */
+static u32 es_reg_cmd53;
+module_param(es_reg_cmd53, uint, 0644);
+MODULE_PARM_DESC(es_reg_cmd53,
+		 "#35 debug: CMD53 multi-byte register reads (0=off)");
+
 static int esp_read_byte(struct esp_sdio_context *context, u32 reg, u8 *data, u8 is_lock_needed)
 {
 	struct sdio_func *func = NULL;
@@ -130,10 +140,17 @@
 	 * PACKET_LEN.  Access registers one byte at a time; the CMD53 data
 	 * path is unaffected and stays in esp_read_block().
 	 */
-	for (i = 0; i < size; i++) {
-		data[i] = sdio_readb(func, reg + i, &ret);
-		if (ret)
-			break;
+	if (es_reg_cmd53 && size > 1) {
+		/* 0xa5 sentinel: 0x00000000 output means the slave (or host
+		 * path) really clocked zeros, not an untouched buffer. */
+		memset(data, 0xa5, size);
+		ret = sdio_memcpy_fromio(func, data, reg, size);
+	} else {
+		for (i = 0; i < size; i++) {
+			data[i] = sdio_readb(func, reg + i, &ret);
+			if (ret)
+				break;
+		}
 	}
 
 	if (is_lock_needed)
