From: Stamp-P4 maintainers <noreply@example.invalid>
Subject: [PATCH] esp-hosted: retain CMD52 marker words with positive control

Keep the existing byte-wise register access path and replace the previous
single last-value observer with six independent retention words:

  word0 = MARKER_MAGIC
  word1 = ARMED
  word2 = TOKEN_ENTER
  word3 = AFTER_46
  word4 = BEFORE_47
  word5 = AFTER_47

The Linux-side arm writes MARKER_MAGIC and ARMED before registering the SDIO
driver, so a controlled reset can validate the store and retention path before
an SSH reproduction.  The four CMD52 stages are written only for the
TOKEN_RDATA 4-byte predicate.  No printk, allocation, lock, timestamp, retry,
or return-value change is introduced.

--- a/sdio/esp_sdio_api.h
+++ b/sdio/esp_sdio_api.h
@@ -13,5 +13,6 @@
 int esp_read_block(struct esp_sdio_context *context, u32 reg, u8 *data, u16 size, u8 is_lock_needed);
 int esp_write_reg(struct esp_sdio_context *context, u32 reg, u8 *data, u16 size, u8 is_lock_needed);
 int esp_write_block(struct esp_sdio_context *context, u32 reg, u8 *data, u16 size, u8 is_lock_needed);
+void cmd52_marker_arm(void);
 
 #endif
--- a/sdio/esp_sdio_api.c
+++ b/sdio/esp_sdio_api.c
@@ -6,6 +6,7 @@
  *
  */
 #include "utils.h"
+#include <linux/kernel.h>
 #include <linux/mmc/sdio.h>
 #include <linux/mmc/sdio_func.h>
 #include <linux/mmc/sdio_ids.h>
@@ -105,21 +106,59 @@
 	return ret;
 }
 
+/* Stamp-P4: six independent non-console words for the CMD52 shot. */
+#define CMD53_BB_PA		0xBBDEAD01u
+#define CMD52_MARKER_OFFSET	0x120u
+#define CMD52_MARKER_WORDS	6u
+#define CMD52_MARKER_EMPTY	0u
+#define CMD52_MARKER_MAGIC	0x45534d30u /* 'ESM0' */
+#define CMD52_MARKER_ARMED	0x45534d31u /* 'ESM1' */
+#define CMD52_MARKER_TOKEN_ENTER	0x45534d32u /* 'ESM2' */
+#define CMD52_MARKER_AFTER_46	0x45534d33u /* 'ESM3' */
+#define CMD52_MARKER_BEFORE_47	0x45534d34u /* 'ESM4' */
+#define CMD52_MARKER_AFTER_47	0x45534d35u /* 'ESM5' */
+
+static __always_inline void cmd52_marker_store_word(u32 word, u32 value)
+{
+	WRITE_ONCE(*(volatile u32 *)(unsigned long)
+		   (CMD53_BB_PA + CMD52_MARKER_OFFSET +
+		    word * sizeof(u32)),
+		   value);
+}
+
+void cmd52_marker_arm(void)
+{
+	cmd52_marker_store_word(0u, CMD52_MARKER_MAGIC);
+	cmd52_marker_store_word(1u, CMD52_MARKER_ARMED);
+	wmb();
+}
+
+static __always_inline bool cmd52_marker_target(u32 reg, u16 size)
+{
+	return reg == (ESP_SLAVE_TOKEN_RDATA & ESP_ADDRESS_MASK) &&
+	       size == sizeof(u32);
+}
+
 int esp_read_reg(struct esp_sdio_context *context, u32 reg, u8 *data, u16 size, u8 is_lock_needed)
 {
 	struct sdio_func *func = NULL;
 	int ret = 0;
 	u16 i;
+	bool marker_target;
 
 	/* Need to apply address mask when reading/writing slave registers */
 	reg &= ESP_ADDRESS_MASK;
-
-	if (!context || !context->func || !data) {
-		esp_err("Invalid or incomplete arguments!\n");
-		return -1;
-	}
-
-	func = context->func;
+	marker_target = cmd52_marker_target(reg, size);
+
+	if (!context || !context->func || !data) {
+		esp_err("Invalid or incomplete arguments!\n");
+		return -1;
+	}
+
+	func = context->func;
+
+	if (marker_target)
+		cmd52_marker_store_word(2u, CMD52_MARKER_TOKEN_ENTER);
 
 	if (is_lock_needed)
 		sdio_claim_host(func);
@@ -131,7 +168,13 @@
 	 * path is unaffected and stays in esp_read_block().
 	 */
 	for (i = 0; i < size; i++) {
+		if (marker_target && i == 3u)
+			cmd52_marker_store_word(4u, CMD52_MARKER_BEFORE_47);
 		data[i] = sdio_readb(func, reg + i, &ret);
+		if (marker_target && i == 2u)
+			cmd52_marker_store_word(3u, CMD52_MARKER_AFTER_46);
+		if (marker_target && i == 3u)
+			cmd52_marker_store_word(5u, CMD52_MARKER_AFTER_47);
 		if (ret)
 			break;
 	}
--- a/sdio/esp_sdio.c
+++ b/sdio/esp_sdio.c
@@ -909,5 +909,7 @@
 	esp_h2c_obs_proc_create();
 
+	cmd52_marker_arm();
+
 	return sdio_register_driver(&esp_sdio_driver);
 }
 
