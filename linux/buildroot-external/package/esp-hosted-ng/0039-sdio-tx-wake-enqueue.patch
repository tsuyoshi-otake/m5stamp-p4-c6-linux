From: Stamp-P4 maintainers <noreply@example.invalid>
Subject: [PATCH] esp32_sdio: wake the TX thread on enqueue (#43)

When the queues are empty the TX thread polls once every two jiffies;
at HZ=250 that adds up to 8 ms (10-20 ms in the worst case) between an
enqueue and the thread noticing, measured on the board as the stamp ->
written step of the #43 probe.  Wake it on enqueue instead: the thread
marks itself idle, sets TASK_IDLE (whose store barrier orders the flag
before the queue re-check), re-checks all three queue_items[] and then
schedule_timeout()s; the writer bumps the queue, barriers, and calls
wake_up_process() when the flag is set.  The timeout stays, so a missed
wakeup costs at most the same two jiffies as before.  The pacing
usleep_range() is untouched.

---
--- a/sdio/esp_sdio.c
+++ b/sdio/esp_sdio.c
@@ -45,6 +45,7 @@
 static atomic_t tx_pending;
 static atomic_t queue_items[MAX_PRIORITY_QUEUES];
 struct task_struct *tx_thread;
+static bool tx_idle;
 volatile u8 host_sleep;
 
 #define H2C_OBS_MAGIC		0x0B22u
@@ -998,6 +999,9 @@
 
 	atomic_inc(&queue_items[prio]);
 	skb_queue_tail(&(sdio_context.tx_q[prio]), skb);
+	smp_mb__after_atomic();
+	if (READ_ONCE(tx_idle) && tx_thread)
+		wake_up_process(tx_thread);
 
 	return 0;
 }
@@ -1099,7 +1103,14 @@
 					atomic_read(&queue_items[PRIO_Q_HIGH]),
 					atomic_read(&queue_items[PRIO_Q_MID]),
 					atomic_read(&queue_items[PRIO_Q_LOW])); */
-			schedule_timeout_idle(msecs_to_jiffies(1) + 1);
+			WRITE_ONCE(tx_idle, 1);
+			set_current_state(TASK_IDLE);
+			if (!(atomic_read(&queue_items[PRIO_Q_HIGH]) ||
+			      atomic_read(&queue_items[PRIO_Q_MID]) ||
+			      atomic_read(&queue_items[PRIO_Q_LOW])))
+				schedule_timeout(msecs_to_jiffies(1) + 1);
+			__set_current_state(TASK_RUNNING);
+			WRITE_ONCE(tx_idle, 0);
 			continue;
 		}
 
