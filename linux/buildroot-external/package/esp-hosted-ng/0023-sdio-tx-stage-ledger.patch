 	int ret;
@@ -94,13 +96,20 @@
 
 	func = context->func;
 
+	/* EasyStick 0023-A: sport22-only CLAIM/MEMCPY via caller ctx (tr). */
+	if (tr)
+		es_tx_mark_cmd53("CMD53_CLAIM_ENTER", tr, 0, 0);
 	if (is_lock_needed)
 		sdio_claim_host(func);
-
+	if (tr)
+		es_tx_mark_cmd53("CMD53_MEMCPY_ENTER", tr, 0, 0);
 	ret = sdio_memcpy_toio(func, reg, data, size);
-
+	if (tr)
+		es_tx_mark_cmd53("CMD53_MEMCPY_DONE", tr, 1, ret);
 	if (is_lock_needed)
 		sdio_release_host(func);
+	if (tr)
+		es_tx_mark_cmd53("CMD53_CLAIM_LEAVE", tr, 1, ret);
 
 	return ret;
 }
@@ -188,12 +197,13 @@
 	return ret;
 }
 
-int esp_write_block(struct esp_sdio_context *context, u32 reg, u8 *data, u16 size, u8 is_lock_needed)
+int esp_write_block(struct esp_sdio_context *context, u32 reg, u8 *data, u16 size, u8 is_lock_needed,
+		    const struct es_tx_cmd53_ctx *tr)
 {
 	if (size <= 1) {
 		return esp_write_byte(context, reg, *data, is_lock_needed);
 	} else {
-		return esp_write_multi_byte(context, reg, data, size, is_lock_needed);
+		return esp_write_multi_byte(context, reg, data, size, is_lock_needed, tr);
 	}
 }
 
