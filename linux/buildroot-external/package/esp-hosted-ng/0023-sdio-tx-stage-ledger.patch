+			es_tx_mark("NETDEV_XMIT", &txid, "STOP_DATA");
 		dev_kfree_skb_any(skb);
 		priv->stats.tx_dropped++;
 	}
@@ -462,6 +471,8 @@
 {
 	struct esp_wifi_device *priv = NULL;
 	struct esp_skb_cb *cb = NULL;
+	struct es_tx_id txid;
+	int ssh_payload = 0;
 
 	if (!skb || !ndev)
 		return NETDEV_TX_OK;
@@ -472,7 +483,11 @@
 		return NETDEV_TX_OK;
 	}
 
+	ssh_payload = es_tx_parse_skb(skb, 0, &txid);
+
 	if (!priv->port_open) {
+		if (ssh_payload)
+			es_tx_mark("NETDEV_XMIT", &txid, "PORT_CLOSED");
 		priv->stats.tx_dropped++;
 		esp_verbose("Port not yet open\n");
 		dev_kfree_skb(skb);
@@ -480,12 +495,17 @@
 	}
 
 	if (!skb->len || (skb->len > ETH_FRAME_LEN)) {
+		if (ssh_payload)
+			es_tx_mark("NETDEV_XMIT", &txid, "INVALID_LENGTH");
 		esp_err("Bad len %d\n", skb->len);
 		priv->stats.tx_dropped++;
 		dev_kfree_skb(skb);
 		return NETDEV_TX_OK;
 	}
 
+	if (ssh_payload)
+		es_tx_mark("NETDEV_XMIT", &txid, NULL);
+
 	cb = (struct esp_skb_cb *) skb->cb;
 	cb->priv = priv;
 
