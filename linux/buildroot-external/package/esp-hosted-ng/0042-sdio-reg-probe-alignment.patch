From: Stamp-P4 maintainers <noreply@example.invalid>
Subject: [PATCH] esp32_sdio: extend #35 probe - alignment vs length bits

Extends the es_reg_probe battery (patch 0041) with four tests that
deconflate the "32B unaligned read returned the first word repeated"
observation:

  0x100 c53a32  memcpy_fromio 32B into an aligned buffer
                (isolates transfer length from buffer alignment)
  0x200 c53a30  memcpy_fromio 30B into an aligned buffer
                (non-word length)
  0x400 c53u4   memcpy_fromio 4B into buf+1 (unaligned, short)
  0x800 c53u16  memcpy_fromio 16B into buf+1 (unaligned; same length
                as the working 0x10 case, so alignment alone differs)

The destination prefill already distinguishes "slave sent zeros" from
"host moved nothing"; this also makes the log line print all read
bytes (up to 32) instead of truncating at 16.

With espressif,force-pio in the DT every transfer takes the dw_mmc
PIO path; the buffer alignment only selects between the aligned and
bounce branches of dw_mci_pull_data*().

---
--- a/sdio/esp_sdio.c
+++ b/sdio/esp_sdio.c
@@ -1511,6 +1511,16 @@
  *   0x20  c53blk      block mode: blksize 4, memcpy_fromio 8B (restored after)
  *   0x40  c53addr17   memcpy_fromio at the 17-bit unmasked window address
  *   0x80  c53pio_32   memcpy_fromio 32B into an unaligned buffer (forces PIO)
+ *   0x100 c53a32      memcpy_fromio 32B into an aligned buffer
+ *   0x200 c53a30      memcpy_fromio 30B into an aligned buffer
+ *                     (non-word length -> PIO bounce even if DMA allowed)
+ *   0x400 c53u4       memcpy_fromio 4B into buf+1 (unaligned, short)
+ *   0x800 c53u16      memcpy_fromio 16B into buf+1 (unaligned, same len
+ *                     as the working 0x10 case: isolates alignment)
+ *
+ * Note: with espressif,force-pio in the DT every transfer takes the PIO
+ * path; the aligned/unaligned choice only selects the aligned or bounce
+ * branch of dw_mci_pull_data*.
  *
  * es_reg_addr selects the window register (default 0x6c = SCRATCH_REG_0;
  * 0x44 TOKEN_RDATA, 0x58 INT_ST, 0x60 PACKET_LEN are read-only choices).
@@ -1541,14 +1551,14 @@
 		break;
 	}
 	pr_info("esp32_sdio: ES_REGPROBE: %-10s addr=0x%05x len=%d ret=%d data=%*phN\n",
-		 tag, addr, len, ret, len > 16 ? 16 : len, buf);
+		 tag, addr, len, ret, len > 32 ? 32 : len, buf);
 }
 
 static void es_run_reg_probe(void)
 {
 	struct sdio_func *func = es_probe_func;
 	u32 reg = es_reg_addr & ESP_ADDRESS_MASK;
-	u8 buf[40];
+	u8 buf[48] __aligned(8);
 	u8 wpat[4];
 	u32 old_blksz;
 	int ret = 0, i;
@@ -1599,6 +1609,14 @@
 		es_probe_rd("c53addr17", (reg | 0x15000) & 0x1ffff, buf, 4, 1);
 	if (es_reg_probe & 0x80)
 		es_probe_rd("c53pio_32", reg & ~0xf, buf + 1, 32, 1);
+	if (es_reg_probe & 0x100)
+		es_probe_rd("c53a32", reg & ~0xf, buf, 32, 1);
+	if (es_reg_probe & 0x200)
+		es_probe_rd("c53a30", reg & ~0xf, buf, 30, 1);
+	if (es_reg_probe & 0x400)
+		es_probe_rd("c53u4", reg, buf + 1, 4, 1);
+	if (es_reg_probe & 0x800)
+		es_probe_rd("c53u16", reg & ~0xf, buf + 1, 16, 1);
 
 	sdio_release_host(func);
 }
