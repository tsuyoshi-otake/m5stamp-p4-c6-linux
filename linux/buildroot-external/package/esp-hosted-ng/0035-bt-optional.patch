From: Stamp-P4 maintainers <noreply@example.invalid>
Subject: [PATCH] host: build without CONFIG_BT

0007 never creates an HCI device, so the Bluetooth core was built into the
kernel only to resolve esp_bt.o's symbols (~370 KB of kernel text, #29).
Leave esp_bt.o out when the kernel has no Bluetooth and stub its entry
points; the HCI receive branch folds away.  With CONFIG_BT=y nothing changes.

---
--- a/Makefile
+++ b/Makefile
@@ -40,7 +40,10 @@
 endif
 
 # Common source files
-module_objects += esp_bt.o main.o esp_cmd.o esp_utils.o esp_cfg80211.o esp_stats.o esp_debugfs.o esp_log.o
+ifneq ($(CONFIG_BT),)
+    module_objects += esp_bt.o
+endif
+module_objects += main.o esp_cmd.o esp_utils.o esp_cfg80211.o esp_stats.o esp_debugfs.o esp_log.o
 CFLAGS_esp_log.o = -DDEBUG
 
 # Module build rules
--- a/include/esp_bt_api.h
+++ b/include/esp_bt_api.h
@@ -28,9 +28,17 @@
 	#endif
 #endif
 
+#if IS_ENABLED(CONFIG_BT)
 int esp_init_bt(struct esp_adapter *adapter);
 int esp_deinit_bt(struct esp_adapter *adapter);
 void esp_hci_update_tx_counter(struct hci_dev *hdev, u8 pkt_type, size_t len);
 void esp_hci_update_rx_counter(struct hci_dev *hdev, u8 pkt_type, size_t len);
+#else
+/* Kernel without Bluetooth: no HCI device is ever created. */
+static inline int esp_init_bt(struct esp_adapter *adapter) { return 0; }
+static inline int esp_deinit_bt(struct esp_adapter *adapter) { return 0; }
+static inline void esp_hci_update_tx_counter(struct hci_dev *hdev, u8 pkt_type, size_t len) { }
+static inline void esp_hci_update_rx_counter(struct hci_dev *hdev, u8 pkt_type, size_t len) { }
+#endif
 
 #endif
--- a/main.c
+++ b/main.c
@@ -848,7 +848,8 @@
 		}
 
 	} else if (payload_header->if_type == ESP_HCI_IF) {
-		if (hdev) {
+		/* Folds away without CONFIG_BT: hci_recv_frame() is not built. */
+		if (IS_ENABLED(CONFIG_BT) && hdev) {
 
 			type = skb->data;
 			hci_skb_pkt_type(skb) = *type;
