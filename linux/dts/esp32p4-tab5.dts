// SPDX-License-Identifier: GPL-2.0-only
/*
 * M5Stack Tab5 — WIP Linux board description (phase-1 port of the Stamp-P4
 * project; see board-contract.json for the measured hardware facts).
 *
 * One HP hart, UART0 fallback, the P4 CLIC/SYSTIMER pair, the read-only
 * flash window populated by the ESP-IDF boot shim, and the SDMMC Slot 1
 * carrying the on-board ESP32-C6 over the GPIO matrix
 * (CLK=12 CMD=13 D0-3={11,10,9,8}; C6 reset = GPIO15; C6 power =
 * IO-expander 0x44 P0, driven by the boot shim).
 *
 * UART0 remains the deterministic fixture fallback (M5-Bus TXD0/RXD0 =
 * GPIO37/38).  The module USB-C USB-Serial/JTAG controller is exposed as
 * ttyGS1 by the board-local ACM driver; it is a device-mode console and
 * never a USB host/VBUS source.
 */
/dts-v1/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "M5Stack Tab5";
	compatible = "m5stack,tab5", "espressif,esp32p4";

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <16000000>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			reg = <0>;
			riscv,isa = "rv32imafc";
			mmu-type = "riscv,none";
			status = "okay";

			CPU0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};
	};

	memory@48000000 {
		device_type = "memory";
		reg = <0x48000000 0x02000000>;
	};

	xtal_clk: xtal-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
		clock-output-names = "xtal";
	};

	aliases {
		serial0 = &uart0;
		serial1 = &usb_serial_jtag;
	};

	chosen {
		/*
		 * Keep early USB-JTAG output during probe, then hand the console
		 * to the board-local ACM driver as ttyGS1, as on the Stamp build.
		 * console=tty0 comes first so ttyGS1 stays /dev/console (the last
		 * console= wins) while kernel messages also reach the panel through
		 * fbcon.  consoleblank=0: the framebuffer has no blank op, so fbcon
		 * would just paint the panel black after 10 minutes and the device
		 * would look dead.  fbcon=font:TER16x32: the 8x16 default makes
		 * 90 x 80 cells on 720x1280, too small to read; the 16x32 font
		 * (45 x 40) must be named because fbcon prefers 8x16 by default.
		 * fbcon=rotate:3 draws the console 90 deg CCW -- the keyboard
		 * dock holds the panel in landscape, so an 80 x 22 cell
		 * console reads upright (the ST712x MADCTL only mirrors; the
		 * 90 deg turn has to be done in fbcon, the panel cannot).
		 */
		bootargs = "earlycon=esp32p4usbjtag,mmio32,0x500d2000 console=tty0 console=ttyGS1,115200n8 loglevel=4 consoleblank=0 fbcon=font:TER16x32 fbcon=rotate:3 root=/dev/mtdblock0 rootfstype=squashfs ro init=/sbin/init maxcpus=1";
	};

	/*
	 * Framebuffer handed over by the boot shim.  "reserved-fb" is not an
	 * upstream status value: the node is inert (not "okay") until the
	 * shim, after a successful DSI bring-up, rewrites the string to
	 * "okay" in place and patches the 0xdfb00000 reg placeholder with
	 * the real PSRAM framebuffer address.  On a display failure the
	 * node stays disabled and Linux boots headless.
	 * espressif,flush-cache marks that the CPU-side console writes need
	 * a dcache writeback before the DW-GDMA reader sees them; consumed
	 * by the optional simplefb patch under linux/tab5/.
	 */
	framebuffer0: framebuffer@dfb0000 {
		compatible = "simple-framebuffer";
		reg = <0x0dfb0000 0x001c2000>;
		width = <720>;
		height = <1280>;
		stride = <1440>;
		format = "r5g6b5";
		espressif,flush-cache;
		/*
		 * Period for the mmap writeback ticker: while a mapping of
		 * /dev/fb0 is alive the whole scan is republished this often,
		 * so apps that never signal a finished frame still reach the
		 * panel.  0 (or absent) disables the ticker.
		 */
		espressif,flush-interval-ms = <50>;
		/*
		 * RISC-V defaults OF devices to DMA-coherent, and the DMA core
		 * skips dma_sync_* for coherent devices -- without this the
		 * flush-cache writeback is a silent no-op and glyphs reach the
		 * panel only as cache lines happen to be evicted.
		 */
		dma-noncoherent;
		status = "reserved-fb";
	};

	/*
	 * LCD backlight through the ME2212 boost on GPIO22, driven by
	 * LEDC channel 0 at 5 kHz.  Levels map 0..1024 onto the duty;
	 * 307 = the shim's ~30% boot default so handoff is invisible.
	 * Console blanking goes through the usual backlight notifier.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&ledc 0 200000>;
		brightness-levels = <0 1024>;
		num-interpolated-steps = <1024>;
		default-brightness-level = <307>;
	};

	/*
	 * Safe poweroff: expander 0x44 P4 (PWROFF_PLUSE) is the request
	 * line into the PMS150G power controller on the always-on
	 * VDD_STBY rail.  It must be pulsed and end idle, exactly like
	 * the stock BSP's bsp_generate_poweroff_signal(): the expander's
	 * VDD (SOC_3.3V) stays alive whenever USB-C is attached, so a
	 * line left latched is still driven when the next power-button
	 * press arrives -- the PMS150G then holds BOOT_GPIO35 (its PA5,
	 * wired to the P4 strap pin) low and the SoC lands in ROM
	 * download mode until all power is removed.  Plain gpio-poweroff
	 * cannot be used: it ends its sequence asserted.
	 */
	tab5-pwroff {
		compatible = "m5stack,tab5-pwroff";
		gpios = <&exp1 4 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * Power-supply topology (#31).  The IP2326 charger's BAT_STAT
	 * lands on expander 0x44 P6 (the same line the stock BSP reads
	 * as USB-C detect): it is high while the charger is in or past
	 * constant-current charge, low in trickle charge or with no VIN,
	 * so "online" is an approximation that can blink low during the
	 * trickle phase of a real charge.
	 */
	usb: usb {
		compatible = "gpio-charger";
		charger-type = "usb-sdp";
		gpios = <&exp1 6 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * The 2S pack behind J12: voltage/current come from the INA226
	 * (io-monitor phandle), charge state from the usb supply link.
	 * CAPACITY is a linear pack-voltage estimate, not a gauge.
	 */
	battery {
		compatible = "m5stack,tab5-battery";
		io-monitor = <&ina226>;
		power-supplies = <&usb>;
	};

	soc: soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		clic0: interrupt-controller@20801000 {
			compatible = "espressif,esp32p4-clic";
			reg = <0x20801000 0x3c0>, <0x500d6000 0x200>,
			      <0x500d6800 0x200>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		systimer: timer@500e2000 {
			compatible = "espressif,esp32p4-systimer";
			reg = <0x500e2000 0x100>;
			/*
			 * Target0/source53 services CPU0; target1/source54 is the
			 * independent CPU1 clockevent. The CLIC driver maps both
			 * sources into both INTMTX banks, while the timer driver
			 * enables each parent IRQ only on its owning CPU.
			 */
			interrupts-extended = <&clic0 17 53 IRQ_TYPE_LEVEL_HIGH>,
					      <&clic0 23 54 IRQ_TYPE_LEVEL_HIGH>;
			status = "okay";
		};

		/*
		 * ESP32-P4 LP-TSENS.  The bring-up driver maps the companion
		 * LP_PERI, LP_I2C_ANA_MST, PMU, and eFuse windows because this
		 * vendor tree has no clock/reset/nvmem provider for them yet.
		 * The node is inert unless CONFIG_ESP32P4_TSENS=y is selected.
		 */
		tsens: temperature-sensor@5012f000 {
			compatible = "espressif,esp32p4-tsens";
			reg = <0x5012f000 0x2c>,
			      <0x50120000 0x1000>,
			      <0x50124000 0x40>,
			      <0x50115000 0x200>,
			      <0x5012d000 0x200>;
			reg-names = "tsens", "lpperi", "ana-mst", "pmu", "efuse";
			#thermal-sensor-cells = <0>;
			status = "okay";
		};

		uart0: serial@500ca000 {
			compatible = "esp,esp32p4-uart";
			reg = <0x500ca000 0x1000>;
			interrupts-extended = <&clic0 18 31 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal_clk>;
			status = "okay";
		};

		/*
		 * P4 USB Serial/JTAG register block.  IDF assigns interrupt source
		 * 22 (ETS_USB_SERIAL_JTAG_INTR_SOURCE); CLIC slot 19 is unused by
		 * this board.  The existing esp32_acm driver uses the same EP1
		 * register layout as P4, with the P4 compatible added by patch 0028.
		 */
		usb_serial_jtag: serial@500d2000 {
			compatible = "espressif,esp32p4-usb-serial-jtag";
			reg = <0x500d2000 0x1000>;
			interrupts-extended = <&clic0 19 22 IRQ_TYPE_LEVEL_HIGH>;
			status = "okay";
		};

		/*
		 * GPIO controller (patch 0002-gpio-esp32p4.patch): one parent
		 * owns the shared MMIO page and each child is one bank with
		 * its own gpio_chip.  Bank 0 (hw pins 0..31) is needed for the
		 * touch stack: hw GPIO23 is the ST712x INT line (a GPIO_INT0
		 * child interrupt) and hw GPIO31 is the bit-banged SDA below.
		 * Bank 0 also owns the GPIO_INT0 parent line, so its node
		 * doubles as the pin-interrupt controller.
		 *
		 * Exposing bank 0 does not revive the C6-reset hazard the
		 * phase-1 notes guarded against: the hazard was never the node
		 * itself but a Linux driver asserting GPIO15 (C6 EN/reset).
		 * Nothing in DT claims GPIO15, and esp-hosted-ng still runs
		 * with resetpin = HOST_GPIO_PIN_INVALID (its stamp-p4
		 * defaults patch), so no Linux consumer ever requests that
		 * pin; the reset pulse stays shim-owned.
		 * GPIO_INT0 is ETS source 74 (INTMTX map reg +0x128); CLIC
		 * slot 26 is free on this board.
		 */
		gpio@500e0000 {
			compatible = "espressif,esp32p4-gpio";
			reg = <0x500e0000 0x1000>;
			status = "okay";

			gpio0: bank0 {
				espressif,bank-id = <0>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupts-extended =
					<&clic0 26 74 IRQ_TYPE_LEVEL_HIGH>;
			};

			/* GPIO bank 1 (hw pins 32..56): SCL lives on hw GPIO32. */
			gpio1: bank1 {
				espressif,bank-id = <1>;
				gpio-controller;
				#gpio-cells = <2>;
			};
		};

		/*
		 * LEDC PWM: the shim routes channel 0 to GPIO22 (LCD
		 * backlight boost EN) and runs timer0 at 5 kHz/10-bit
		 * on XTAL (~30% duty).  This node registers the whole
		 * block; pwm-backlight below keeps that state until
		 * userspace changes it.
		 */
		ledc: pwm@500d3000 {
			compatible = "espressif,esp32p4-ledc";
			reg = <0x500d3000 0x1000>;
			#pwm-cells = <2>;
		};

		/*
		 * Tab5 on-board C6 SDIO.  The P4 controller's Slot 1 uses the
		 * GPIO matrix: CLK=12, CMD=13, DAT0..3={11,10,9,8}.  The boot
		 * shim powers the C6 via IO-expander 0x44 P0, pulses GPIO15,
		 * enables the raw P4 clock/reset and routes these signals before
		 * jumping to Linux; this node describes the already-running bus.
		 * `snps,slot-id` is consumed by the local dw_mmc fix because the
		 * P4 CMD register selects the physical card in bits [20:16].
		 */
		sdmmc_biu_clk: sdmmc-biu-clock {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <40000000>;
			clock-output-names = "sdmmc-biu";
		};

		/*
		 * I2S0 MCLK as programmed by the esp32-p4-i2s driver:
		 * PLL_160M / 13 = 12.307692 MHz (~256 * 48 kHz).  The
		 * es8328 driver only models the canonical MCLK rates and
		 * rejects the real value with -EINVAL, so this declares
		 * the nominal 12.288 MHz the codec's divider table
		 * targets (actual rate is +0.16 %, within its tolerance).
		 */
		es8388_mclk: es8388-mclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <12288000>;
			clock-output-names = "es8388-mclk";
		};

		sdmmc_ciu_clk: sdmmc-ciu-clock {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <40000000>;
			clock-output-names = "sdmmc-ciu";
		};

		sdmmc1: mmc@50083000 {
			compatible = "snps,dw-mshc";
			reg = <0x50083000 0x1000>;
			interrupts-extended = <&clic0 22 23 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&sdmmc_biu_clk>, <&sdmmc_ciu_clk>;
			clock-names = "biu", "ciu";
			bus-width = <4>;
			max-frequency = <40000000>;
			clock-frequency = <40000000>;
			non-removable;
			broken-cd;
			disable-wp;
			cap-sdio-irq;
			dma-noncoherent;
			espressif,force-pio;
			/* The P4 FIFO does not pop on CPU reads (#35); patches
			 * 0087/0088 send multi-word PIO transfers through IDMAC
			 * instead.
			 */
			espressif,fifo-no-pop;
			snps,slot-id = <1>;
			status = "okay";
		};

		/* MWDT0 stage-0 system reset; Linux feeds it after probe.
		 * See the Stamp DTS for the 120s reasoning; keep identical. */
		wdt0: watchdog@500c2000 {
			compatible = "espressif,esp32p4-wdt";
			reg = <0x500c2000 0x100>;
			/* CLIC slot 20 is reserved for the C68 CPU1 IPI source 80. */
			interrupts-extended = <&clic0 21 48 IRQ_TYPE_LEVEL_HIGH>;
			timeout-sec = <120>;
		};

		/*
		 * USB-A port: the USB2.0 HS DWC controller (USB_DWC_HS,
		 * 0x50000000) with its dedicated UTMI PHY pads.  The boot
		 * shim's Tab5 path enables the otg20 sys clock + 48 MHz
		 * PHY ref clock and pulses the shared otg20/PHY reset;
		 * VBUS on the connector is expander 0x44 P3 (USB5V_EN),
		 * which the boot shim leaves driven high.  dr_mode host:
		 * the port is a hardwired Type-A receptacle.  ETS_USB_OTG
		 * interrupt source is 93, routed to free CLIC slot 27.
		 * The 0063 force-PIO only names the FS core
		 * (espressif,esp32p4-otg11); this HS core runs the
		 * auto-detected internal-buffer-DMA host mode.
		 */
		usb_otg: usb@50000000 {
			compatible = "espressif,esp32p4-otg", "snps,dwc2";
			reg = <0x50000000 0x10000>;
			interrupts-extended = <&clic0 27 93 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "host";
			hnp-disable;
			srp-disable;
			/*
			 * This core is internal-DMA only (GHWCFG2.ARCH=2):
			 * no slave mode exists to force, so transfers go
			 * through the core's own DMA engine and every
			 * buffer hand-off needs dcache maintenance --
			 * without dma-noncoherent the engine reads stale
			 * setup/data and enumeration dies with -32/-71.
			 */
			dma-noncoherent;
			status = "okay";
		};

		/*
		 * Full-Speed USB OTG (DWC2) is disabled on Tab5: its internal
		 * FSLS PHY is wired to GPIO26/27, which are the board's I2S
		 * audio pins -- there is no connector on this controller.
		 * (The USB-A port sits on the HS controller @0x50000000
		 * above.)
		 */
		usb_otg11: usb@50040000 {
			compatible = "espressif,esp32p4-otg11", "snps,dwc2";
			reg = <0x50040000 0x10000>;
			interrupts-extended = <&clic0 24 103 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "peripheral";
			maximum-speed = "full-speed";
			hnp-disable;
			srp-disable;
			g-rx-fifo-size = <64>;
			g-np-tx-fifo-size = <16>;
			g-tx-fifo-size = <32 20 16 16 16 16>;
			status = "disabled";
		};

		/*
		 * DW-GDMA scanout channel handed over by the boot shim.  The
		 * hardware clears the LLI valid bit in memory on every
		 * block end (there is no free-run -- the channel stalls one
		 * frame after the last re-arm), so a kernel driver re-arms
		 * it in IRQ context, the same contract ESP-IDF's trans-done
		 * callback and upstream dw-axi-dmac cyclic mode implement.
		 * DW-GDMA is ETS interrupt source 24, routed to free CLIC
		 * slot 25; the shim detaches the IDF route before the jump
		 * and the kernel's clic_domain_map installs this one.
		 *
		 * espressif,scanout-lli/-chan are patched by the boot shim
		 * (patch_scanout_node in main.c): the 64-byte link-list
		 * item lives in internal SRAM and is found by content, not
		 * by llp0 (which reads 0 while the channel runs).  The
		 * placeholder values stay when the scan-out never came
		 * up; the driver fails closed on them.
		 */
		dsi_scanout: dsi-scanout@50081000 {
			compatible = "espressif,esp32p4-dsi-scanout";
			reg = <0x50081000 0x600>;
			interrupts-extended = <&clic0 25 24 IRQ_TYPE_LEVEL_HIGH>;
			espressif,scanout-lli = <0x5ca11000>;
			espressif,scanout-chan = <0x5ca12000>;
			status = "okay";
		};

		/*
		 * I2S0 audio block.  The P4 I2S unit carries no DMA of
		 * its own: samples move through the AHB GDMA at
		 * 0x50085000 (out-ch0 for playback, in-ch1 for
		 * capture), bound by peri_sel = 3 (I2S0).  The driver
		 * also programs hp_sys_clkrst (apb gate + module
		 * clock + MCLK select), lp_clkrst (MCLK pad), and the
		 * GPIO matrix / IO_MUX for MCLK/BCK/WS/DOUT/DIN, so
		 * those blocks appear as extra reg ranges.
		 *
		 * Pins are the board I2S pair to the ES8388 codec:
		 * MCLK=GPIO30, BCK=GPIO27, WS=GPIO29, DOUT=GPIO26,
		 * DIN=GPIO28.  Speaker-amp enable and headphone-detect
		 * live on expander 0x43 P1/P7 and belong to the
		 * expander-IC driver, not here.
		 *
		 * AHB_PDMA_OUT_CH0 is ETS source 59, AHB_PDMA_IN_CH1 is
		 * 57; CLIC slots 27/28 are free on this board.
		 */
		i2s0: i2s@500c6000 {
			compatible = "espressif,esp32p4-i2s";
			reg = <0x500c6000 0x1000>, <0x50085000 0x1000>,
				<0x500e6000 0x200>, <0x50111000 0x100>,
				<0x500e0000 0x2000>;
			reg-names = "i2s", "dma", "clkrst", "lpclkrst",
				    "gpio";
			interrupts-extended =
				<&clic0 29 59 IRQ_TYPE_LEVEL_HIGH>,
				<&clic0 28 57 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "tx", "rx";
			espressif,peri-sel = <3>;
			espressif,i2s-unit = <0>;
			espressif,mclk-pin = <30>;
			espressif,bck-pin = <27>;
			espressif,ws-pin = <29>;
			espressif,dout-pin = <26>;
			espressif,din-pin = <28>;
			/* Descriptors + buffers must live in internal SRAM:
			 * AHB-GDMA cannot retire a PSRAM ring (#24/B11). */
			memory-region = <&i2s0_dma_sram>;
			#sound-dai-cells = <0>;
			status = "okay";
		};

		/* Patched at runtime by boot-shim/main.c with the flash MMU VA. */
		flash@deadbeef {
			compatible = "mtd-rom";
			reg = <0xdeadbeef 0xcafefade>;
			bank-width = <4>;
		};
	};

	/*
	 * Internal I2C bus, bit-banged: this kernel tree has no P4 I2C
	 * controller driver, so i2c-gpio drives the bus the stock
	 * image puts on SDA=GPIO31 (bank 0) / SCL=GPIO32 (bank 1).
	 * The boot shim releases the IDF I2C master and returns both
	 * pads to plain GPIO before the jump (tab5_i2c_release), so
	 * this driver finds clean inputs to toggle.  Both lines are
	 * declared GPIO_OPEN_DRAIN: the esp32p4 gpiochip has no
	 * hardware open-drain set_config, so gpiolib emulates it by
	 * direction toggling -- exactly the drive pattern i2c-gpio
	 * wants, and the named sda/scl props replace the deprecated
	 * 'gpios' form.  ~100 kHz like the stock touch transactions.
	 *
	 * Other chips live on this bus too (codec, RTC, fuel gauge,
	 * IMU, power monitor).  The two expanders are shim-programmed
	 * rails claimed below: their driver writes nothing at probe,
	 * so the shim state survives, and direction changes belong to
	 * consumers, never to gpio-hogs.  The node sits at root
	 * level: i2c-gpio is a software adapter with no register
	 * window, not an soc unit.
	 */
	i2c0: i2c-gpio {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sda-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio1 0 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		status = "okay";

		/*
		 * ST7121/ST7123-family touch controller (Sitronix).
		 * INT is open-drain active-low on GPIO23 with the
		 * shim leaving a pull-up; the chip pulses it low per
		 * touch report like the stock NEGEDGE setup.
		 * TP_RST is expander 0x43 P5 -- not modelled; the shim
		 * keeps it released and the driver never resets.
		 */
		touch@55 {
			compatible = "sitronix,st7123";
			reg = <0x55>;
			interrupts-extended =
				<&gpio0 23 IRQ_TYPE_EDGE_FALLING>;
			touchscreen-size-x = <720>;
			touchscreen-size-y = <1280>;
			/*
			 * No transform: the controller reports raw
			 * 720x1280 portrait axes that already match the
			 * fb pixel layout.  The earlier swapped-x-y and
			 * inverted-x entries were both measured wrong
			 * (#33): five-corner evdev taps on the
			 * inverted-x build showed a mirrored +x with
			 * scale ~1, i.e. the raw stream was correct.
			 * Spec-confirmed against the M5Stack BSP
			 * (M5Tab5-UserDemo m5stack_tab5.c): x_max=720,
			 * y_max=1280 and swap_xy/mirror_x/mirror_y all
			 * 0 for ST7121/ST7123 and GT911 alike, so no
			 * calibration data is needed either (#33).
			 */
			status = "okay";
		};

		/*
		 * PI4IOE5V6408 8-bit expanders; line names from
		 * board-contract.json.  The shim owns their
		 * reset/pull/direction/output programming (C6 rail,
		 * USB-A 5 V, TP/LCD reset release, charger enables);
		 * the driver registers the chips without writing at
		 * probe, and no gpio-hogs may sit here because a hog
		 * would reprogram direction at bind time -- 0x44 P0
		 * is the C6 rail and dropping it kills Wi-Fi.
		 */
		exp0: gpio@43 {
			compatible = "diodes,pi4ioe5v6408";
			reg = <0x43>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-line-names =
				"EXT_ANT_EN", "SPK_EN", "EXT5V_EN", "RESERVED_P3",
				"LCD_RST", "TP_RST", "CAM_RST", "HP_DET";
		};

		exp1: gpio@44 {
			compatible = "diodes,pi4ioe5v6408";
			reg = <0x44>;
			gpio-controller;
			#gpio-cells = <2>;
			/* Schematic U7: P1/P2 are unconnected (the earlier
			 * PWR_GOOD/CHG_STA names were guesses); P6 is the
			 * IP2326 BAT_STAT line, not a separate USB-detect. */
			gpio-line-names =
				"WLAN_PWR_EN", "", "", "USB5V_EN",
				"PWROFF_PLUSE", "nCHG_QC_EN", "CHG_STAT", "CHG_EN";
		};

		/*
		 * Bosch BMI270 6-axis IMU; INT1/INT2 routing to P4 is
		 * unconfirmed so no interrupts property -- polled
		 * data only.  Probe uploads the Bosch init blob from
		 * /lib/firmware/bmi270-init-data.fw (shipped in the
		 * Tab5 rootfs overlay).
		 */
		bmi270@68 {
			compatible = "bosch,bmi270";
			reg = <0x68>;
		};

		/*
		 * RX8130CE RTC at 0x32 (the M5 docs' 0x51 is a PCF8563-
		 * family value; the datasheet slave address is 0x32).
		 * Seconds register confirmed counting on-device.  The
		 * supercap-backed clock persists across power-off; no
		 * wakeup interrupt is routed to the P4 in this design.
		 */
		rtc@32 {
			compatible = "epson,rx8130";
			reg = <0x32>;
		};

		/*
		 * INA226 power monitor on the battery rail: Tab5
		 * schematic U31 with R39 = R005 (5 mOhm, 1%).  Bus
		 * voltage = battery voltage; positive current means
		 * discharging, negative means charging.
		 */
		ina226: ina226@41 {
			compatible = "ti,ina226";
			reg = <0x41>;
			shunt-resistor = <5000>;
		};

		/*
		 * Alternate-panel SKU: GT911 touch controller at 0x5d,
		 * paired with the ILI9881C display.  It shares the
		 * ST712x wiring (INT GPIO23, TP_RST expander 0x43 P5)
		 * and is only populated on that SKU, so the node can
		 * stay enabled on this bus next to touch@55: only one
		 * of the two ever answers.  INT polarity matches the
		 * board wiring; confirm on the alternate SKU.
		 */
		gt911: touchscreen@5d {
			compatible = "goodix,gt911";
			reg = <0x5d>;
			interrupts-extended =
				<&gpio0 23 IRQ_TYPE_EDGE_FALLING>;
			touchscreen-size-x = <720>;
			touchscreen-size-y = <1280>;
			/* Same "no transform" rule as touch@55 (#33): the
			 * M5Stack BSP uses x_max=720, y_max=1280 and all-
			 * zero swap/mirror flags for GT911 too. */
			/* Disabled by default (#36): nothing sits at 0x5d
			 * on ST712x boards, and the enabled probe spams
			 * "I2C communication failure" to the console.
			 * The boot shim flips this node to okay when its
			 * panel detection finds the GT911 (ILI9881C SKU). */
			status = "disabled";
		};

		/*
		 * ES8388 stereo codec at 0x10, clocked by I2S0 MCLK.
		 * Upstream's es8328 driver claims es8388 compatibility
		 * (everest,es8388); the parts it does not model are
		 * bring-up work, not a different driver.  Its probe
		 * devm_clk_get(NULL)s the codec clock: describe the MCLK
		 * the i2s driver programs (PLL_160M/13, ~12.3 MHz) as a
		 * fixed-clock so the request resolves.
		 */
		es8388: audio-codec@10 {
			compatible = "everest,es8388";
			reg = <0x10>;
			clocks = <&es8388_mclk>;
			#sound-dai-cells = <0>;
			status = "okay";
		};

		/*
		 * ES7210 4-channel microphone ADC at 0x40 (#24/B12).
		 * The Tab5 wires only MIC1/MIC2 (on-board mics AMIC1/
		 * AMIC2); MIC3 is the headset-mic line (untested, no
		 * plug available).  The local minimal driver runs it
		 * as a plain stereo I2S ADC -- no TDM.  Shares the
		 * ES8388's MCLK.
		 */
		es7210: audio-adc@40 {
			compatible = "everest,es7210";
			reg = <0x40>;
			clocks = <&es8388_mclk>;
			#sound-dai-cells = <0>;
			status = "okay";
		};
	};

	/*
	 * Ext.Port1 keyboard bus: the A164 unit is an STM32F030C8T6
	 * matrix scanner at 0x6d on a dedicated hw GPIO0 (SDA) /
	 * GPIO1 (SCL) pair -- a bus of its own, independent of the
	 * internal bus above, so a wedge there cannot strand it.
	 * Its INT is hw GPIO50 on bank 1, which the esp32p4 gpio
	 * driver does not wire to an irq_chip, so the driver polls
	 * the chip FIFO instead of describing the line here.
	 */
	i2c1: i2c-gpio-1 {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sda-gpios = <&gpio0 0 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio0 1 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		status = "okay";

		keyboard@6d {
			compatible = "m5stack,tab5-keyboard";
			reg = <0x6d>;
			/*
			 * How bright the Aa (upper case) LED is when lit,
			 * 0..100; 20 is the keyboard's own default.  The
			 * mode LED next to it is always dark.
			 */
			m5stack,led-brightness = <20>;
			status = "okay";
		};
	};

	/*
	 * microSD slot 0 in SPI mode (#29): the slot is wired to SDMMC
	 * slot 0's dedicated pads CLK43 CMD44 D0..3=39..42, but slot 0
	 * is not reachable through the Linux dw_mmc instance (that
	 * driver models one host per controller and slot 1 carries the
	 * C6).  The pads are bit-banged via spi-esp32p4-fastbb +
	 * mmc_spi: same spi-bitbang framework as spi-gpio, but each
	 * edge is one GPIO_OUT1_W1TS/W1TC store and MISO one GPIO_IN1
	 * load instead of the gpiolib path, so the slot runs an order
	 * of magnitude faster than spi-gpio's <30 KB/s.  Card power is
	 * the on-chip LDO VO4, which the boot shim holds at 3.3 V.
	 * The slot has no card-detect pin.  spi-max-frequency is only
	 * a cap; 8 MHz stays under the card's 25 MHz SPI ceiling with
	 * margin for the MMIO bit loop.
	 */
	spi_sd: spi-esp32p4-fastbb {
		compatible = "espressif,esp32p4-fast-spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sck-gpios  = <&gpio1 11 GPIO_ACTIVE_HIGH>; /* GPIO43 CLK */
		mosi-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>; /* GPIO44 CMD */
		miso-gpios = <&gpio1  7 GPIO_ACTIVE_HIGH>; /* GPIO39 D0  */
		cs-gpios   = <&gpio1 10 GPIO_ACTIVE_LOW>;  /* GPIO42 D3  */
		num-chipselects = <1>;
		status = "okay";

		mmc-slot@0 {
			compatible = "mmc-spi-slot";
			reg = <0>;
			spi-max-frequency = <8000000>;
			voltage-ranges = <3300 3300>;
		};
	};

	/*
	 * NS4150B mono speaker amp.  Its enable is expander 0x43 P1
	 * (SPK_EN); wiring a simple-audio-amplifier node through the
	 * card's aux-devs makes DAPM drive the pin: high on playback,
	 * low again when the stream stops (#24/B12).
	 * Schematic: the amp taps the HPOUT_L net, which the OUT2 pair
	 * (LOUT2/ROUT2) drives -- verified on-device by forcing
	 * DACPOWER per pair mid-playback (OUT2 alone keeps the 1 kHz
	 * tone loud; OUT1 alone drops it to silence).
	 */
	spk_amp: audio-amplifier {
		compatible = "simple-audio-amplifier";
		sound-name-prefix = "Amp";
		enable-gpios = <&exp0 1 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * ES8388 + I2S0 link.  simple-audio-card with an aux
	 * amplifier and the headphone jack.  The jack carries the
	 * HPOUT_L/HPOUT_R nets; per the schematic extraction the
	 * OUT2 pair drives HPOUT_L and the OUT1 pair drives
	 * HPOUT_R (the net labels sit against ROUT2/ROUT1
	 * respectively), so the jack route powers all four outputs.
	 * HP_DET is expander 0x43 P7, an input that reads low with
	 * nothing plugged (measured: 0x43 reg0 = 0x00) -- the jack
	 * switch opens on insertion, so insertion pulls it high:
	 * GPIO_ACTIVE_HIGH.
	 */
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Tab5-ES8388";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&i2s0>;
		simple-audio-card,frame-master = <&i2s0>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,aux-devs = <&spk_amp>;

		simple-audio-card,widgets =
			"Speaker", "External Speaker",
			"Headphone", "Headphones";
		simple-audio-card,routing =
			"External Speaker", "Amp OUTL",
			"External Speaker", "Amp OUTR",
			"Amp INL", "LOUT2",
			"Amp INR", "ROUT2",
			"Headphones", "LOUT1",
			"Headphones", "ROUT1",
			"Headphones", "LOUT2",
			"Headphones", "ROUT2";
		simple-audio-card,hp-det-gpios = <&exp0 7 GPIO_ACTIVE_HIGH>;

		simple-audio-card,cpu {
			sound-dai = <&i2s0>;
		};
		simple-audio-card,codec {
			sound-dai = <&es8388>;
		};
	};

	/*
	 * ES7210 mic capture on the same I2S0 (RX side).  Second
	 * card so the mics get their own PCM device; I2S0's DAI
	 * already exposes a capture stream backed by the AHB IN
	 * channel and the SRAM pool.
	 */
	sound-mic {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Tab5-ES7210";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&i2s0>;
		simple-audio-card,frame-master = <&i2s0>;
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&i2s0>;
		};
		simple-audio-card,codec {
			sound-dai = <&es7210>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		/* Kept small until NOMMU pool sizing is measured on the board. */
		boot_partition_res: boot-partition-res@499c0000 {
			reg = <0x499c0000 0x00040000>;
			no-map;
		};

		/* Linux writes this last after staging a new boot image above.
		 * The boot shim consumes and clears the request before loading Linux. */
		boot_update_request_res: boot-update-request@499bf000 {
			reg = <0x499bf000 0x00001000>;
			no-map;
		};

		/* Second pool region: same layout as the Stamp image. */
		linux_nommu_pool_low: nommu-userspace-pool@495af000 {
			compatible = "linux,nommu-userspace-pool";
			reg = <0x495af000 0x00400000>;
		};

		linux_nommu_pool: nommu-userspace-pool@49a00000 {
			compatible = "linux,nommu-userspace-pool";
			reg = <0x49a00000 0x00600000>;
		};

		/*
		 * MIPI-DSI framebuffer reserved for the boot-shim display
		 * stream.  The shim rewrites this reg together with the
		 * framebuffer0 node's; the placeholder reserves only 4 KiB
		 * at a real PSRAM address so a headless boot (no panel) is
		 * unaffected.
		 */
		display_fb_res: framebuffer@49fdf000 {
			reg = <0x49fdf000 0x00001000>;
			no-map;
		};

		/* I2S0 TX/RX AHB-GDMA descriptor rings and PCM buffers must
		 * sit in internal SRAM — the engine never retires a ring
		 * placed in PSRAM (#24/B11, IDF reference dump).  Upper
		 * 192 KiB of HP SRAM; low SRAM holds shim leftovers and
		 * the dsi-scanout LLI (~0x4ff3b500). */
		i2s0_dma_sram: i2s0-dma@4ff50000 {
			compatible = "shared-dma-pool";
			reg = <0x4ff50000 0x00030000>;
			no-map;
		};
	};
};
