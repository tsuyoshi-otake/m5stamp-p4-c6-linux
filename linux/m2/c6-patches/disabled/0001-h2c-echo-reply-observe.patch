+                        s_h2c_obs.no_mem_seq_mask |= seq_bit;
+                    } else {
+                        s_h2c_obs.other_seq_mask |= seq_bit;
+                    }
+                } else {
+                    /* Non-ICMP-Echo-Reply DATA: unchanged behaviour. */
+                    esp_wifi_internal_tx(ESP_IF_WIFI_STA, payload, payload_len);
+                }
+            } else if (is_echo_rep) {
+                s_h2c_obs.drop_seq_mask |= seq_bit;
             }
 
         } else if (buf_handle->if_type == ESP_AP_IF && softap_started) {
