hush: make "set -e" follow POSIX after skipped commands, in loop
conditions and after "!"

BusyBox 1.37.0 hush is /bin/sh on these NOMMU images (ash needs an MMU).
run_list() keeps "set -e" off while G.errexit_depth is not zero, and
three bugs in how it maintains that count made scripts go on after a
failure or stop where they should not (#41):

1. A pipe raised the depth before the && / || skip test and lowered it
   only after it had run, so a skipped pipe followed by && or || left it
   raised:

	set -e; false && : || :; false; echo LEAK	# printed LEAK

   At the top level of a script that lasted to the end of the script,
   and "set +e; set -e" did not bring "set -e" back.  Each pipe now
   starts from the depth its list was entered with, and the depth is
   also restored when break, continue or return leaves the list early.

2. The condition of while and until was not exempt, so a loop that ended
   because its condition became false ended the script instead:

	set -e; while read l; do :; done <file; echo after	# no "after"
	set -e; i=0; while [ $i -lt 3 ]; do i=$((i+1)); done	# exit 1

3. "! pipe" was not exempt either: "set -e; ! true" exited.

POSIX exempts all three.  With this patch an x86 build of the board's
BusyBox configuration prints the same as dash and bash --posix for 49
test scripts (the unpatched build differed in 17), and BusyBox's own
hush testsuite has the same results with and without it.

--- a/shell/hush.c
+++ b/shell/hush.c
@@ -9790,6 +9790,7 @@
 #endif
 	smallint last_followup;
 	smalluint rcode;
+	int sv_errexit_depth;
 #if ENABLE_HUSH_IF || ENABLE_HUSH_CASE
 	smalluint cond_code = 0;
 #else
@@ -9849,11 +9850,11 @@
 #endif
 	last_followup = PIPE_SEQ;
 	rcode = G.last_exitcode;
+	sv_errexit_depth = G.errexit_depth;
 
 	/* Go through list of pipes, (maybe) executing them. */
 	for (; pi; pi = IF_HUSH_LOOPS(rword == RES_DONE ? loop_top : ) pi->next) {
 		int r;
-		int sv_errexit_depth;
 
 		if (G.flag_SIGINT)
 			break;
@@ -9864,11 +9865,21 @@
 		debug_printf_exec(": rword:%d cond_code:%d last_rword:%d\n",
 				rword, cond_code, last_rword);
 
-		sv_errexit_depth = G.errexit_depth;
+		/* Start each pipe from the depth this list was entered with:
+		 * a pipe skipped below ("false && cmd", "if false; then cmd")
+		 * leaves the loop body early and never reaches the restore at
+		 * its end, so "set -e" stayed off for the rest of the list. */
+		G.errexit_depth = sv_errexit_depth;
+		/* "set -e" does not apply to the conditions of if, elif, while
+		 * and until, to a pipe followed by && or ||, or to "! pipe" */
 		if (
 #if ENABLE_HUSH_IF
 		    rword == RES_IF || rword == RES_ELIF ||
 #endif
+#if ENABLE_HUSH_LOOPS
+		    rword == RES_WHILE || rword == RES_UNTIL ||
+#endif
+		    IF_HAS_KEYWORDS(pi->pi_inverted ||)
 		    pi->followup != PIPE_SEQ
 		) {
 			G.errexit_depth++;
@@ -10150,6 +10161,8 @@
 		}
 #endif
 	} /* for (pi) */
+	/* A "break" above can also leave the loop before the restore */
+	G.errexit_depth = sv_errexit_depth;
 
 #if ENABLE_HUSH_JOB
 	G.run_list_level--;
