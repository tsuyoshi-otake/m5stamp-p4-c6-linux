 #include "esp_hosted_mcu.h"
 
 #include <zephyr/logging/log.h>
 LOG_MODULE_REGISTER(esp_hosted_mcu_core, CONFIG_ESP_HOSTED_MCU_LOG_LEVEL);
 
 #define DT_DRV_COMPAT espressif_esp_hosted_mcu
 
+#if defined(CONFIG_ESP_HOSTED_MCU_P1_TRANSPORT_TEST)
+#define P1_MARK(fmt, ...) printk(fmt "\n", ##__VA_ARGS__)
+#endif
+
 /*
  * The active transport backend supplies its api and per-instance config;
@@ -624,6 +624,48 @@ int esp_hosted_mcu_send_frame(esp_hosted_mcu_if_type_t if_type, uint8_t if_num,
 	return ret;
 }
 
+#if defined(CONFIG_ESP_HOSTED_MCU_P1_TRANSPORT_TEST)
+/*
+ * Exercise the negotiated SDIO FIFO with complete 512-byte transfers before
+ * the first RPC. TEST_IF is intentionally unused by the normal consumer; the
+ * matching slave drops it unless its optional raw-transport test is enabled.
+ */
+static int esp_hosted_mcu_p1_transport_test(void)
+{
+	enum {
+		P1_FRAME_SIZE = 512,
+		P1_FRAME_COUNT = 4,
+		P1_PAYLOAD_SIZE = P1_FRAME_SIZE - ESP_HOSTED_MCU_HEADER_SIZE,
+	};
+	static uint8_t payload[P1_PAYLOAD_SIZE];
+
+	for (size_t i = 0; i < sizeof(payload); i++) {
+		payload[i] = (uint8_t)(0x5aU ^ (uint8_t)i);
+	}
+
+	for (unsigned int frame = 0; frame < P1_FRAME_COUNT; frame++) {
+		int ret = esp_hosted_mcu_send_frame(ESP_HOSTED_MCU_TEST_IF, 0, 0, payload,
+						    sizeof(payload));
+
+		if (ret != 0) {
+			P1_MARK("EASYSTICK_P1 STEP 07 CMD53_REPEAT FAIL frame=%u errno=%d",
+				frame + 1U, ret);
+			return ret;
+		}
+
+		/*
+		 * Give the coprocessor time to consume the test frame and replenish
+		 * its receive-buffer credit before the next write.
+		 */
+		k_msleep(5);
+	}
+
+	P1_MARK("EASYSTICK_P1 STEP 07 CMD53_REPEAT PASS frames=%u size=%u",
+		P1_FRAME_COUNT, P1_FRAME_SIZE);
+	return 0;
+}
+#endif
+
 uint32_t esp_hosted_mcu_fw_version(void)
 {
 	return esp_hosted_mcu_data_0.fw_version;
@@ -718,9 +760,33 @@ static int esp_hosted_mcu_core_init(const struct device *dev)
 	/* Publish only once the link is up, so a failure above leaves it unset. */
 	data->dev = dev;
 
+#if defined(CONFIG_ESP_HOSTED_MCU_P1_TRANSPORT_TEST)
+	ret = esp_hosted_mcu_p1_transport_test();
+	if (ret != 0) {
+		return ret;
+	}
+#endif
+
 	/* The receive thread is up, so the version round-trip can complete. */
 	esp_hosted_mcu_check_fw_version(data);
 
+#if defined(CONFIG_ESP_HOSTED_MCU_P1_TRANSPORT_TEST)
+	uint32_t expected = ESP_HOSTED_MCU_FW_VERSION_VAL(CONFIG_ESP_HOSTED_MCU_FW_VERSION_MAJOR,
+							  CONFIG_ESP_HOSTED_MCU_FW_VERSION_MINOR,
+							  CONFIG_ESP_HOSTED_MCU_FW_VERSION_PATCH);
+
+	if (data->fw_version != expected) {
+		P1_MARK("EASYSTICK_P1 STEP 08 ESP_HOSTED_INIT FAIL got=0x%06x expected=0x%06x",
+			data->fw_version, expected);
+		return -EPROTO;
+	}
+
+	P1_MARK("EASYSTICK_P1 STEP 08 ESP_HOSTED_INIT PASS fw=%u.%u.%u",
+		ESP_HOSTED_MCU_FW_VERSION_MAJOR(data->fw_version),
+		ESP_HOSTED_MCU_FW_VERSION_MINOR(data->fw_version),
+		ESP_HOSTED_MCU_FW_VERSION_PATCH(data->fw_version));
+#endif
+
 	return 0;
 }
 
