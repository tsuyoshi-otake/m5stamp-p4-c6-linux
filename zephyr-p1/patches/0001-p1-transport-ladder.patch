diff --git a/drivers/misc/esp_hosted_mcu/Kconfig b/drivers/misc/esp_hosted_mcu/Kconfig
index 5cd7f318aef..a948d6692ac 100644
--- a/drivers/misc/esp_hosted_mcu/Kconfig
+++ b/drivers/misc/esp_hosted_mcu/Kconfig
@@ -134,6 +134,15 @@ config ESP_HOSTED_MCU_EVENT_TASK_POLL_MS
 	  the worst-case receive latency: every request and response pays
 	  up to one poll period.
 
+config ESP_HOSTED_MCU_P1_TRANSPORT_TEST
+	bool "Enable EasyStick P1 transport ladder"
+	help
+	  Enable the temporary, fail-closed transport evidence ladder used by the
+	  EasyStick Stamp-P4 P1 control image. It sends four 512-byte TEST_IF
+	  frames after SDIO setup and requires the configured coprocessor firmware
+	  version before allowing the consumer driver to continue. Do not enable
+	  this option in a production image.
+
 module = ESP_HOSTED_MCU
 module-str = esp-hosted-mcu
 source "subsys/logging/Kconfig.template.log_config"
diff --git a/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.c b/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.c
